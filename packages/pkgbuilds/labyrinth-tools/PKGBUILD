# Labyrinth's own programs in Rust (packages/tools in this repository), in place of the Python scripts of the same names that the
# image kept in /usr/local/bin: the malware scan of new files and its quarantine, the per-app network rules with the ask service
# and its notifications, the app launcher and the optional-software installer; since pkgrel 2 also the self-check, ipconfig,
# Steam Play for all (steam_playall, was steam_playall.py) and the first-login installs; since pkgrel 4 also labyrinth-agent, the
# gate sudo lets the engineering agent's account run as root (was /usr/local/sbin/labyrinth-agent; labyrinth-agent-setup's rule
# names /usr/bin/labyrinth-agent), and the ports of the shell scripts (packages/tools/shell keeps the scripts): the rollback, the
# installer's two steps, the agent's set-up and window, the ecosystem's set-up, the hardware set-up, the boot menu theme, the
# gaming check, Sarina's launcher, settings and helpers, REA, Claude Code's installer, the live installer's launcher and the
# notification activation. (The branches agent-gate-rust, pkgrel 3, and scripts-rust-switch were merged into one switch.) Since
# 2026-11-11 also Sarina's two voice scripts: labyrinth-sarina-ask (Super+S: the recording to her answer) and labyrinth-sarina-speak
# (her answer said aloud). Their units come with them (same names).
pkgname=labyrinth-tools
pkgver=1.0.0
pkgrel=1
pkgdesc="Labyrinth OS's own programs in Rust: malware scan and quarantine, per-app network rules, app launcher, optional software, self-check, ipconfig, Steam Play for all, first-login installs, the engineering agent's gate, system rollback, install steps, agent set-up, Sarina's and the desktop's helpers, Sarina's voice scripts"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Labyrinth_OS"
license=('MPL-2.0')
depends=('gcc-libs' 'glibc' 'nftables' 'systemd')
optdepends=('heimdall-git: the malware scanner (heimdalld scan-files) the scan uses'
            'clamav: the signatures behind that scanner'
            'bubblewrap: the per-app sandbox of labyrinth-launch'
            'libnotify: the notifications (notify-send)'
            'networkmanager: ipconfig and the first-login installs (nmcli)'
            'btrfs-progs: labyrinth-rollback and hibernation at install (btrfs)'
            'snapper: the snapshots set up at install'
            'curl: Sarina'"'"'s helpers, labyrinth-claude-code, labyrinth-rea-setup'
            'sudo: labyrinth-agent-setup and labyrinth-agent-window (visudo)'
            'whisper-cpp: labyrinth-sarina-ask (speech to text)'
            'pipewire: labyrinth-sarina-speak (pw-play)')
makedepends=('cargo')
options=('!lto' '!debug')
# the system version in /etc/os-release on every update (docs/VERSIONING.md)
install=labyrinth-tools.install

_src="$startdir/../../tools"
# The version is the system's (VERSION at the top of this repository); the build number counts the commits since that release
# which touch packages/tools, the crates it uses and this recipe (scripts/package-version.sh, docs/VERSIONING.md)
. "$startdir/../../../scripts/package-version.sh"
_version "$startdir" "$_src"

build() {
  cd "$_src"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  for b in labyrinth-scan-downloads labyrinth-quarantine labyrinth-appnet labyrinth-appnet-ask labyrinth-appnet-ask-agent labyrinth-launch labyrinth-apps \
           labyrinth-selfcheck ipconfig steam_playall labyrinth-first-components labyrinth-agent \
           labyrinth-rollback labyrinth-install-bootfinish labyrinth-install-cleanup labyrinth-agent-setup labyrinth-agent-window \
           labyrinth-ecosystem-setup labyrinth-hardware-setup labyrinth-grub-theme labyrinth-security-setting labyrinth-gaming \
           labyrinth-sarina labyrinth-sarina-setting labyrinth-sarina-reflect labyrinth-sarina-voice-setup labyrinth-sarina-warm \
           labyrinth-rea labyrinth-rea-setup labyrinth-claude-code labyrinth-install labyrinth-notify-activate \
           labyrinth-sarina-ask labyrinth-sarina-speak; do
    install -Dm755 "$srcdir/target/release/$b" "$pkgdir/usr/bin/$b"
  done
  for u in labyrinth-scan.service labyrinth-scan.timer labyrinth-scan-watch.service labyrinth-scan-full.service labyrinth-scan-full.timer \
           labyrinth-appnet-prepare.service labyrinth-appnet-ask-agent.service; do
    install -Dm644 "$_src/units/user/$u" "$pkgdir/usr/lib/systemd/user/$u"
  done
  for u in labyrinth-appnet.service labyrinth-appnet-ask.service; do
    install -Dm644 "$_src/units/system/$u" "$pkgdir/usr/lib/systemd/system/$u"
  done
}
