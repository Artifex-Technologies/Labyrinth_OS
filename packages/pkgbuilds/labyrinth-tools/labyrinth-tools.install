# The system version in /etc/os-release (docs/VERSIONING.md): this package's version is Labyrinth OS's, so each update writes it as
# VERSION ("1.0", "1.1", "1.1.1": the patch only when there is one) and VERSION_ID (1.0.0). labyrinth-os-release (Rust, this
# package; an awk program here until 2026-11-12) does it only on Labyrinth (ID=labyrinth), leaves the rest of the file and a
# link to the distribution's os-release alone, and writes the file whole.

post_install() {
  usr/bin/labyrinth-os-release "$1" || true
}

post_upgrade() {
  post_install "$1"
}
