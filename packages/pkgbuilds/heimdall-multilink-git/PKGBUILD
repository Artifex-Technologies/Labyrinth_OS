# Maintainer: Labyrinth OS
#
# Several internet connections at once (Heimdall's docs/MULTILINK.md), a package of its own: off until switched on in Settings >
# Wi-Fi & Network. Built from the Heimdall repository checked out next to this one, like heimdall-git (committed work only).
# Layout needed: <dir>/Heimdall and <dir>/Labyrinth_OS/packages/pkgbuilds/heimdall-multilink-git/PKGBUILD. The file list lives
# in Heimdall's packaging/install.sh (its multilink part); heimdall-git ships none of these files.

_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../Heimdall" && pwd)"

pkgname=heimdall-multilink-git
pkgver=1.0.0
pkgrel=1
pkgdesc="Several internet connections at once: new connections spread over Wi-Fi, Ethernet and a phone by the kernel's own multipath routing, with health checks, backup links, share limits and data caps"
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Heimdall'
license=('MPL-2.0')
depends=('glibc' 'gcc-libs' 'iproute2' 'polkit')
optdepends=('networkmanager: each link'"'"'s DNS servers, and pausing while a NetworkManager VPN is on'
            'usbmuxd: tethering from an iPhone over USB (with the ipheth driver)'
            'libimobiledevice: pairing an iPhone (idevicepair) for USB tethering')
makedepends=('rust' 'git')
provides=('heimdall-multilink')
conflicts=('heimdall-multilink')
options=('!debug')
source=("heimdall::git+file://${_src}")
sha256sums=('SKIP')

# The version is Heimdall's own (the VERSION file in its repository); the build number counts the commits since that release
# that touch this package's files (the crate, packaging/multilink, install.sh, the doc) and this recipe's (docs/VERSIONING.md).
. "$startdir/../../../scripts/package-version.sh"
_paths=(rust/multilink rust/Cargo.toml rust/Cargo.lock packaging/multilink packaging/install.sh docs/MULTILINK.md)
_version "$(_srcdir)/heimdall" "${_paths[@]}"

pkgver() {
  _version "$srcdir/heimdall" "${_paths[@]}"
  echo "$pkgver"
}

prepare() {
  _version "$srcdir/heimdall" "${_paths[@]}"
  cd "$srcdir/heimdall/rust"
  cargo fetch --locked
}

build() {
  cd "$srcdir/heimdall/rust"
  cargo build --release --locked --offline -p heimdall-multilink
}

check() {
  # the unit tests; the namespace test (tests/netns.rs) runs in Heimdall's CI
  cd "$srcdir/heimdall/rust"
  cargo test --release --locked --offline -p heimdall-multilink --lib
}

package() {
  cd "$srcdir/heimdall"
  # the file list lives in Heimdall itself (one place for every system that packages it)
  ./packaging/install.sh "$pkgdir" multilink
}
