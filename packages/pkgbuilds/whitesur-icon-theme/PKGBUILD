# Maintainer: Labyrinth OS
pkgname=whitesur-icon-theme
pkgver=r2026.09.10
_commit=73d8040da51a9ed74e47c7366e7e9ff437601a5c
pkgrel=1
pkgdesc='WhiteSur macOS Big Sur icon theme'
arch=('any')
url='https://github.com/vinceliuice/WhiteSur-icon-theme'
license=('GPL-3.0-or-later')
depends=('gtk-update-icon-cache')
source=("WhiteSur-icon-theme-$_commit.tar.gz::https://github.com/vinceliuice/WhiteSur-icon-theme/archive/$_commit.tar.gz")
sha256sums=('96661649071d8a9664b40d42abea75286175234473106156e9a4b25f54e6cb0c')

package() {
  cd "$srcdir/WhiteSur-icon-theme-$_commit"
  export HOME="$srcdir/home"; mkdir -p "$HOME"
  install -d "$pkgdir/usr/share/icons"
  ./install.sh -d "$pkgdir/usr/share/icons"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
