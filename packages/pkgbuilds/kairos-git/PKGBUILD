# Kairos, Labyrinth's own frame generation (named 2026-11-07; it was labyrinth-framegen): a Vulkan layer for 64-bit and
# 32-bit games, and its launcher (kairos %command% in a game's Steam launch options; Settings > Games chooses per game).
# Built from its public repository. The layer does nothing unless a game is started with it switched on.
pkgname=kairos-git
pkgver=1.0.0
pkgrel=1
pkgdesc='Kairos frame generation for games (Vulkan and Proton), Labyrinth OS preview'
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Kairos'
license=('MPL-2.0')
depends=('vulkan-icd-loader' 'gcc-libs' 'glibc')
optdepends=('lib32-vulkan-icd-loader: frame generation for 32-bit games (old Proton games)')
makedepends=('git' 'rust' 'lib32-rust-libs' 'shaderc' 'lib32-gcc-libs' 'lib32-glibc')
# the package before the rename: pacman -Syu swaps it for this one
provides=('kairos' 'labyrinth-framegen' 'labyrinth-framegen-git')
conflicts=('kairos' 'labyrinth-framegen' 'labyrinth-framegen-git')
replaces=('labyrinth-framegen-git')
options=('!lto' '!debug')
source=("kairos::git+${KAIROS_SRC:-https://github.com/Artifex-Technologies/Kairos.git}")
sha256sums=('SKIP')

# The version is Kairos's own (the VERSION file in its repository); the build number counts its commits since that release
# and this recipe's (Labyrinth_OS docs/VERSIONING.md). Both come from makepkg's clone: worked out here for the packaging step
# (makepkg reads this file again for it), and in pkgver() and prepare() for the rest of the build, once the clone is up to date.
. "$startdir/../../../scripts/package-version.sh"
_version "$(_srcdir)/kairos"

pkgver() {
  _version "$srcdir/kairos"
  echo "$pkgver"
}

prepare() {
  _version "$srcdir/kairos"
}

build() {
  cd "$srcdir/kairos"
  cargo build --release --locked --target x86_64-unknown-linux-gnu
  cargo build --release --locked --target i686-unknown-linux-gnu
}

check() {
  cd "$srcdir/kairos"
  cargo test --release --locked --target x86_64-unknown-linux-gnu
  sh tests/launcher.sh
}

package() {
  cd "$srcdir/kairos"
  install -Dm755 target/x86_64-unknown-linux-gnu/release/libkairos.so "$pkgdir/usr/lib/libkairos.so"
  install -Dm755 target/i686-unknown-linux-gnu/release/libkairos.so "$pkgdir/usr/lib32/libkairos.so"
  install -Dm644 data/kairos.x86_64.json "$pkgdir/usr/share/vulkan/implicit_layer.d/kairos.x86_64.json"
  install -Dm644 data/kairos.x86.json "$pkgdir/usr/share/vulkan/implicit_layer.d/kairos.x86.json"
  install -Dm755 bin/kairos "$pkgdir/usr/bin/kairos"
  # the launcher's name before the rename: Steam launch options written then still start their game
  ln -s kairos "$pkgdir/usr/bin/labyrinth-framegen"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
