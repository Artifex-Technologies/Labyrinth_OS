# Maintainer: Labyrinth OS
#
# Sarina, the local-model agent (Go core, optional Python helper), built from the Sarina
# repository checked out next to this one: Artifex/Sarina. It builds from the commit that
# checkout is on (committed work only), so a new build picks up Sarina as it moves on.
# Layout needed: <dir>/Sarina and <dir>/Labyrinth_OS/packages/pkgbuilds/sarina-git/PKGBUILD,
# which is how the Artifex repositories sit on disk. The packaging files below come from
# Sarina's own packaging/ directory.

_agent_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../Sarina" && pwd)"
# Two builds of Sarina's core (Sarina's docs/RUST_PORT.md "The switch"): the Rust build (rust/, sarina-rs) is /usr/bin/sarina
# with its sarina-gui and sarina-service links; it runs the commands ported to it and hands every other one, unchanged, to
# the Go build by execve. The Go build is /usr/lib/sarina/sarina (named sarina so that Heimdall still knows the process).
# Also sarina-voice (Rust, packaging/voice): the spoken-question programs (labyrinth-ask-sarina, labyrinth-sarina-checkup,
# labyrinth-sarina-speak-voiced) that the image's /usr/local/bin names link to. Sarina's docs/VOICE_RUST_PORT.md: what it is.

pkgname=sarina-git
pkgver=1.0.0
pkgrel=1
pkgdesc='Local-model agent: Rust and Go core with an optional Python ML/voice helper (built from the local Sarina checkout)'
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Sarina'
license=('MPL-2.0')
depends=('glibc')
optdepends=(
  'ollama: a local model server for Sarina to talk to (ollama-cuda on an NVIDIA machine)'
  'python: the optional ML/voice helper (sarina-helpers)'
  'python-onnxruntime: semantic search and desktop-audit classification (helper)'
)
makedepends=('go' 'cargo' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'git')
# ring (TLS for the Rust build's model clients) does not link from GCC's LTO objects
options=('!lto')
provides=('sarina')
conflicts=('sarina')
source=("sarina::git+file://${_agent_src}")
sha256sums=('SKIP')

# The version is Sarina's own (the VERSION file in its repository); the build number counts its commits since that release
# and this recipe's (Labyrinth_OS docs/VERSIONING.md). Both come from makepkg's clone: worked out here for the packaging step
# (makepkg reads this file again for it), and in pkgver() and prepare() for the rest of the build, once the clone is up to date.
. "$startdir/../../../scripts/package-version.sh"
_version "$(_srcdir)/sarina"

pkgver() {
  _version "$srcdir/sarina"
  echo "$pkgver"
}

prepare() {
  _version "$srcdir/sarina"
}

build() {
  cd "$srcdir/sarina/go"
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w" -o sarina ./cmd/sarina
  go build -ldflags "-s -w" -o sarina-tone ./cmd/sarina-tone

  cd ../python/sarina_helpers
  python -m build --wheel --no-isolation

  # the spoken-question programs in one binary (it answers to the name it is started as)
  cd "$srcdir/sarina/packaging/voice"
  cargo build --release --locked --target-dir "$srcdir/target"

  # the Rust build of the core: /usr/bin/sarina
  cd "$srcdir/sarina/rust"
  cargo build --release --locked --bin sarina-rs --target-dir "$srcdir/target"
}

check() {
  cd "$srcdir/sarina/packaging/voice"
  cargo test --release --locked --target-dir "$srcdir/target"
  # the Rust build as it starts: names, Heimdall's lock, the ported commands, the hand-over to the Go build
  cd "$srcdir/sarina/rust"
  cargo test --release --locked --test sarina_rs --target-dir "$srcdir/target"
}

package() {
  cd "$srcdir/sarina"

  install -Dm755 "$srcdir/target/release/sarina-rs" "$pkgdir/usr/bin/sarina"
  install -Dm755 go/sarina "$pkgdir/usr/lib/sarina/sarina"
  install -Dm755 "$srcdir/target/release/sarina-voice" "$pkgdir/usr/bin/sarina-voice"
  # how Sarina plugs into the desktop (Yggdrasil): hold-to-talk, voice, and her page in Settings
  install -Dm644 "$startdir/sarina.integration.conf" "$pkgdir/usr/share/yggdrasil/integrations/sarina.conf"
  install -Dm755 go/sarina-tone "$pkgdir/usr/bin/sarina-tone"
  ln -s sarina "$pkgdir/usr/bin/sarina-gui"
  ln -s sarina "$pkgdir/usr/bin/sarina-service"

  python -m installer --destdir="$pkgdir" python/sarina_helpers/dist/*.whl

  install -Dm644 packaging/arch/sarina-service.service "$pkgdir/usr/lib/systemd/system/sarina-service.service"
  install -Dm644 packaging/arch/sarina.sysusers "$pkgdir/usr/lib/sysusers.d/sarina.conf"
  install -Dm644 packaging/arch/service.env.example "$pkgdir/etc/sarina/service.env.example"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  for d in packaging/skills/*/; do
    install -Dm644 "$d/SKILL.md" "$pkgdir/usr/share/sarina/skills/$(basename "$d")/SKILL.md"
    # a long skill's sections, read on demand (skill_section, skill_search)
    for f in "$d"sections/*.md; do
      if [ -f "$f" ]; then install -Dm644 "$f" "$pkgdir/usr/share/sarina/skills/$(basename "$d")/sections/$(basename "$f")"; fi
    done
  done
}
