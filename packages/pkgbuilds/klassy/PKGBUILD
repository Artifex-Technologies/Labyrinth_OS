# Klassy: a Breeze-based window decoration (GPL-2.0-or-later / MIT parts). Labyrinth uses it for
# the title bar of apps that cannot draw their own (KDE/Qt apps): macOS traffic-light buttons in
# Windows order, a title bar that takes the app's own colour so title bar and toolbar read as one
# header, no border or chin, and invisible resize edges (KDecoration resize-only borders).
# Settings: usr/share/labyrinth/klassy/klassyrc, applied by labyrinth-plasma-setup.
# Upstream: https://github.com/paulmcauley/klassy  Pinned to v6.7.3 (for Plasma 6.6.1+); checksum
# taken 2026-10-11 from the GitHub tag archive.
pkgname=klassy
pkgver=6.7.3
pkgrel=2
pkgdesc="Highly customizable Breeze-based window decoration, application style and icons"
arch=('x86_64')
url="https://github.com/paulmcauley/klassy"
license=('GPL-2.0-or-later' 'MIT')
depends=('kdecoration' 'qt6-declarative' 'qt6-svg' 'kcoreaddons' 'kcmutils' 'kcolorscheme' 'kconfig'
         'kguiaddons' 'ki18n' 'kiconthemes' 'kwidgetsaddons' 'kwindowsystem' 'frameworkintegration'
         'kirigami')
makedepends=('cmake' 'extra-cmake-modules' 'qt6-tools')
source=("$pkgname-$pkgver.tar.gz::https://github.com/paulmcauley/klassy/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a3e9b96723cda1b3c46d6f456d495e5e34d051940e6f71aa9a345e8fb850e1fb')

build() {
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -DBUILD_QT5=OFF \
    -DBUILD_QT6=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # Only the window decoration is used (until Yggdrasil's compositor draws its own); the Klassy icon packs are not: Yggdrasil's icons are Liki.
  rm -rf "$pkgdir"/usr/share/icons/klassy "$pkgdir"/usr/share/icons/klassy-dark
}
