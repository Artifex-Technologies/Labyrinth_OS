# A stale font cache (Yggdrasil's docs/APPS_SETTINGS.md, "a stale font cache"): fontconfig keeps a folder's cache while the
# folder's modification time, in whole seconds, is the same. When another font package went into /usr/share/fonts in the same
# second (two pacman transactions in a row), the cache made after it lacks this font, and fontconfig's own hook after this
# transaction (fc-cache -s) keeps it. So: when fontconfig does not list this font once its files are in, the system's font
# caches are made again (fc-cache -f, about two seconds). Otherwise nothing is run here.

_family='Lexend'

post_install() {
  command -v fc-list >/dev/null 2>&1 && command -v fc-cache >/dev/null 2>&1 || return 0
  fc-list -q "$_family" || fc-cache -fs /usr/share/fonts >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
}
