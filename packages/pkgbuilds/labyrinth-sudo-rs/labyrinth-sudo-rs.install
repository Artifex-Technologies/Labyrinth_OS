# The swap removes GNU sudo before this package is installed, and pacman moves an edited /etc/sudoers (or
# /etc/pam.d/sudo) aside as .pacsave, then installs this package's default. _restore puts the system's own file back
# (the default goes to .pacnew), only a .pacsave made by this transaction (its inode changed in the last 10 minutes).
_restore() {
  local f=$1
  [ -e "$f.pacsave" ] && [ -n "$(find "$f.pacsave" -cmin -10)" ] || return 0
  mv -f "$f" "$f.pacnew" && mv "$f.pacsave" "$f" && echo "==> kept this system's $f (the package's default: $f.pacnew)"
}

# If sudo-rs cannot read the sudoers (an option it does not support), every sudo would be refused. Then
# /etc/sudoers-rs, which sudo-rs reads instead, keeps sudo for the wheel group.
_check_sudoers() {
  if visudo-rs -c -f /etc/sudoers >/dev/null 2>&1; then
    return 0
  fi
  if [ -e /etc/sudoers-rs ]; then
    echo "==> sudo-rs cannot read /etc/sudoers; it uses /etc/sudoers-rs, which is already there."
    return 0
  fi
  umask 0337
  cat > /etc/sudoers-rs <<'RULES'
## Written by labyrinth-sudo-rs because sudo-rs could not read /etc/sudoers (see: visudo-rs -c -f /etc/sudoers).
## sudo-rs reads this file instead of /etc/sudoers while it exists. Fix /etc/sudoers, then delete this file.
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/bin"
root ALL=(ALL:ALL) ALL
%wheel ALL=(ALL:ALL) ALL
RULES
  echo "==> WARNING: sudo-rs cannot read /etc/sudoers. Members of wheel keep sudo through /etc/sudoers-rs;"
  echo "    the rules in /etc/sudoers and /etc/sudoers.d are NOT in use until /etc/sudoers is fixed:"
  visudo-rs -c -f /etc/sudoers 2>&1 | sed 's/^/    /'
}

post_install() {
  _restore /etc/sudoers
  _restore /etc/pam.d/sudo
  _check_sudoers
}

post_upgrade() {
  _check_sudoers
}
