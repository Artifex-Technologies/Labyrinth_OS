# Maintainer: Labyrinth OS
#
# Limbo, sandboxed Windows and Linux guest apps, built from the Limbo repository checked out next to this
# one (Artifex/Limbo), the same way sarina-git is built from Sarina. It builds from the commit that checkout
# is on (committed work only). Layout needed: <dir>/Limbo and
# <dir>/Labyrinth_OS/packages/pkgbuilds/limbo-git/PKGBUILD. Limbo's runtime (libvirt, QEMU, ...) is not a
# dependency: the "virtualization" component, or `sudo limbo setup`, installs it. Limbo's own
# packaging/arch/PKGBUILD is the version for other Arch systems (it builds from GitHub).

_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../Limbo" && pwd)"

pkgname=limbo-git
pkgver=0.1.0.r60.gb48b5fa
pkgrel=1
pkgdesc='Limbo: run Windows and Linux guest apps as sandboxed host windows, with quarantine and validation runs (built from the local Limbo checkout)'
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Limbo'
license=('MPL-2.0')
depends=('glibc')
makedepends=('go' 'git')
optdepends=(
  'libvirt: manages guests'
  'qemu-base: the hypervisor'
  'dnsmasq: DHCP/DNS on each guest network'
  'nftables: each guest firewall'
  'openssh: validation runs'
  'libisoburn: builds the cloud-init seed disk'
  'waypipe: seamless windows for Linux guests'
  'freerdp: seamless windows for Windows guests (RemoteApp)'
  'bubblewrap: the sandbox of the Wine backend (limbo wine refuses to run without it)'
  'wine: Windows programs on the desktop through limbo wine (or wine-staging)'
)
provides=('limbo')
conflicts=('limbo')
options=('!debug')
install=limbo.install
source=("limbo::git+file://${_src}")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/limbo"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/limbo"
  export CGO_ENABLED=0
  go build -trimpath -ldflags "-s -w" -o limbo ./cmd/limbo
}

check() {
  cd "$srcdir/limbo"
  # unit tests only: the integration scripts need a hypervisor and root, and -short skips the real Wine run
  go test -short ./...
}

package() {
  cd "$srcdir/limbo"
  install -Dm755 limbo "$pkgdir/usr/bin/limbo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/QUARANTINE.md "$pkgdir/usr/share/doc/$pkgname/QUARANTINE.md"
  install -Dm644 docs/EVENTS.md "$pkgdir/usr/share/doc/$pkgname/EVENTS.md"
  install -Dm644 docs/HOST-FIREWALL.md "$pkgdir/usr/share/doc/$pkgname/HOST-FIREWALL.md"
  install -Dm644 packaging/arch/limbo.service "$pkgdir/usr/lib/systemd/system/limbo.service"
  install -Dm644 packaging/arch/limbo.sysusers "$pkgdir/usr/lib/sysusers.d/limbo.conf"
  install -Dm644 examples/validation-profile.json "$pkgdir/usr/share/doc/$pkgname/examples/validation-profile.json"
  install -Dm644 examples/analysis-linux.json "$pkgdir/usr/share/doc/$pkgname/examples/analysis-linux.json"
  install -Dm644 examples/wine-profile.json "$pkgdir/usr/share/doc/$pkgname/examples/wine-profile.json"
  # the weekly full re-check of base images proven by a full hash (limbo image verify); held during games by game time
  install -Dm644 packaging/arch/limbo-image-verify.service "$pkgdir/usr/lib/systemd/system/limbo-image-verify.service"
  install -Dm644 packaging/arch/limbo-image-verify.timer "$pkgdir/usr/lib/systemd/system/limbo-image-verify.timer"
  install -Dm644 packaging/arch/limbo-image-verify-gametime.conf \
    "$pkgdir/usr/lib/systemd/system/limbo-image-verify.service.d/gametime.conf"
  install -dm755 "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../limbo-image-verify.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/limbo-image-verify.timer"
  # Limbo's wine: programs that run `wine` from PATH land in Limbo's sandbox. Not on PATH by itself; it is linked from
  # a folder before /usr/bin (sudo ln -s /usr/lib/limbo/bin/wine /usr/local/bin/wine). Wine's other command names are
  # links to the shim, which runs the matching program inside the sandbox.
  install -Dm755 packaging/wine/wine "$pkgdir/usr/lib/limbo/bin/wine"
  for name in wineboot winecfg wineconsole winedbg winefile winemine winepath msiexec notepad regedit regsvr32; do
    ln -s wine "$pkgdir/usr/lib/limbo/bin/$name"
  done
  # validation profiles define what a run may do, so the directory is root-only writable
  install -dm755 "$pkgdir/etc/limbo/validation"
  install -dm700 "$pkgdir/etc/limbo/keys"
}
