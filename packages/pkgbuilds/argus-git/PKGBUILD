# Argus for LykanOS, the app and the firmware as one package: the Argus app (a qFlipper fork: a console for the Flipper
# Zero with a capture store, Wireshark export and a local control API) and the Argus firmware for the Flipper, built here
# as an update bundle the app installs (Install from file: /usr/share/argus/firmware/argus-firmware.tgz).
# LykanOS's: its Agora lists it (LykanOS profile/airootfs/usr/share/lykanos/agora/catalog.json), Labyrinth's does not,
# and it is not on Labyrinth's ISO (scripts/build-local-packages.sh leaves it out); the publish puts it in [labyrinth], from
# which LykanOS installs. The firmware build downloads Flipper's ARM toolchain once, next to this file by default
# ($FBT_TOOLCHAIN_PATH; kept, like the clones, by .gitignore).
pkgname=argus-git
pkgver=1.0.0
pkgrel=1
# until 2026-11-11 the version was the app's and the firmware's commit counts (25.3078): 1.0.0 sorts after those only with an epoch
epoch=1
pkgdesc='Argus: a Flipper Zero console (qFlipper fork) and the Argus firmware for the device'
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Argus_App'
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'qt6-serialport' 'qt6-svg' 'libusb' 'zlib' 'hicolor-icon-theme')
makedepends=('git' 'qt6-tools' 'python')
provides=('qflipper')
conflicts=('qflipper' 'qflipper-git')
options=('!lto' '!debug')
source=("argus-app::git+${ARGUS_APP_SRC:-https://github.com/Artifex-Technologies/Argus_App.git}"
        "argus-firmware::git+${ARGUS_FIRMWARE_SRC:-https://github.com/Artifex-Technologies/Argus_Firmware.git}")
sha256sums=('SKIP' 'SKIP')

# The version is the Argus app's own (the VERSION file in its repository; the firmware keeps its own ARG-... names); the build
# number counts the app's commits since that release, the firmware's since then and this recipe's (docs/VERSIONING.md): either
# one moving on makes a newer package. Both come from makepkg's clones: worked out here for the packaging step (makepkg reads
# this file again for it), and in pkgver() and prepare() for the rest of the build, once the clones are up to date.
. "$startdir/../../../scripts/package-version.sh"
_version "$(_srcdir)/argus-app" "$(_srcdir)/argus-firmware"

pkgver() {
  _version "$srcdir/argus-app" "$srcdir/argus-firmware"
  echo "$pkgver"
}

prepare() {
  _version "$srcdir/argus-app" "$srcdir/argus-firmware"
  # the app needs nanopb only (libwdi is the Windows driver tool)
  git -C argus-app submodule update --init 3rdparty/nanopb
}

build() {
  cd "$srcdir/argus-app"
  mkdir -p build && cd build
  qmake6 ../qFlipper.pro -spec linux-g++ "CONFIG+=release qtquickcompiler" PREFIX=/usr \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make qmake_all
  make

  # the firmware's own build (fbt fetches its submodules and, once, its toolchain); makepkg's flags are for this PC, not
  # the Flipper's ARM chip
  cd "$srcdir/argus-firmware"
  export FBT_TOOLCHAIN_PATH="${FBT_TOOLCHAIN_PATH:-$SRCDEST}"
  env -u CFLAGS -u CXXFLAGS -u LDFLAGS -u CPPFLAGS -u MAKEFLAGS ./fbt COMPACT=1 DEBUG=0 DIST_SUFFIX=argus updater_package
}

package() {
  cd "$srcdir/argus-app/build"
  make INSTALL_ROOT="$pkgdir" install
  ln -s qFlipper "$pkgdir/usr/bin/argus"
  install -Dm644 ../application/assets/icons/Argus-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/argus.png"
  # shown as Argus, not as the qFlipper it was forked from
  rm -f "$pkgdir/usr/share/applications/qFlipper.desktop"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/argus.desktop" <<'EOT'
[Desktop Entry]
Type=Application
Name=Argus
GenericName=Flipper Zero console
Comment=Update and control a Flipper Zero, keep and export its captures
Exec=qFlipper
Icon=argus
StartupWMClass=qFlipper
Categories=System;Security;
Terminal=false
EOT
  local dist="$srcdir/argus-firmware/dist/f7-C"
  install -Dm644 "$dist/flipper-z-f7-update-argus.tgz" "$pkgdir/usr/share/argus/firmware/argus-firmware.tgz"
  install -Dm644 "$dist/flipper-z-f7-full-argus.dfu" "$pkgdir/usr/share/argus/firmware/argus-firmware-full.dfu"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/argus/firmware/README" <<EOT
The Argus firmware for the Flipper Zero, built from $(git -C "$srcdir/argus-firmware" describe --tags --always).

argus-firmware.tgz        In Argus: connect the Flipper, Install from file, choose this file (firmware and SD files).
argus-firmware-full.dfu   For a Flipper in recovery mode (DFU): Argus offers Install from file with .dfu files then.

Source: https://github.com/Artifex-Technologies/Argus_Firmware (GPL-3.0)
EOT
  install -Dm644 "$srcdir/argus-app/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
