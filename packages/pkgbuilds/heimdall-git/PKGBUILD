# Maintainer: Labyrinth OS
#
# Heimdall, the security agent that watches Sarina, built from the Heimdall repository checked out next to
# this one (Artifex/Heimdall), the same way sarina-git is built from Sarina. It builds from the commit that
# checkout is on (committed work only). Layout needed: <dir>/Heimdall and
# <dir>/Labyrinth_OS/packages/pkgbuilds/heimdall-git/PKGBUILD. The packaging files come from Heimdall's own
# packaging/arch directory; the service is installed but not enabled.

_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../Heimdall" && pwd)"

pkgname=heimdall-git
pkgver=0.1.0.r22.g718e1d7
pkgrel=1
pkgdesc='Heimdall: a separate security agent that watches Sarina for prompt injection, leaked credentials and permission escalation (built from the local Heimdall checkout)'
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Heimdall'
license=('MPL-2.0')
depends=('glibc' 'curl' 'gzip' 'python' 'iproute2')
makedepends=('go' 'git')
provides=('heimdall')
conflicts=('heimdall')
backup=()
options=('!debug')
source=("heimdall::git+file://${_src}")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/heimdall"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/heimdall"
  export CGO_ENABLED=0
  go build -trimpath -ldflags "-s -w" -o heimdalld ./cmd/heimdalld
}

check() {
  cd "$srcdir/heimdall"
  go test ./...
}

package() {
  cd "$srcdir/heimdall"
  install -Dm755 heimdalld "$pkgdir/usr/bin/heimdalld"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 packaging/arch/heimdall.service "$pkgdir/usr/lib/systemd/system/heimdall.service"
  install -Dm644 packaging/arch/heimdall.sysusers "$pkgdir/usr/lib/sysusers.d/heimdall.conf"
  install -Dm644 packaging/arch/config.json.example "$pkgdir/etc/heimdall/config.json.example"
  install -Dm644 packaging/arch/limbo-integration.conf.example "$pkgdir/etc/heimdall/limbo-integration.conf.example"
  install -Dm755 packaging/arch/heimdall-intel-update "$pkgdir/usr/bin/heimdall-intel-update"
  install -Dm644 packaging/arch/heimdall-intel-update.service "$pkgdir/usr/lib/systemd/system/heimdall-intel-update.service"
  install -Dm644 packaging/arch/heimdall-intel-update.timer "$pkgdir/usr/lib/systemd/system/heimdall-intel-update.timer"
  install -Dm755 packaging/arch/heimdall-wifi-check "$pkgdir/usr/bin/heimdall-wifi-check"
  install -Dm644 packaging/arch/heimdall-wifi-check@.service "$pkgdir/usr/lib/systemd/system/heimdall-wifi-check@.service"
  install -Dm755 packaging/arch/90-heimdall-wifi "$pkgdir/usr/lib/NetworkManager/dispatcher.d/90-heimdall-wifi"
  # Labyrinth turns the firewall watch on: read-only journal access for the heimdall user
  install -Dm644 packaging/arch/heimdall-firewall.conf.example "$pkgdir/usr/lib/systemd/system/heimdall.service.d/firewall.conf"
}
