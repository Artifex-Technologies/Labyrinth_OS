# Maintainer: Labyrinth OS
#
# Heimdall, the security agent that watches Sarina, built from the Heimdall repository checked out next to
# this one (Artifex/Heimdall), the same way sarina-git is built from Sarina. It builds from the commit that
# checkout is on (committed work only). Layout needed: <dir>/Heimdall and
# <dir>/Labyrinth_OS/packages/pkgbuilds/heimdall-git/PKGBUILD. The packaging files come from Heimdall's own
# packaging/ directory (packaging/install.sh); on a fresh install the package switches on Heimdall and its timers itself.

_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../Heimdall" && pwd)"

pkgname=heimdall-git
pkgver=1.0.0
pkgrel=1
pkgdesc='Heimdall: a separate security agent that watches Sarina for prompt injection, leaked credentials and permission escalation (built from the local Heimdall checkout)'
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Heimdall'
license=('MPL-2.0')
# (no curl or gzip since the switch: the downloads are the Rust heimdalld's own; Heimdall's docs/RUST_CLI.md, "Shell programs")
depends=('glibc' 'iproute2' 'iw' 'networkmanager' 'dnsmasq' 'nftables')
# /usr/bin/heimdalld is the Rust daemon; the Wi-Fi helpers and the former shell programs are links to it (no Go, no Python)
makedepends=('git' 'rust')
# Heimdall's packaging test: what its install.sh puts in the package
checkdepends=('python')
optdepends=('clamav: malware scanning (held files, downloads; with clamav-freshclam for signatures)'
            'heimdall-yara-check: YARA-X checks the rule drafts Heimdall writes before it keeps them (Heimdall docs/IMMUNITY.md)')
provides=('heimdall')
conflicts=('heimdall')
backup=('etc/heimdall/dns-allow.txt' 'etc/NetworkManager/dnsmasq.d/heimdall-blocklist.conf')
# !lto: makepkg's -flto C flags turn ring's C code (the Rust daemon's TLS) into objects the linker cannot read
options=('!debug' '!lto')
source=("heimdall::git+file://${_src}")
sha256sums=('SKIP')

# The version is Heimdall's own (the VERSION file in its repository); the build number counts its commits since that release
# and this recipe's (Labyrinth_OS docs/VERSIONING.md). Both come from makepkg's clone: worked out here for the packaging step
# (makepkg reads this file again for it), and in pkgver() and prepare() for the rest of the build, once the clone is up to date.
. "$startdir/../../../scripts/package-version.sh"
_version "$(_srcdir)/heimdall"

pkgver() {
  _version "$srcdir/heimdall"
  echo "$pkgver"
}

prepare() {
  _version "$srcdir/heimdall"
}

build() {
  cd "$srcdir/heimdall"
  # offline first, so a build with the crates already fetched never reaches the network
  (cd rust && { cargo build --release --locked --offline || cargo build --release --locked; })
}

check() {
  cd "$srcdir/heimdall"
  python3 -m unittest discover -s packaging/tests -p test_install_layout.py
}

package() {
  cd "$srcdir/heimdall"
  # the file list lives in Heimdall itself (one place for every system that packages it)
  ./packaging/install.sh "$pkgdir"
}
