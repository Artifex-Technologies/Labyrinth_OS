#!/usr/bin/env python3
"""labyrinth-apps: install or remove Labyrinth's optional software.

  labyrinth-apps list
  labyrinth-apps info ID
  labyrinth-apps install ID...        or  --preset NAME
  labyrinth-apps remove ID...
  add --dry-run to print the commands without running anything

Components are described in /usr/share/labyrinth/components.json. Packages come from
pacman; components with a "pkgbuild" are built with makepkg from
/usr/share/labyrinth/pkgbuilds/<name>/ (a copy in a temp dir, so the source is never
modified). Installing needs network access and sudo.
"""
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile

MANIFEST = os.environ.get("LABYRINTH_COMPONENTS", "/usr/share/labyrinth/components.json")
PKGBUILDS = os.environ.get("LABYRINTH_PKGBUILDS", "/usr/share/labyrinth/pkgbuilds")


def load(path=None):
    with open(path or MANIFEST, encoding="utf-8") as f:
        data = json.load(f)
    comps = {c["id"]: c for c in data["components"]}
    for pname, ids in data.get("presets", {}).items():
        for i in ids:
            if i not in comps:
                raise ValueError(f"preset {pname!r} names unknown component {i!r}")
    return comps, data.get("presets", {})


def all_packages(c):
    """Names pacman should know the component by (a pkgbuild component installs its own name)."""
    return list(c.get("packages", [])) + list(c.get("aur", [])) + ([c["pkgbuild"]] if c.get("pkgbuild") else [])


def state(c, installed):
    pk = all_packages(c)
    have = [p for p in pk if p in installed]
    if len(have) == len(pk):
        return "installed"
    return "partial" if have else "not installed"


def pacman_installed():
    """Names pacman reports installed, or None when pacman itself is missing."""
    try:
        out = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return set(out.stdout.split()) if out.returncode == 0 else set()


def resolve(ids, presets, comps):
    """Expand preset names, validate ids, keep order, drop duplicates."""
    chosen = []
    for i in ids:
        if i not in comps:
            raise KeyError(i)
        if i not in chosen:
            chosen.append(i)
    return chosen


def gui_sudo():
    # AGORA_SUDO: another program that gains administrator rights (Agora, the app store, gives its password-box one: no terminal).
    # LABYRINTH_SUDO is the name older versions of Agora used.
    return os.environ.get("AGORA_SUDO") or os.environ.get("LABYRINTH_SUDO")


def makepkg_gui_args(tmp):
    """From Agora (no terminal): makepkg must not ask questions, and must gain administrator rights (its build dependencies, the
    install) through Agora's password box instead of sudo, which would wait for a password on a terminal that is not there."""
    if not gui_sudo():
        return []
    conf = os.path.join(tmp, "makepkg.conf")
    with open(conf, "w") as f:
        f.write("source /etc/makepkg.conf\n")
        f.write(f"PACMAN_AUTH=({shlex.quote(gui_sudo())})\n")
    return ["--noconfirm", "--config", conf]


def sudo(cmd):
    return cmd if getattr(os, "geteuid", lambda: 1)() == 0 else [gui_sudo() or "sudo"] + cmd


def in_repos(name):
    """Whether a package repository pacman knows has this package (Labyrinth's own [labyrinth] repository holds the builds of
    the components' PKGBUILDs, signed, so they install and update like any other package)."""
    try:
        return subprocess.run(["pacman", "-Si", name], capture_output=True).returncode == 0
    except OSError:
        return False


def never_synced(sync_dir=None):
    """True on a system that has never fetched its package lists (a fresh install: the image carries none). pacman -S then finds
    nothing, and a component's own build looks as if no repository had it (a VM install, 2026-11-08: every optional part chosen
    in the installer failed at the first login)."""
    d = sync_dir or os.environ.get("LABYRINTH_PACMAN_SYNC", "/var/lib/pacman/sync")
    try:
        return not any(n.endswith(".db") for n in os.listdir(d))
    except OSError:
        return True


def plan_install(chosen, comps, installed, in_repos=in_repos, fresh=False):
    """List of (description, argv, cwd_pkgbuild) steps. Skips what is already installed (a component's own build that a
    repository has is asked for anyway: pacman's --needed leaves it alone when it is current and updates it when it is not).
    fresh: the package lists were never fetched, so the install fetches them and brings the system up to date with it
    (pacman -Syu: Arch's safe way, never -Sy alone), and a component's own build is taken from Labyrinth's repository."""
    steps = []
    repo = []
    for i in chosen:
        for p in comps[i].get("packages", []):
            if p not in installed and p not in repo:
                repo.append(p)
    built_here = []
    for i in chosen:
        pb = comps[i].get("pkgbuild")
        if pb and pb not in repo:
            if fresh or in_repos(pb):
                repo.append(pb)
            elif pb not in installed:
                built_here.append(pb)
    if repo:
        # from Agora or the first login (no terminal): pacman's "Proceed?" would read nothing and stop, as yay and makepkg would
        quiet = ["--noconfirm"] if gui_sudo() else []
        if fresh:
            steps.append((f"fetch the package lists, update the system and install {len(repo)} package(s) with pacman", sudo(["pacman", "-Syu", "--needed"] + quiet + repo), None))
        else:
            steps.append((f"install {len(repo)} package(s) with pacman", sudo(["pacman", "-S", "--needed"] + quiet + repo), None))
    aur = []
    for i in chosen:
        for p in comps[i].get("aur", []):
            if p not in installed and p not in aur:
                aur.append(p)
    if aur:
        # yay shows each AUR package's build file and asks before building; it asks for the password itself when it installs
        cmd = ["yay", "-S", "--needed"]
        if gui_sudo():
            # from Agora (the app store) (no terminal, Labyrinth's reviewed catalog): no questions, and the password box instead of sudo
            cmd += ["--noconfirm", "--sudo", gui_sudo()]
        steps.append((f"build and install {len(aur)} package(s) from the AUR ({', '.join(aur)})", cmd + aur, None))
    for pb in built_here:
        steps.append((f"build and install {pb} from its PKGBUILD", ["makepkg", "-si"], pb))
    for i in chosen:
        # one-time setup commands of a component (root-owned components.json only), run as administrator after its packages
        for cmd in comps[i].get("after_install", []):
            if isinstance(cmd, list) and cmd and all(isinstance(a, str) for a in cmd):
                steps.append((f"set up {comps[i]['name']}: {' '.join(cmd)}", sudo(cmd), None))
    user = os.environ.get("SUDO_USER") or os.environ.get("USER") or ""
    for i in chosen:
        groups = comps[i].get("add_groups", [])
        if groups and user:
            # a device's helper only answers members of its group; it counts from the next login
            steps.append((f"let {user} use the device ({', '.join(groups)} group; log out and in again)", sudo(["usermod", "-aG", ",".join(groups), user]), None))
    for i in chosen:
        units = comps[i].get("enable_global", [])
        if units:
            steps.append((f"enable {', '.join(units)} for every user", sudo(["systemctl", "--global", "enable"] + units), None))
        units = comps[i].get("enable_system", [])
        if units:
            steps.append((f"start {', '.join(units)}", sudo(["systemctl", "enable", "--now"] + units), None))
    return steps


def plan_remove(chosen, comps, installed):
    pk = []
    for i in chosen:
        for p in all_packages(comps[i]):
            if p in installed and p not in pk:
                pk.append(p)
    steps = []
    for i in chosen:
        units = comps[i].get("enable_global", [])
        if units and any(p in installed for p in all_packages(comps[i])):
            steps.append((f"disable {', '.join(units)}", sudo(["systemctl", "--global", "disable"] + units), None))
        units = comps[i].get("enable_system", [])
        if units and any(p in installed for p in all_packages(comps[i])):
            steps.append((f"stop {', '.join(units)}", sudo(["systemctl", "disable", "--now"] + units), None))
    if pk:
        steps.append((f"remove {len(pk)} package(s) and their unneeded dependencies", sudo(["pacman", "-Rs"] + pk), None))
    return steps


def run_steps(steps, dry_run):
    for desc, argv, pkgbuild in steps:
        shown = " ".join(shlex.quote(a) for a in argv)
        print(f"==> {desc}\n    {shown}" + (f"   (in a copy of {pkgbuild})" if pkgbuild else ""))
        if dry_run:
            continue
        if pkgbuild:
            src = os.path.join(PKGBUILDS, pkgbuild)
            if not os.path.isfile(os.path.join(src, "PKGBUILD")):
                print(f"error: no PKGBUILD at {src}", file=sys.stderr)
                return 1
            with tempfile.TemporaryDirectory(prefix="labyrinth-build-") as tmp:
                work = os.path.join(tmp, pkgbuild)
                shutil.copytree(src, work)
                rc = subprocess.run(argv + makepkg_gui_args(tmp), cwd=work).returncode
        else:
            rc = subprocess.run(argv).returncode
        if rc != 0:
            print(f"error: step failed (exit {rc}); stopping", file=sys.stderr)
            return rc
    return 0


def main(argv, installed=None):
    args = [a for a in argv if a != "--dry-run"]
    dry = "--dry-run" in argv
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = args[0], args[1:]
    try:
        comps, presets = load()
    except (OSError, ValueError, KeyError) as e:
        print(f"error: cannot read {MANIFEST}: {e}", file=sys.stderr)
        return 2
    if installed is None:
        installed = pacman_installed()
        if installed is None:
            installed = set()
            if cmd in ("install", "remove") and not dry:
                print("error: pacman not found; labyrinth-apps works on Arch-based systems only "
                      "(use --dry-run to see what it would do)", file=sys.stderr)
                return 2
            print("note: pacman not found; showing everything as not installed", file=sys.stderr)

    if cmd == "list":
        w = max(len(i) for i in comps)
        for i, c in comps.items():
            flag = " [proprietary]" if c.get("proprietary") else ""
            print(f"{i:<{w}}  {state(c, installed):<13} {c['name']}{flag}")
        print("\npresets: " + ", ".join(f"{n} ({', '.join(v) or 'nothing extra'})" for n, v in presets.items()))
        return 0
    if cmd == "info" and len(rest) == 1:
        c = comps.get(rest[0])
        if not c:
            print(f"error: unknown component {rest[0]!r}", file=sys.stderr)
            return 2
        print(f"{c['name']}  ({state(c, installed)})\n{c['description']}")
        print("packages: " + (", ".join(all_packages(c)) or "-") + (f"  [built from PKGBUILD {c['pkgbuild']}]" if c.get("pkgbuild") else ""))
        if c.get("unverified_packages"):
            print("not found in Arch's repos (need CachyOS repo or AUR): " + ", ".join(c["unverified_packages"]))
        if c.get("notes"):
            print("after install: " + c["notes"])
        return 0
    if cmd in ("install", "remove"):
        ids = list(rest)
        if "--preset" in ids:
            k = ids.index("--preset")
            if k + 1 >= len(ids) or ids[k + 1] not in presets:
                print(f"error: --preset needs one of: {', '.join(presets)}", file=sys.stderr)
                return 2
            ids = ids[:k] + presets[ids[k + 1]] + ids[k + 2:]
        if not ids:
            print("error: nothing selected", file=sys.stderr)
            return 2
        try:
            chosen = resolve(ids, presets, comps)
        except KeyError as e:
            print(f"error: unknown component {e}", file=sys.stderr)
            return 2
        if cmd == "install":
            steps = plan_install(chosen, comps, installed, fresh=never_synced())
        else:
            steps = plan_remove(chosen, comps, installed)
        if not steps:
            print("nothing to do")
            return 0
        rc = run_steps(steps, dry)
        if rc == 0 and cmd == "install" and not dry:
            for i in chosen:
                if comps[i].get("notes"):
                    print(f"\n{comps[i]['name']}: {comps[i]['notes']}")
        return rc
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
