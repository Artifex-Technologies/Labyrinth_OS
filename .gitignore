target/
__pycache__/
*.pyc
work/
out/
repo/

# Community macOS icons imported with labyrinth-icon for local ISO builds (only computer.png, the
# supplied This PC icon, is committed).
profile/airootfs/usr/share/icons/Labyrinth/apps/scalable/*
!profile/airootfs/usr/share/icons/Labyrinth/apps/scalable/.keep
!profile/airootfs/usr/share/icons/Labyrinth/apps/scalable/computer.png

# makepkg build output (scripts/build-local-packages.sh): sources, the staging folders and the packages themselves
packages/pkgbuilds/*/src/
packages/pkgbuilds/*/pkg/
packages/pkgbuilds/*/*.pkg.tar.*
packages/pkgbuilds/*/*.tar.gz
packages/pkgbuilds/*/*.tar.gz.part
packages/pkgbuilds/*/*.tar.xz
packages/pkgbuilds/*/*.zip
packages/pkgbuilds/*/*.rpm
packages/pkgbuilds/*/*.deb
# bare clones made by git-based recipes (any folder makepkg clones next to a -git recipe)
packages/pkgbuilds/*-git/*/
profile/airootfs/usr/share/labyrinth/pkgbuilds/*-git/*/
