# Labyrinth's package repository: builds what changed on GitHub, signs it and publishes it (labyrinth-publish-repo,
# packages/publish-repo; until 2026-11-13 scripts/publish-repo.py). A user unit on the build PC (the one holding the signing
# key). Install: see docs/PACKAGE_REPO.md; the program is built and installed to ~/.local/bin by packages/publish-repo's README.
[Unit]
Description=Publish Labyrinth's package repository
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/labyrinth-publish-repo
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=4h
