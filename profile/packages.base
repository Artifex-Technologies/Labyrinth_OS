# Base system for every Labyrinth install. Optional software lives in
# airootfs/usr/share/labyrinth/components.json; scripts/gen-packages.py combines the two
# into packages.x86_64. Comments on their own lines only.
base
base-devel
linux-firmware
# processor microcode for both makers (the boot loader loads the one that matches)
intel-ucode
amd-ucode
btrfs-progs
snapper
sbctl
networkmanager
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
# kernels: default and the LTS fallback, each with headers and open NVIDIA modules
linux-cachyos
linux-cachyos-headers
linux-cachyos-nvidia-open
linux-cachyos-lts
linux-cachyos-lts-headers
linux-cachyos-lts-nvidia-open
nvidia-utils
nvidia-settings
vulkan-icd-loader
# iGPU: fallback display and passthrough host
mesa
vulkan-intel
# AMD graphics (Radeon, including the integrated Radeon 8060S of Ryzen AI Max): Vulkan for games and apps
vulkan-radeon
# screen rotation and light sensors on tablets and 2-in-1s
iio-sensor-proxy
# laptop sound: Intel's audio DSP firmware and the mixer setups for laptop codecs (without them most Intel laptops have no sound)
sof-firmware
alsa-ucm-conf
# laptops with two graphics chips (Intel or AMD plus NVIDIA): run an app on the NVIDIA one (prime-run, "Launch using dedicated GPU")
nvidia-prime
switcheroo-control
# ASUS laptops and tablets (fans, power modes, keyboard light, charge limit); removed at install on other computers
asusctl
rog-control-center
intel-media-driver
# desktop: Yggdrasil on Hyprland; the login screen is Yggdrasil's greeter, which greetd shows in cage
hyprland
waybar
greetd
cage
xdg-desktop-portal-hyprland
# diagnostics for the driver lab
pciutils
usbutils
dkms
glmark2
iperf3
vulkan-tools
python
# git: Claude Code and every project need it
git
# installer: Calamares is built from packages/pkgbuilds/calamares into the local repo
calamares
rsync
# Calamares unpackfs needs unsquashfs
squashfs-tools
# Calamares displaymanager imports toml
python-toml
grub
librsvg
# finds Windows and other systems on the disks for the boot menu (dual boot)
os-prober
ntfs-3g
efibootmgr
grub-btrfs
# grub-btrfsd (snapshot entries) needs inotifywait; hostname for scripts
inotify-tools
inetutils
dosfstools
zram-generator
mkinitcpio
# live medium: archiso's initramfs hooks and the UEFI memory tester
mkinitcpio-archiso
memtest86+-efi
# CachyOS signing keys and mirror lists, so the installed system can keep updating
cachyos-keyring
cachyos-mirrorlist
cachyos-v3-mirrorlist
archlinux-keyring
bluez
bluez-utils
# firewall: incoming blocked, outgoing allowed (like Windows); System Settings > Firewall
ufw
# terminal: Ghostty (GPU, tabs in the title bar, F12 drop-down); replaced Konsole and Yakuake
ghostty
# the Yggdrasil look: colours, GTK theme, icons
yggdrasil-theme
liki-icon-theme
# desktop 2, Omarchy-style tiling: Hyprland session, bar, launcher, terminal, notifications (no dock)
nwg-displays
mako
hyprlock
hypridle
hyprsunset
fuzzel
foot
uwsm
hyprpolkitagent
cliphist
grim
slurp
wl-clipboard
playerctl
firefox
vivaldi
vivaldi-ffmpeg-codecs
xdg-utils
curl
libnotify
pavucontrol
blueman
# input devices: Logitech (Solaar), gaming mice (Piper), Razer (OpenRazer)
solaar
piper
libratbag
openrazer-daemon
openrazer-driver-dkms
python-openrazer
nm-connection-editor
ttf-jetbrains-mono-nerd
# extra desktop tools
btop
# emoji font for the bar's weather icons
noto-fonts-emoji
# Labyrinth's own file explorer, built from packages/pkgbuilds into the local repo
yggdrasil-minos
yggdrasil-settings
yggdrasil-polkit
yggdrasil-portal
yggdrasil-agora
yggdrasil-calculator
yggdrasil-panel
yggdrasil-idle
yggdrasil-keyring-sync
# the session (Hyprland with Yggdrasil's settings), lock and login screen, dragging X11 windows, the installer
yggdrasil-session
yggdrasil-lock
yggdrasil-xmove
yggdrasil-installer
# Player: Yggdrasil's video player (VLC underneath; continue where you left off)
yggdrasil-player
# the boot screen (Settings > Appearance > Boot screen; theme labyrinth-rain)
plymouth
gnome-keyring
clamav
python-dbus
# power modes (Performance / Balanced / Power saver) for Settings and the battery applet
power-profiles-daemon
# Minos: archives (7z), PDF and video previews, RAR
7zip
poppler
ffmpegthumbnailer
unrar
# wallpaper
swaybg
edk2-shell
# printing, built in (Settings > Printers): CUPS, network printers found by themselves (Avahi), USB printers that need no driver
# (ipp-usb), drivers for HP, Epson, Canon and most others, and a "Print to PDF" printer
cups
cups-filters
cups-pdf
ipp-usb
avahi
nss-mdns
gutenprint
foomatic-db
foomatic-db-engine
hplip
