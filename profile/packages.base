# Base system for every Labyrinth install. Optional software lives in
# airootfs/usr/share/labyrinth/components.json; scripts/gen-packages.py combines the two
# into packages.x86_64. Comments on their own lines only.
base
base-devel
linux-firmware
intel-ucode
btrfs-progs
snapper
sbctl
networkmanager
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
# kernels: default and the LTS fallback, each with headers and open NVIDIA modules
linux-cachyos
linux-cachyos-headers
linux-cachyos-nvidia-open
linux-cachyos-lts
linux-cachyos-lts-headers
linux-cachyos-lts-nvidia-open
nvidia-utils
nvidia-settings
vulkan-icd-loader
# iGPU: fallback display and passthrough host
mesa
vulkan-intel
intel-media-driver
# desktop (Omarchy model)
hyprland
waybar
sddm
xdg-desktop-portal-hyprland
# diagnostics for the driver lab
pciutils
usbutils
dkms
glmark2
iperf3
vulkan-tools
python
# installer: Calamares is built from packages/pkgbuilds/calamares into the local repo
calamares
rsync
# Calamares unpackfs needs unsquashfs
squashfs-tools
# Calamares displaymanager imports toml
python-toml
grub
efibootmgr
grub-btrfs
# grub-btrfsd (snapshot entries) needs inotifywait; hostname for scripts
inotify-tools
inetutils
dosfstools
zram-generator
mkinitcpio
# live medium: archiso's initramfs hooks and the UEFI memory tester
mkinitcpio-archiso
memtest86+-efi
# CachyOS signing keys and mirror lists, so the installed system can keep updating
cachyos-keyring
cachyos-mirrorlist
cachyos-v3-mirrorlist
archlinux-keyring
bluez
bluez-utils
# desktop 1, macOS-style: KDE Plasma with the WhiteSur look (built into the local repo)
plasma-desktop
plasma-workspace
kwin
kscreen
plasma-nm
plasma-pa
powerdevil
bluedevil
kde-gtk-config
xdg-desktop-portal-kde
breeze
breeze-gtk
# (KDE System Settings comes with plasma-desktop but is hidden; Labyrinth Settings replaces it)
kdeplasma-addons
plasma-browser-integration
plasma-systemmonitor
kscreenlocker
# unlocks KDE Wallet with the login password, so apps stop asking for it
kwallet-pam
# tiling for one screen of the macOS-style desktop (labyrinth-tiling; ours, packages/pkgbuilds)
kwin-scripts-krohnkite
# window title bars for KDE apps: traffic lights, matches the app, no border (ours, packages/pkgbuilds)
klassy
# firewall: incoming blocked, outgoing allowed (like Windows); System Settings > Firewall
ufw
plasma-firewall
kio-extras
# terminal: Ghostty (GPU, tabs in the title bar, F12 drop-down); replaced Konsole and Yakuake
ghostty
spectacle
appmenu-gtk-module
kvantum
whitesur-kde-theme
whitesur-gtk-theme
mactahoe-icon-theme
whitesur-cursor-theme
plasma6-applets-window-title
# desktop 2, Omarchy-style tiling: Hyprland session, bar, launcher, terminal, notifications (no dock)
nwg-displays
mako
hyprlock
hypridle
fuzzel
foot
uwsm
hyprpolkitagent
cliphist
grim
slurp
wl-clipboard
playerctl
firefox
vivaldi
vivaldi-ffmpeg-codecs
kvantum
xdg-utils
curl
libnotify
pavucontrol
blueman
# input devices: Logitech (Solaar), gaming mice (Piper), Razer (OpenRazer)
solaar
piper
libratbag
openrazer-daemon
openrazer-driver-dkms
python-openrazer
nm-connection-editor
ttf-jetbrains-mono-nerd
# extra desktop tools
btop
# emoji font for the bar's weather icons
noto-fonts-emoji
# Labyrinth's own file explorer, built from packages/pkgbuilds into the local repo
labyrinth-minos
labyrinth-settings
labyrinth-calculator
labyrinth-panel
# power modes (Performance / Balanced / Power saver) for Settings and the battery applet
power-profiles-daemon
# Minos: archives (7z), PDF and video previews, RAR
7zip
poppler
ffmpegthumbnailer
unrar
# wallpaper
swaybg
