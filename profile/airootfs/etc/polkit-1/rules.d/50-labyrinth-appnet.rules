// A person logged in at this computer may ask for the per-app network rules to be (re)loaded. The service only
// loads what is already in /etc/labyrinth/app-network.json, which only root writes, so this gives nothing away.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "labyrinth-appnet.service" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
