# Default applications for everyone: Vivaldi (the browser on the medium) opens web links and pages; the installer sets
# the one chosen on its Browsers page. A user's own choices (~/.config/mimeapps.list) override this.
[Default Applications]
x-scheme-handler/http=vivaldi-stable.desktop
x-scheme-handler/https=vivaldi-stable.desktop
x-scheme-handler/about=vivaldi-stable.desktop
x-scheme-handler/unknown=vivaldi-stable.desktop
text/html=vivaldi-stable.desktop
application/xhtml+xml=vivaldi-stable.desktop
# Markdown and text files open in the Markdown Reader (yggdrasil-reader)
text/markdown=yggdrasil-reader.desktop
text/x-markdown=yggdrasil-reader.desktop
text/plain=yggdrasil-reader.desktop
# Videos open in VLC, in Yggdrasil's look (yggdrasil-player)
video/x-matroska=yggdrasil-player.desktop
video/mp4=yggdrasil-player.desktop
video/x-m4v=yggdrasil-player.desktop
video/x-msvideo=yggdrasil-player.desktop
video/quicktime=yggdrasil-player.desktop
video/webm=yggdrasil-player.desktop
video/x-ms-wmv=yggdrasil-player.desktop
video/x-flv=yggdrasil-player.desktop
video/mpeg=yggdrasil-player.desktop
video/mp2t=yggdrasil-player.desktop
video/ogg=yggdrasil-player.desktop
video/3gpp=yggdrasil-player.desktop
