# Arch Linux mirrors for Labyrinth OS. Without an active Server line pacman cannot sync
# (the package's own list ships everything commented out). The geo mirror picks one near you;
# the others are fallbacks. Run `sudo reflector --save /etc/pacman.d/mirrorlist` to rank them.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
