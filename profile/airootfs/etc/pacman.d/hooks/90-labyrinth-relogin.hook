[Trigger]
Operation = Upgrade
Type = Package
Target = kwin
Target = kscreenlocker
Target = plasma-workspace
Target = kscreen

[Action]
Description = Plasma was upgraded: log out and in (or reboot) soon, then run labyrinth-selfcheck
When = PostTransaction
Exec = /usr/bin/sh -c 'echo "==> Plasma was upgraded while a session may be running. Until you log out and in (or reboot), the lock screen can fail to start. Afterwards run: labyrinth-selfcheck"'
