#!/usr/bin/env bash
# labyrinth-sarina-voice-setup: give Sarina a voice (once, as yourself, no root). Needs a network connection and about 400 MB.
#
# Creates ~/.local/share/labyrinth/tts/venv with Piper (piper-tts from PyPI, a fast local neural text-to-speech engine) and downloads three
# English voices from the Piper voice collection (Hugging Face, rhasspy/piper-voices; about 60 MB each). Then Settings > Sound > "Sarina's voice"
# lets you choose and hear them. Nothing is sent anywhere when she speaks: it is all made on this computer.
set -euo pipefail
dir=${LABYRINTH_TTS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/labyrinth/tts}
mkdir -p "$dir/voices"
[[ -x $dir/venv/bin/python ]] || python3 -m venv "$dir/venv"
"$dir/venv/bin/pip" install --quiet --upgrade piper-tts
if [[ $# -gt 0 ]]; then voices=("$@"); else voices=(en_US-amy-medium en_GB-jenny_dioco-medium en_US-lessac-medium); fi
"$dir/venv/bin/python" -m piper.download_voices --download-dir "$dir/voices" "${voices[@]}" 2>&1 | tail -3
echo "Done. Voices in $dir/voices: $(ls "$dir/voices" | grep -c '\.onnx$')"
