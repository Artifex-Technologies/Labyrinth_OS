#!/bin/sh
# A stand-in for `sudo` that asks through Labyrinth's own password box (polkit) instead of a terminal prompt. Agora (the app store) gives it to
# `yay --sudo` and to labyrinth-apps (LABYRINTH_SUDO) so installs can run without a terminal. `sudo -v` and other flags do nothing here.
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    -*) shift ;;
    *) break ;;
  esac
done
[ $# -eq 0 ] && exit 0
# pacman goes through labyrinth-pkg-root when Agora (the app store) gave a cancel file, so the install can be cancelled and cleaned up
if [ "$1" = pacman ] && [ -n "$LABYRINTH_CANCEL_FILE" ]; then
  shift
  exec pkexec /usr/local/bin/labyrinth-pkg-root "$LABYRINTH_CANCEL_FILE" pacman "$@"
fi
exec pkexec "$@"
