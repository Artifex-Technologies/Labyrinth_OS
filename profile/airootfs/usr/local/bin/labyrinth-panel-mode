#!/bin/sh
# Switch the macOS-style desktop between Labyrinth's own top bar and dock (Rust, yggdrasil-panel)
# and Plasma's panels.
#
#   labyrinth-panel-mode on       use yggdrasil-panel (Plasma's panels are removed)
#   labyrinth-panel-mode off      back to Plasma's panels
#   labyrinth-panel-mode status
#
# (pkill matches the full path: the script itself is called labyrinth-panel-mode, and process names
# are cut at 15 characters, so `pkill -x yggdrasil-panel` would kill the script too.)
# The choice is kept in ~/.config/labyrinth/panel-on and the panel starts at login (autostart).
# yggdrasil-panel is the default from the first login (labyrinth-plasma-setup turns it on). It has no
# system tray, quick settings or global menu yet; `off` brings Plasma's panels back for those.
set -u
conf=${XDG_CONFIG_HOME:-$HOME/.config}
flag=$conf/labyrinth/panel-on
auto=$conf/autostart/yggdrasil-panel.desktop
layout=/usr/share/labyrinth/plasma/layout.js
# Notifications: with the panel on, its own service (inside yggdrasil-panel) is the notification server. mako and Plasma
# each ship a D-Bus activation file for org.freedesktop.Notifications, so whichever one an early notification woke would
# hold the name; this per-user file comes first and starts the panel instead. Plasma's own server only exists while its
# panels do (they are removed below), and mako is only for the Hyprland session.
reload_bus() { dbus-send --session --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 || true; }
svc=${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services/org.freedesktop.Notifications.service
# The Super key on its own: our start menu while the panel is on, Plasma's launcher otherwise.
meta() { kwriteconfig6 --file kwinrc --group ModifierOnlyShortcuts --key Meta "$1" && { qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true; }; }
plasma() { busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$1" >/dev/null 2>&1; }

case "${1:-status}" in
  on)
    command -v yggdrasil-panel >/dev/null || { echo "yggdrasil-panel is not installed" >&2; exit 1; }
    mkdir -p "$conf/labyrinth" "$conf/autostart"
    : >"$flag"
    mkdir -p "$(dirname "$svc")"
    printf '[D-BUS Service]\nName=org.freedesktop.Notifications\nExec=/usr/local/bin/labyrinth-notify-activate\n' >"$svc"
    reload_bus
    cat >"$auto" <<'D'
[Desktop Entry]
Type=Application
Name=Labyrinth Panel
Exec=/usr/bin/yggdrasil-panel
X-KDE-autostart-phase=2
D
    plasma 'panels().forEach(function (p) { p.remove(); });'
    pkill -f '^/usr/bin/yggdrasil-panel$' 2>/dev/null
    # Let KWin drop Plasma's panels (and the space they reserved) before the dock is placed, or it sits above it.
    sleep 2
    setsid -f /usr/bin/yggdrasil-panel >/dev/null 2>&1
    meta "org.yggdrasil.Panel,/Panel,org.yggdrasil.Panel,ToggleStart"
    echo "yggdrasil-panel on"
    ;;
  off)
    rm -f "$flag" "$auto" "$svc"
    reload_bus
    pkill -f '^/usr/bin/yggdrasil-panel$' 2>/dev/null
    plasma 'panels().forEach(function (p) { p.remove(); });'
    [ -r "$layout" ] && plasma "$(cat "$layout")"
    meta "org.kde.plasmashell,/PlasmaShell,org.kde.PlasmaShell,activateLauncherMenu"
    echo "Plasma panels on"
    ;;
  status)
    if [ -e "$flag" ]; then echo "yggdrasil-panel"; else echo "plasma"; fi
    ;;
  *) echo "usage: labyrinth-panel-mode on|off|status" >&2; exit 2 ;;
esac
