#!/usr/bin/env python3
"""labyrinth-tiling: make one screen of the macOS-style desktop work like Omarchy.

  labyrinth-tiling                 show which screen tiles
  labyrinth-tiling OUTPUT          tile OUTPUT (a connector name such as HDMI-A-1; see `kscreen-doctor -o`)
  labyrinth-tiling off             back to floating windows everywhere

The tiling screen gets: Krohnkite tiling with gaps and no title bars, its own workspaces 1-9
(Plasma's per-screen virtual desktops), a slim top bar with the workspaces and the clock and no
dock, and the Omarchy meaning of the shared keys (labyrinth-screen-keys: Win+Arrows move focus,
Win+W closes, Win+1..9 switch workspace...). Every other screen keeps floating windows and the
Windows-style keys. labyrinth-displays runs this for a monitor whose rule in displays.json says
"tiling": true (the LG DualUp), once.
"""
import glob
import json
import os
import subprocess
import sys

GAP = 8  # px around and between tiles, as in Omarchy


def kwrite(group, key, value, file="kwinrc"):
    groups = []
    for g in group if isinstance(group, list) else [group]:
        groups += ["--group", g]
    subprocess.run(["kwriteconfig6", "--file", file] + groups + ["--key", key, str(value)], check=False)


def kread(group, key, file="kwinrc"):
    r = subprocess.run(["kreadconfig6", "--file", file, "--group", group, "--key", key],
                       capture_output=True, text=True)
    return r.stdout.strip()


def connectors():
    """Every display connector the GPUs have, plugged in or not (card1-HDMI-A-1 -> HDMI-A-1)."""
    names = set()
    for path in glob.glob(os.environ.get("LABYRINTH_DRM_GLOB", "/sys/class/drm/card*-*")):
        base = os.path.basename(path)
        names.add(base.split("-", 1)[1])
    try:
        out = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=10).stdout
        names.update(o["name"] for o in json.loads(out).get("outputs", []))
    except Exception:
        pass
    return sorted(names)


def output_geometry(name):
    """(x, y) of an enabled output in the desktop layout, from kscreen."""
    try:
        out = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=10).stdout
        for o in json.loads(out).get("outputs", []):
            if o.get("name") == name and o.get("enabled"):
                return o["pos"]["x"], o["pos"]["y"]
    except Exception:
        pass
    return None


def plasma(script):
    subprocess.run(["busctl", "--user", "call", "org.kde.plasmashell", "/PlasmaShell",
                    "org.kde.PlasmaShell", "evaluateScript", "s", script],
                   capture_output=True, text=True, timeout=30)


# The tiling screen's bar: workspaces on the left, the clock in the middle, nothing else, like
# Omarchy's waybar. Tagged in its config so `off` can find it again.
REMOVE_BAR = """
panels().forEach(function (p) {
  p.currentConfigGroup = ["Labyrinth"];
  if (p.readConfig("tilingBar", "") == "yes") { p.remove(); }
});
"""

ADD_BAR = """
var target = -1;
for (var i = 0; i < screenCount; ++i) {
  var g = screenGeometry(i);
  if (g.x == %(x)d && g.y == %(y)d) { target = i; }
}
if (target >= 0) {
  var bar = new Panel("org.kde.panel", target);
  bar.location = "top";
  bar.height = 2 * Math.floor(gridUnit * 1.4 / 2);
  bar.floating = false;
  bar.hiding = "none";
  bar.currentConfigGroup = ["Labyrinth"];
  bar.writeConfig("tilingBar", "yes");
  var pager = bar.addWidget("org.kde.plasma.pager");
  pager.currentConfigGroup = ["General"];
  pager.writeConfig("displayedText", "Number");
  pager.writeConfig("showOnlyCurrentScreen", true);
  bar.addWidget("org.kde.plasma.panelspacer");
  bar.addWidget("org.kde.plasma.digitalclock");
  bar.addWidget("org.kde.plasma.panelspacer");
}
"""


def reload_scripts():
    for s in ("krohnkite", "labyrinth-screen-keys", "labyrinth-tile-border"):
        subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", s],
                       capture_output=True)
    # Reconfigure loads the enabled scripts again, which then read their new settings.
    subprocess.run(["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"], capture_output=True)


def enable(output):
    others = [c for c in connectors() if c != output]
    kwrite("Windows", "PerOutputVirtualDesktops", "true")
    kwrite("Script-labyrinth-screen-keys", "tilingOutputs", output)
    kwrite("Script-labyrinth-tile-border", "tilingOutputs", output)
    k = "Script-krohnkite"
    kwrite(k, "ignoreScreen", ",".join(others))
    kwrite(k, "noTileBorder", "true")
    for side in ("Left", "Right", "Top", "Bottom", "Between"):
        kwrite(k, "screenGap" + side, GAP)
    kwrite(k, "layoutPerDesktop", "true")
    # Prompts and password dialogs float instead of being tiled (KDE's portal and polkit agent).
    kwrite(k, "floatingClass", "xdg-desktop-portal-kde,org.kde.polkit-kde-authentication-agent-1,polkit-kde-authentication-agent-1,org.kde.kdialog,kdialog")
    kwrite("Plugins", "krohnkiteEnabled", "true")
    reload_scripts()
    plasma(REMOVE_BAR)
    pos = output_geometry(output)
    if pos:
        plasma(ADD_BAR % {"x": pos[0], "y": pos[1]})
    print(f"labyrinth-tiling: {output} tiles; other screens float ({', '.join(others) or 'none'})")


def disable():
    kwrite("Plugins", "krohnkiteEnabled", "false")
    kwrite("Script-labyrinth-screen-keys", "tilingOutputs", "")
    kwrite("Script-labyrinth-tile-border", "tilingOutputs", "")
    kwrite("Windows", "PerOutputVirtualDesktops", "false")
    reload_scripts()
    plasma(REMOVE_BAR)
    print("labyrinth-tiling: off; windows float on every screen")


def main(argv):
    if not argv:
        current = kread("Script-labyrinth-screen-keys", "tilingOutputs")
        print(f"tiling screen: {current or 'none'}")
        return 0
    if argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "off":
        disable()
        return 0
    if argv[0] not in connectors():
        print(f"labyrinth-tiling: no screen called {argv[0]}; known: {', '.join(connectors())}", file=sys.stderr)
        return 1
    enable(argv[0])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
