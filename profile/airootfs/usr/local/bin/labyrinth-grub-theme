#!/bin/sh
# Install the Labyrinth boot menu theme: grub-evodevo (MIT, vendored in /usr/share/labyrinth/grub-evodevo)
# with Labyrinth's settings: black background, the purple accent, an emblem for each system (Labyrinth's
# included), drawn for the screen's own resolution (read from the connected monitor; 1920x1080 when none can be read).
# Run as root on the installed system (the installer's boot step does).
#
#   labyrinth-grub-theme              install the theme and regenerate grub.cfg
#   labyrinth-grub-theme --preview F  write a picture of the menu to F (needs no root, changes nothing)
#
# It is safe to fail: grub.cfg and /etc/default/grub are put back if the result has no menu entries.
set -eu
src=/usr/share/labyrinth/grub-evodevo
preview=
if [ "${1:-}" = --preview ]; then
    preview=${2:?usage: labyrinth-grub-theme --preview FILE}
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp -r "$src"/. "$work"/
cd "$work"

set_var() {   # set_var NAME VALUE: change the first NAME=VALUE setting (the later ones are derived values)
    sed -i -E "0,/^$1=/s|^$1=.*|$1='$2'|" install.sh
}
# the monitor's own resolution (its preferred mode, the first one the kernel lists), so the menu fills whatever screen it is
# installed on; the text grows with it (22 at 1080 lines)
native=
for f in /sys/class/drm/card*-*; do
    [ "$(cat "$f/status" 2>/dev/null)" = connected ] || continue
    m=$(head -n1 "$f/modes" 2>/dev/null)
    m=${m%%[!0-9x]*}
    case $m in [0-9]*x[0-9]*) native=$m; break ;; esac
done
[ -n "$native" ] || native=1920x1080
screen_w=${native%x*}
screen_h=${native#*x}
set_var ScreenWidth "$screen_w"
set_var ScreenHeight "$screen_h"
set_var FontSize $(( (22 * screen_h + 540) / 1080 ))
set_var Wallpaper '#000000'
set_var Title 'Labyrinth OS'
# Colours are H S V (degrees, percent, percent): the Labyrinth purple (hue 259) on black.
set_var MenuBg '259 30 9'
set_var HeaderBg '259 35 12'
set_var FocusBg '259 61 55'
set_var TextFg '0 0 100'
set_var IconFg '0 0 88'
set_var BarBg '0 0 100'
set_var BarFg '259 61 84'
set_var MenuOpacity 0.88
set_var HeaderOpacity 0.95
set_var FocusOpacity 0.90

if [ -n "$preview" ]; then
    sh ./install.sh -preview >/dev/null
    cp preview.png "$preview" 2>/dev/null || cp ./*.png "$preview"
    exit 0
fi

[ "$(id -u)" -eq 0 ] || { echo "labyrinth-grub-theme: run as root" >&2; exit 1; }
cp /etc/default/grub "$work/grub.default.orig"
cp /boot/grub/grub.cfg "$work/grub.cfg.orig"
# GRUB must draw at the size the theme is made for (and picks its own if the firmware cannot show that one)
if grep -q '^#\?GRUB_GFXMODE=' /etc/default/grub; then
    sed -i -E "s|^#?GRUB_GFXMODE=.*|GRUB_GFXMODE=$native,auto|" /etc/default/grub
else
    echo "GRUB_GFXMODE=$native,auto" >>/etc/default/grub
fi
grep -q '^GRUB_GFXPAYLOAD_LINUX=' /etc/default/grub || echo 'GRUB_GFXPAYLOAD_LINUX=keep' >>/etc/default/grub

if sh ./install.sh >"$work/install.log" 2>&1 && grep -q '^[[:space:]]*menuentry ' /boot/grub/grub.cfg && grep -q initrd /boot/grub/grub.cfg; then
    # The theme gives each menu entry its icon through a class it writes into grub.cfg (evodevo_entry_N), which every later
    # grub-mkconfig (a kernel update, the boot screen's set-up) loses. GRUB also picks an icon by the entry's own first class
    # (labyrinth, windows, uefi_cd_dvd ...), which grub-mkconfig always writes: each icon is kept under that name too.
    icons=/usr/share/grub/themes/evodevo/icons
    grep -o -E "^[[:space:]]*menuentry '[^']*'( --class [^ ]+)+" /boot/grub/grub.cfg | while read -r line; do
        entry=$(printf '%s\n' "$line" | grep -o -E 'evodevo_entry_[0-9]+' | head -n1)
        own=$(printf '%s\n' "$line" | grep -o -E -- '--class [^ ]+' | sed 's/--class //' | grep -v '^evodevo_entry_' | head -n1)
        if [ -n "$entry" ] && [ -n "$own" ] && [ -f "$icons/$entry.png" ] && [ ! -e "$icons/$own.png" ]; then
            cp "$icons/$entry.png" "$icons/$own.png"
        fi
    done
    echo "labyrinth-grub-theme: installed"
else
    echo "labyrinth-grub-theme: failed; putting the old menu back" >&2
    tail -5 "$work/install.log" >&2 || true
    cp "$work/grub.default.orig" /etc/default/grub
    cp "$work/grub.cfg.orig" /boot/grub/grub.cfg
    exit 1
fi
