#!/usr/bin/env python3
"""Write Hyprland monitor settings for this machine's displays.

  labyrinth-displays --print      show the Lua it would write
  labyrinth-displays --apply      write ~/.config/hypr/monitors.lua and reload Hyprland
  labyrinth-displays --list       show what Hyprland reports, for writing rules
  labyrinth-displays --kde        KDE Plasma: give each new monitor its best mode (once per monitor)

Hyprland names outputs (DP-1, HDMI-A-1 ...) by whichever port a cable is in, and those
names are not known until the machine is running, so rules in displays.json match on the
monitor's model/description instead, and the connector name is filled in here. Uses the
documented `hl.monitor({ output, mode, position, scale })` call
(https://wiki.hypr.land/Configuring/Basics/Monitors/). Reads `hyprctl monitors all -j`;
set LABYRINTH_HYPRCTL to override hyprctl (tests).

Monitors no rule matches get the best mode they offer (see best_mode) and an automatic position.
"""
import json
import os
import subprocess
import sys
import time

SYSTEM_RULES = os.environ.get("LABYRINTH_DISPLAY_RULES", "/usr/share/labyrinth/displays.json")


def user_rules_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "labyrinth", "displays.json")


def load_rules():
    for path in (user_rules_path(), SYSTEM_RULES):
        try:
            with open(path, encoding="utf-8") as f:
                return json.load(f).get("monitors", [])
        except (OSError, ValueError):
            continue
    return []


def hyprctl_monitors():
    cmd = os.environ.get("LABYRINTH_HYPRCTL", "hyprctl").split()
    r = subprocess.run(cmd + ["monitors", "all", "-j"], capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "hyprctl failed")
    return json.loads(r.stdout)


def parse_mode(s):
    """'3440x1440@143.97Hz' -> (3440, 1440, 143.97)."""
    size, _, hz = s.rstrip("Hz").partition("@")
    w, _, h = size.partition("x")
    return int(w), int(h), float(hz or 0)


def pick_mode(monitor, want):
    """Exact 'WxH@R' string Hyprland knows for the wanted mode, or None.

    want is 'WxH@Hz'. Prefers the highest refresh rate not above Hz (plus 0.5, since
    144 Hz panels advertise 143.97), else the closest one above it.
    """
    size, _, hz = want.partition("@")
    w, _, h = size.partition("x")
    try:
        w, h, hz = int(w), int(h), float(hz or 0)
    except ValueError:
        return None
    cands = []
    for m in monitor.get("availableModes", []):
        try:
            mw, mh, mr = parse_mode(m)
        except ValueError:
            continue
        if (mw, mh) == (w, h):
            cands.append(mr)
    if not cands:
        return None
    within = [r for r in cands if r <= hz + 0.5]
    best = max(within) if within else min(cands)  # nothing at or below: the closest one above
    return f"{w}x{h}@{best:g}"


def best_mode(monitor, native=None):
    """'WxH@R' for the best mode a monitor offers, or None if it lists none.

    Hyprland's "preferred" mode is whatever the monitor's EDID lists first, which on some
    monitors over some cables is a slow one (a 120 Hz monitor stuck at 30 Hz).

    `native` is the panel's own resolution (w, h). When given, only modes of the same shape
    (aspect ratio within 1%) are considered, so a tall 16:18 panel is never given a 16:9 mode
    just because that mode has more pixels (the LG DualUp advertises 3840x2160 and got it).
    Then: the native resolution if it runs at 60 Hz or more (at its highest refresh rate);
    otherwise the largest resolution of that shape that does; if nothing reaches 60 Hz, the
    highest refresh rate available (largest resolution on a tie).
    """
    modes = []
    for m in monitor.get("availableModes", []):
        try:
            modes.append(parse_mode(m))
        except ValueError:
            continue
    if not modes:
        return None
    if native and native[0] and native[1]:
        ratio = native[0] / native[1]
        same = [m for m in modes if abs(m[0] / m[1] - ratio) <= 0.01 * ratio]
        if same:
            modes = same
    fast = [m for m in modes if m[2] >= 59.5]
    if fast:
        at_native = [m for m in fast if native and (m[0], m[1]) == tuple(native)]
        if at_native:
            pool = at_native
        else:
            top_pixels = max(w * h for w, h, _ in fast)
            pool = [m for m in fast if m[0] * m[1] == top_pixels]
        w, h, r = max(pool, key=lambda m: m[2])
    else:
        w, h, r = max(modes, key=lambda m: (m[2], m[0] * m[1]))
    return f"{w}x{h}@{r:g}"


def find_rule(monitor, rules):
    text = f"{monitor.get('description', '')} {monitor.get('model', '')} {monitor.get('make', '')}".lower()
    for r in rules:
        if r.get("match", "").lower() in text:
            return r
    return None


def plan(monitors, rules):
    """List of dicts: output, mode, position, scale, note."""
    active = [m for m in monitors if not m.get("disabled")]
    matched = [(m, find_rule(m, rules)) for m in active]
    primary = next((m for m, r in matched if r and r.get("primary")), None)
    out, pw = [], None
    if primary:
        r = find_rule(primary, rules)
        scale = float(r.get("scale", 1))
        wanted = pick_mode(primary, r["mode"]) if r.get("mode") else None
        mode = wanted or best_mode(primary, (primary.get("width"), primary.get("height")))
        w, h = (parse_mode(mode)[:2] if mode else (primary["width"], primary["height"]))
        pw = w / scale
        out.append({"output": primary["name"], "mode": mode or "preferred", "position": "0x0", "scale": scale,
                    "note": "primary" + ("" if wanted else " (wanted mode not offered; using " + ("best available)" if mode else "preferred)"))})
    for m, r in matched:
        if m is primary:
            continue
        if not r:
            best = best_mode(m, (m.get("width"), m.get("height")))
            out.append({"output": m["name"], "mode": best or "preferred", "position": "auto", "scale": 1,
                        "note": "no rule matched; " + (f"best mode {best}" if best else "no modes listed, using preferred")})
            continue
        scale = float(r.get("scale", 1))
        wanted = pick_mode(m, r["mode"]) if r.get("mode") else None
        mode = wanted or best_mode(m, (m.get("width"), m.get("height")))
        w, h = (parse_mode(mode)[:2] if mode else (m["width"], m["height"]))
        lw = w / scale
        place = r.get("place")
        if place == "right_of_primary" and pw is not None:
            pos = f"{round(pw)}x{round(r.get('y', 0))}"
        elif place == "left_of_primary" and pw is not None:
            pos = f"{round(-lw)}x{round(r.get('y', 0))}"
        else:
            pos = "auto"
        note = "" if wanted else "wanted mode not offered; using " + ("best available" if mode else "preferred")
        if (w / scale) % 1 or (h / scale) % 1:
            note = (note + "; " if note else "") + "scaled size is not a whole number of pixels (Hyprland will round it)"
        out.append({"output": m["name"], "mode": mode or "preferred", "position": pos, "scale": scale, "note": note})
    return out


def lua(entries):
    lines = ["-- Written by labyrinth-displays from /usr/share/labyrinth/displays.json. Safe to delete;",
             "-- it is regenerated at login. Edit ~/.config/labyrinth/displays.json to change the rules."]
    for e in entries:
        note = f"  -- {e['note']}" if e["note"] else ""
        lines.append(
            f'hl.monitor({{ output = {json.dumps(e["output"])}, mode = {json.dumps(e["mode"])}, '
            f'position = {json.dumps(e["position"])}, scale = {e["scale"]:g} }}){note}'
        )
    return "\n".join(lines) + "\n"


def edid_model(edid):
    """'MFG Name' from raw EDID bytes, e.g. 'ACR X34 GS' or 'GSM LG SDQHD'; '' if it cannot be read."""
    if len(edid) < 128 or edid[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
        return ""
    raw = (edid[8] << 8) | edid[9]
    mfg = "".join(chr(((raw >> shift) & 31) + 64) for shift in (10, 5, 0))
    name = ""
    for off in (54, 72, 90, 108):
        d = edid[off:off + 18]
        if d[:3] == b"\x00\x00\x00" and d[3] == 0xFC:
            name = d[5:18].split(b"\n")[0].decode("ascii", "replace").strip()
    return f"{mfg} {name}".strip()


def read_edid_model(connector, drm_root="/sys/class/drm"):
    """Model of the monitor on a connector (kscreen's 'DP-1' is the kernel's 'card1-DP-1')."""
    import glob
    for path in glob.glob(os.path.join(drm_root, f"card*-{connector}", "edid")):
        try:
            with open(path, "rb") as f:
                model = edid_model(f.read())
            if model:
                return model
        except OSError:
            continue
    return ""


def kscreen_outputs():
    cmd = os.environ.get("LABYRINTH_KSCREEN", "kscreen-doctor").split()
    r = subprocess.run(cmd + ["-j"], capture_output=True, text=True, timeout=10)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "kscreen-doctor failed")
    return json.loads(r.stdout).get("outputs", [])


def _mode_strings(o):
    return [f"{m['size']['width']}x{m['size']['height']}@{m['refreshRate']:.2f}Hz" for m in o.get("modes", [])]


def _native(o):
    """The panel's own resolution: the first preferred mode, else the current one."""
    modes = {str(m["id"]): m for m in o.get("modes", [])}
    for mid in o.get("preferredModes", []):
        m = modes.get(str(mid))
        if m:
            return (m["size"]["width"], m["size"]["height"])
    m = modes.get(str(o.get("currentModeId")))
    return (m["size"]["width"], m["size"]["height"]) if m else None


def _mode_id(o, wxh_at):
    """kscreen's id for a 'WxH@R' string (refresh matched to within half a hertz)."""
    w, h, r = parse_mode(wxh_at)
    for m in o.get("modes", []):
        if (m["size"]["width"], m["size"]["height"]) == (w, h) and abs(m["refreshRate"] - r) < 0.51:
            return m["id"]
    return None


def kde_plan(outputs, seen, rules=None, models=None):
    """What to apply on KDE: ([kscreen-doctor arguments], [state keys to remember], [notes]).

    A monitor is handled once (its key is the output name plus its list of modes), so a mode the
    user later picks in System Settings is never overridden. A monitor that matches a rule in
    displays.json (by the model name in its EDID) gets that rule's mode, scale and position;
    any other monitor gets the best mode of its own shape (see best_mode) and KDE's own scale.
    """
    rules = rules or []
    models = models or {}
    args, keys, notes = [], [], []
    new = []
    for o in outputs:
        # Plasma 6.8 no longer has an "enabled" key: connected with a current mode means in use
        if not (o.get("connected") and o.get("enabled", bool(o.get("currentModeId")))):
            continue
        key = o["name"] + "|" + ",".join(sorted(_mode_strings(o)))
        if seen.get(key):
            continue
        model = models.get(o["name"], "")
        rule = find_rule({"description": model, "model": model, "make": ""}, rules) if model else None
        new.append((o, key, model, rule))

    # Mode and scale for every new output.
    chosen = {}
    for o, key, model, rule in new:
        want = None
        if rule and rule.get("mode"):
            exact = pick_mode({"availableModes": _mode_strings(o)}, rule["mode"])
            want = exact
        if not want:
            want = best_mode({"availableModes": _mode_strings(o)}, _native(o))
        mid = _mode_id(o, want) if want else None
        scale = float(rule["scale"]) if rule and rule.get("scale") else None
        chosen[o["name"]] = (mid, want, scale)
        if mid is not None and str(mid) != str(o.get("currentModeId")):
            args.append(f"output.{o['name']}.mode.{mid}")
        if scale is not None and abs(scale - float(o.get("scale", 1))) > 0.001:
            args.append(f"output.{o['name']}.scale.{scale:g}")
        notes.append(f"{o['name']} ({model or 'unknown model'}): {want}" + (f" at {scale:g}x" if scale else "") + (" [rule]" if rule else ""))
        keys.append(key)

    # Placement from the rules: the primary at 0,0, the others beside it.
    primary = next(((o, r) for o, k, m, r in new if r and r.get("primary")), None)
    if primary:
        po, pr = primary
        pmid, pwant, pscale = chosen[po["name"]]
        pw = parse_mode(pwant)[0] if pwant else po["size"]["width"]
        plogical = pw / (pscale or float(po.get("scale", 1)) or 1)
        args.append(f"output.{po['name']}.position.0,0")
        args.append(f"output.{po['name']}.priority.1")
        for o, k, m, r in new:
            if o is po or not r:
                continue
            _, want, scale = chosen[o["name"]]
            place = r.get("place")
            lw = (parse_mode(want)[0] if want else o["size"]["width"]) / (scale or float(o.get("scale", 1)) or 1)
            y = round(r.get("y", 0))
            if place == "right_of_primary":
                args.append(f"output.{o['name']}.position.{round(plogical)},{y}")
            elif place == "left_of_primary":
                args.append(f"output.{o['name']}.position.{round(-lw)},{y}")
    return args, keys, notes


def tiling_target(outputs, rules, models):
    """(connector, model) of the connected monitor whose rule says "tiling": true, or None.

    That monitor becomes the Omarchy-style tiling screen of the macOS-style desktop (see
    labyrinth-tiling). Matched by the EDID model like every other rule, so it follows the monitor
    to whichever port it is plugged into.
    """
    for o in outputs:
        if not (o.get("connected") and o.get("enabled")):
            continue
        model = models.get(o["name"], "")
        rule = find_rule({"description": model, "model": model, "make": ""}, rules) if model else None
        if rule and rule.get("tiling"):
            return o["name"], model
    return None


def kde_main():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    state_path = os.path.join(base, "labyrinth", "displays-kde.json")
    try:
        seen = json.load(open(state_path, encoding="utf-8"))
    except (OSError, ValueError):
        seen = {}
    try:
        outputs = kscreen_outputs()
    except Exception as e:
        print(f"labyrinth-displays: cannot read monitors from KDE: {e}", file=sys.stderr)
        return 1
    drm_root = os.environ.get("LABYRINTH_DRM_ROOT", "/sys/class/drm")
    models = {o["name"]: read_edid_model(o["name"], drm_root) for o in outputs if o.get("connected")}
    args, keys, notes = kde_plan(outputs, seen, load_rules(), models)
    for n in notes:
        print(f"labyrinth-displays: {n}")
    if args:
        cmd = os.environ.get("LABYRINTH_KSCREEN", "kscreen-doctor").split()
        r = subprocess.run(cmd + args, capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            print(f"labyrinth-displays: kscreen-doctor failed: {r.stderr.strip()}", file=sys.stderr)
            return 1
    for k in keys:
        seen[k] = True
    # The tiling screen, once per monitor and port: after that, `labyrinth-tiling off` or another
    # screen chosen by hand is never overridden.
    target = tiling_target(outputs, load_rules(), models)
    if target:
        key = f"tiling|{target[1]}|{target[0]}"
        if not seen.get(key):
            tool = os.environ.get("LABYRINTH_TILING", "labyrinth-tiling").split()
            if args:
                time.sleep(2)  # let the new positions settle; the tiling bar is placed by them
            r = subprocess.run(tool + [target[0]], capture_output=True, text=True, timeout=60)
            print(f"labyrinth-displays: tiling screen {target[0]} ({target[1]}): " + (r.stdout.strip() or r.stderr.strip()))
            if r.returncode == 0:
                seen[key] = True
    os.makedirs(os.path.dirname(state_path), exist_ok=True)
    with open(state_path, "w", encoding="utf-8") as f:
        json.dump(seen, f, indent=1)
    return 0


def main(argv):
    if "--kde" in argv:
        return kde_main()
    try:
        monitors = hyprctl_monitors()
    except Exception as e:
        print(f"labyrinth-displays: cannot read monitors from Hyprland: {e}", file=sys.stderr)
        return 1
    if "--list" in argv:
        for m in monitors:
            print(f"{m['name']}: {m.get('description', '?')}  native {m['width']}x{m['height']}@{m.get('refreshRate', 0):g}"
                  f"  scale {m.get('scale', 1)}  at {m.get('x', 0)},{m.get('y', 0)}")
            print("    modes: " + ", ".join(m.get("availableModes", [])[:8]) + (" ..." if len(m.get("availableModes", [])) > 8 else ""))
        return 0
    entries = plan(monitors, load_rules())
    if not entries:
        print("labyrinth-displays: no active monitors", file=sys.stderr)
        return 1
    text = lua(entries)
    if "--apply" not in argv:
        print(text, end="")
        return 0
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    path = os.path.join(base, "hypr", "monitors.lua")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    old = open(path, encoding="utf-8").read() if os.path.exists(path) else None
    if old == text:
        return 0  # nothing changed; do not reload
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)
    cmd = os.environ.get("LABYRINTH_HYPRCTL", "hyprctl").split()
    subprocess.run(cmd + ["reload"], capture_output=True, timeout=5)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
