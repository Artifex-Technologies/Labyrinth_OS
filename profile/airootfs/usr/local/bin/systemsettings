#!/bin/sh
# Labyrinth Settings replaces KDE's System Settings. Plasma still runs `systemsettings MODULE` from
# its tray icons and menus ("Configure display settings", the network and sound applets...); this
# wrapper comes first in PATH and sends those to the matching Labyrinth Settings page. Modules
# Labyrinth Settings does not cover yet open on their own with kcmshell6, never the whole KDE app.
# The real one stays at /usr/bin/systemsettings (plasma-desktop depends on it).
case "${1:-}" in
  "")                                     exec yggdrasil-settings ;;
  kcm_kscreen)                            exec yggdrasil-settings displays ;;
  kcm_pulseaudio)                         exec yggdrasil-settings sound ;;
  kcm_networkmanagement|kcm_wifi)         exec yggdrasil-settings network ;;
  kcm_bluetooth)                          exec yggdrasil-settings bluetooth ;;
  kcm_powerdevilprofilesconfig|kcm_energyinfo) exec yggdrasil-settings power ;;
  kcm_clock)                              exec yggdrasil-settings datetime ;;
  kcm_lookandfeel|kcm_colors|kcm_wallpaper|kcm_accentcolor) exec yggdrasil-settings appearance ;;
  kcm_firewall)                           exec yggdrasil-settings firewall ;;
  kcm_about-distro)                       exec yggdrasil-settings about ;;
  kcm_*)                                  exec kcmshell6 "$@" ;;
  *)                                      exec yggdrasil-settings ;;
esac
