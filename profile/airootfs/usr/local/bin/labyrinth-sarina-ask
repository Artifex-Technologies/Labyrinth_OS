#!/usr/bin/env bash
# labyrinth-sarina-ask FILE.wav: give Sarina a spoken question and print what she answers, as plain text.
#
# The panel's Fylgja (the notch) records the question when you press Super+S, runs this with the recording, shows what
# it prints, and deletes the recording afterwards. A non-zero exit shows the printed line as the reason there is no answer.
#
# Two steps, both local (nothing leaves the computer):
#   1. speech to text: whisper.cpp (`whisper-cli`) with a model file. It looks for the model in
#      $LABYRINTH_STT_MODEL, then ~/.local/share/labyrinth/stt/ggml-*.bin, then /usr/share/labyrinth/stt/ggml-*.bin.
#   2. the words go to Sarina as a normal question (labyrinth-ask-sarina), read-only, so her session is watched by
#      Heimdall like any other. She is asked for a short plain-text answer, because it is shown on a small card.
# Setup (once): pacman -S whisper-cpp, and put a model (for example ggml-base.en.bin) in one of the folders above.
# See docs/SARINA_VOICE.md.
set -u

wav=${1:-}
[[ -f $wav ]] || { echo "There is no recording to send."; exit 1; }

command -v sarina >/dev/null 2>&1 || { echo "Sarina is not installed on this computer yet."; exit 1; }

# Her model server (Ollama) has to be running already; this script does not start it or download anything.
if ! curl -fsS -m 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
  echo "Sarina's model server is not running."
  exit 1
fi

# ---- 1. speech to text
model=${LABYRINTH_STT_MODEL:-}
if [[ -z $model ]]; then
  for f in "${XDG_DATA_HOME:-$HOME/.local/share}"/labyrinth/stt/ggml-*.bin /usr/share/labyrinth/stt/ggml-*.bin; do
    [[ -f $f ]] && { model=$f; break; }
  done
fi
if ! command -v "${LABYRINTH_WHISPER:-whisper-cli}" >/dev/null 2>&1 || [[ -z $model || ! -f $model ]]; then
  echo "Listening is not set up yet: it needs whisper-cpp and a speech model (see docs/SARINA_VOICE.md)."
  exit 1
fi
# Names it should expect: without them "Zlothra" comes out as "lothra" and "Sarina" as "serina". The owner can add more in ~/.config/labyrinth/stt-words (one line, commas).
words=$(head -n1 "${XDG_CONFIG_HOME:-$HOME/.config}/labyrinth/stt-words" 2>/dev/null)
heard=$("${LABYRINTH_WHISPER:-whisper-cli}" -m "$model" -f "$wav" -nt -np -l "${LABYRINTH_STT_LANG:-en}" --prompt "Matt, Matthew, Zlothra, Sarina, Labyrinth, Heimdall, Fylgja, Minos, Chymaera, Limbo, Obsidian, Hyprland${words:+, $words}." 2>/dev/null | tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/  */ /g')
# laughter comes out as [laughs], (laughing) or *chuckles*: she is told they laughed (what she said just before may become an inside joke)
laughed=""
printf '%s' "$heard" | grep -qiE '[[(*] *(laugh|laughs|laughing|laughter|chuckl|giggl)[a-z]* *[])*]' && laughed=1
# whisper writes things like [BLANK_AUDIO] or (silence) when there is no speech
clean=$(printf '%s' "$heard" | sed -E 's/\[[^]]*\]//g; s/\*[^*]*\*//g; s/\([^)]*\)//g; s/^[[:space:]]+//; s/[[:space:]]+$//')
# on silence or noise whisper tends to "hear" a stock phrase; those are not questions
lower=$(printf '%s' "$clean" | tr 'A-Z' 'a-z' | sed -E 's/[[:punct:]]//g; s/^[[:space:]]+//; s/[[:space:]]+$//')
case $lower in you|thank\ you|thanks|thanks\ for\ watching|thank\ you\ for\ watching|thanks\ for\ listening|please\ subscribe|subscribe|see\ you\ next\ time|see\ you|bye|bye\ bye|goodbye|okay|ok|uh|um|hmm|oh|yeah|"") clean="" ;; esac
[[ -z $clean && -n $laughed ]] && clean="Haha."
[[ -n $clean ]] || { echo "I did not catch that. Try again, a little closer to the microphone."; exit 1; }

# How it was said (pace, loudness, pitch, pauses, against the owner's own usual): a private style hint for her, or nothing. Numbers only are kept, the recording is
# deleted by the panel afterwards. Off with Settings > Sarina > "Notice how I sound" (or LABYRINTH_TONE=0).
tone=""
# off when "Notice how I sound" is switched off in Settings > Sarina (labyrinth-sarina-setting tone)
[[ $(cat "${XDG_CONFIG_HOME:-$HOME/.config}/labyrinth/sarina-tone" 2>/dev/null) == off ]] && LABYRINTH_TONE=0
if [[ ${LABYRINTH_TONE:-1} != 0 ]] && command -v sarina-tone >/dev/null 2>&1; then
  tone=$(sarina-tone "$wav" 2>/dev/null | head -n1)
fi

# What was understood is printed at once (the card shows it while Sarina works on the answer).
printf 'Heard: "%s"\n' "$clean"

# ---- 2. ask Sarina
# A smaller model answers voice questions (faster): VOICE_MODEL in ~/.config/labyrinth/sarina.env or $LABYRINTH_VOICE_MODEL;
# without one, her usual model is used.
vm=${LABYRINTH_VOICE_MODEL:-$(sed -n 's/^VOICE_MODEL=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/labyrinth/sarina.env" 2>/dev/null | head -n1)}
if [[ -n $vm ]]; then
  # if the voice model is missing or failing, her usual model answers instead of nothing
  main=$(sed -n 's/^OPENAI_MODEL=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/labyrinth/sarina.env" 2>/dev/null | head -n1)
  [[ -n $main && $main != "$vm" ]] && export SARINA_FALLBACK_MODELS=${SARINA_FALLBACK_MODELS:-$main}
  export OPENAI_MODEL=$vm
fi
# The rules for a spoken answer go in her system prompt once (LABYRINTH_VOICE_RULES), so a conversation's history is the questions and answers, not the same paragraph again and again.
export LABYRINTH_VOICE_RULES="$(cat /usr/share/labyrinth/sarina-voice-rules.txt 2>/dev/null)"
prompt="${laughed:+(They laughed.) }${tone:+(Style hint, never mention it or say how they sound: $tone) }$clean"
# the desktop names a conversation's turns YGGDRASIL_CONVERSATION (older panels: LABYRINTH_CONVERSATION)
conversation=${YGGDRASIL_CONVERSATION:-${LABYRINTH_CONVERSATION:-}}
# Her answer comes a sentence per line as she writes it (the panel starts saying the first while the rest is still coming): each line is
# passed on at once, without markdown marks. A line that is only a think block or empty is skipped.
tmp=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/sarina-ask.XXXXXX")
trap 'rm -f "$tmp"' EXIT
thinking=0
labyrinth-ask-sarina --voice ${conversation:+--conversation "$conversation"} --cwd "$HOME" "$prompt" 2>/dev/null | while IFS= read -r line || [[ -n $line ]]; do
  # a think block (her reasoning, when it is not stripped before) may span lines: nothing of it is said
  if [[ $thinking -eq 1 ]]; then [[ $line == *'</think>'* ]] && { thinking=0; line=${line#*</think>}; } || continue; fi
  if [[ $line == *'<think>'* && $line != *'</think>'* ]]; then thinking=1; line=${line%%<think>*}; fi
  line=$(printf '%s' "$line" | sed -E 's/<think>.*<\/think>//g; s/\*\*//g; s/`//g; s/^#+ *//; s/^[[:space:]]+//; s/[[:space:]]+$//')
  [[ -n $line ]] || continue
  if [[ ! -s $tmp ]]; then printf '\n'; fi
  printf '%s\n' "$line"
  printf '%s\n' "$line" >> "$tmp"
done
rc=${PIPESTATUS[0]}
if [[ $rc -eq 3 ]]; then echo "I did not catch that: it sounded like my own voice."; exit 1; fi
if [[ $rc -ne 0 && ! -s $tmp ]]; then echo "Sarina could not answer (is her service set up? try: sarina doctor)."; exit 1; fi
[[ -s $tmp ]] || { echo "Sarina had no answer."; exit 1; }
exit 0
