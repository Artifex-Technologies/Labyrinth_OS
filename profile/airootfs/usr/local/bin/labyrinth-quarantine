#!/usr/bin/env python3
"""labyrinth-quarantine: a safe place for files the malware scan is confident about, and the way back.

  labyrinth-quarantine add PATH --signature NAME   move a regular file into quarantine (it is made unreadable by other users and
                                                   not executable; nothing is deleted)
  labyrinth-quarantine list [--json]               what is in quarantine
  labyrinth-quarantine restore ID                  put it back where it was (never over an existing file) and remember its
                                                   content, so the scan does not quarantine the same file again
  labyrinth-quarantine delete ID                   delete it for good
  labyrinth-quarantine allowed SHA256              exit 0 if you said "keep this file" for that content

Everything lives in ~/.local/share/labyrinth/quarantine/ (one folder per item: payload + info.json) and
~/.config/labyrinth/scan-allow (hashes you restored). Nothing here needs root; quarantine never touches files you do not own.
"""
import hashlib
import json
import os
import re
import shutil
import sys
import time
import uuid

HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "labyrinth", "quarantine")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "labyrinth")
ALLOW = os.path.join(CONF, "scan-allow")
ID_RE = re.compile(r"^[0-9a-f]{12}$")


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def allowed(digest):
    try:
        with open(ALLOW) as f:
            return any(l.split("#")[0].strip() == digest for l in f)
    except OSError:
        return False


def add(path, signature, source="scan"):
    """Quarantine a file. Returns its id; raises ValueError (nothing moved) if it is not something we should move."""
    st = os.lstat(path)
    if not os.path.isfile(path) or os.path.islink(path):
        raise ValueError("not a regular file")
    if st.st_uid != os.getuid():
        raise ValueError("not your file")
    digest = sha256(path)
    qid = uuid.uuid4().hex[:12]
    d = os.path.join(DATA, qid)
    os.makedirs(d, mode=0o700)
    info = {"id": qid, "original": os.path.abspath(path), "signature": signature, "sha256": digest, "size": st.st_size,
            "mode": st.st_mode & 0o7777, "when": time.strftime("%Y-%m-%d %H:%M:%S"), "source": source}
    payload = os.path.join(d, "payload")
    try:
        shutil.move(path, payload)
    except OSError as e:
        shutil.rmtree(d, ignore_errors=True)
        raise ValueError("cannot move it: %s" % e)
    os.chmod(payload, 0o600)
    with open(os.path.join(d, "info.json"), "w") as f:
        json.dump(info, f, indent=1)
    return qid


def items():
    out = []
    try:
        names = sorted(os.listdir(DATA))
    except OSError:
        return out
    for n in names:
        if not ID_RE.match(n):
            continue
        try:
            with open(os.path.join(DATA, n, "info.json")) as f:
                info = json.load(f)
            if info.get("id") == n:
                out.append(info)
        except (OSError, ValueError):
            continue
    return sorted(out, key=lambda i: i["when"], reverse=True)


def find(qid):
    if not ID_RE.match(qid or ""):
        raise ValueError("bad id")
    for i in items():
        if i["id"] == qid:
            return i
    raise ValueError("no such item")


def restore(qid):
    info = find(qid)
    d = os.path.join(DATA, qid)
    target = info["original"]
    if os.path.lexists(target):
        target += ".restored"
    n = 1
    while os.path.lexists(target):
        n += 1
        target = info["original"] + ".restored%d" % n
    os.makedirs(os.path.dirname(target), exist_ok=True)
    shutil.move(os.path.join(d, "payload"), target)
    os.chmod(target, info.get("mode", 0o644) & ~0o111)  # comes back without the execute bit
    os.makedirs(CONF, exist_ok=True)
    with open(ALLOW, "a") as f:
        f.write("%s  # restored %s: %s\n" % (info["sha256"], time.strftime("%Y-%m-%d"), os.path.basename(info["original"])))
    shutil.rmtree(d, ignore_errors=True)
    return target


def delete(qid):
    find(qid)
    shutil.rmtree(os.path.join(DATA, qid))


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0 if len(argv) >= 2 else 2
    cmd = argv[1]
    try:
        if cmd == "add" and len(argv) >= 3:
            sig = argv[argv.index("--signature") + 1] if "--signature" in argv else "unknown"
            print(add(argv[2], sig))
        elif cmd == "list":
            lst = items()
            if "--json" in argv:
                print(json.dumps(lst))
            else:
                for i in lst:
                    print("%s  %s  %s  %s" % (i["id"], i["when"], i["signature"], i["original"]))
        elif cmd == "restore" and len(argv) == 3:
            print(restore(argv[2]))
        elif cmd == "delete" and len(argv) == 3:
            delete(argv[2])
        elif cmd == "allowed" and len(argv) == 3:
            return 0 if allowed(argv[2]) else 1
        else:
            print("labyrinth-quarantine: bad arguments (see --help)", file=sys.stderr)
            return 2
    except (ValueError, OSError) as e:
        print("labyrinth-quarantine: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
