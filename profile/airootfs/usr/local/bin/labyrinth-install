#!/usr/bin/env bash
# Start the installer from the desktop (launcher, dock). Live medium only.
#
# Yggdrasil's installer (yggdrasil-installer) runs as the live user and asks pkexec for root only for the install itself
# (labyrinth-install-system, named in the "installer" integration file). Calamares, the old installer, was removed on 2026-11-07.
set -u
if command -v yggdrasil-installer >/dev/null; then
  exec yggdrasil-installer "$@"
fi
msg="The installer (yggdrasil-installer) is missing from this medium."
notify-send "Labyrinth installer" "$msg" 2>/dev/null || echo "$msg" >&2
exit 1
