#!/usr/bin/env bash
# Switch between Labyrinth's two desktops:
#   labyrinth-switch-mode macos     the macOS-style desktop (KDE Plasma, floating windows)
#   labyrinth-switch-mode tiling    the Omarchy-style desktop (Hyprland, keyboard-first tiling)
#   labyrinth-switch-mode           show the current one
# It sets what the login screen starts on, then logs you out (save your work first). A desktop
# cannot be swapped under a running session; you land on the login screen with the other one
# selected.
set -u
current() {
  case ${XDG_CURRENT_DESKTOP:-} in
    *KDE*) echo "macos (Plasma)" ;;
    *Hyprland*) echo "tiling (Hyprland)" ;;
    *) echo "unknown (${XDG_CURRENT_DESKTOP:-none})" ;;
  esac
}
case ${1:-} in
  macos|mac|plasma)  target=plasma ;;
  tiling|omarchy|hyprland) target=hyprland ;;
  "") echo "Current desktop: $(current)"; echo "Usage: labyrinth-switch-mode macos|tiling"; exit 0 ;;
  *) echo "usage: labyrinth-switch-mode macos|tiling" >&2; exit 2 ;;
esac
pkexec /usr/local/bin/labyrinth-set-session "$target" "$USER" || exit 1
notify-send "Labyrinth" "Switching desktop. Logging out..." 2>/dev/null
sleep 1
case ${XDG_CURRENT_DESKTOP:-} in
  *KDE*) qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null || loginctl terminate-session "${XDG_SESSION_ID:-self}" ;;
  *) if command -v uwsm >/dev/null 2>&1; then uwsm stop; else hyprctl dispatch exit; fi ;;
esac
