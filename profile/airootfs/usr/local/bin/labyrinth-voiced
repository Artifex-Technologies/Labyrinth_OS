#!/usr/bin/env python3
"""labyrinth-voiced: Sarina's voice service (a user service). Keeps the Chatterbox Turbo voice ready and makes speech on request, one sentence at a time,
so the first sentence can be played while the next is still being made.

  talk to it:   a unix socket, $XDG_RUNTIME_DIR/labyrinth-sarina/voiced.sock (private to you), JSON lines
    {"op":"speak","text":"Hello. How are you?"}  ->  {"wav":"/run/user/1000/labyrinth-sarina/voiced-1.wav","text":"Hello."} per sentence, then {"done":true}
                                                      (the caller plays and deletes each file)
    {"op":"ping"}    ->  {"ok":true,"loaded":false,"engine":"chatterbox"}
    {"op":"warm"}    ->  {"ok":true} at once; loads the models in the background (the panel sends it when you start to talk)
    {"op":"unload"}  ->  frees the graphics card memory now
  The models load on the first request (a few seconds) and are freed after 10 minutes without one (LABYRINTH_VOICE_IDLE seconds), so the card
  is free for games and for Sarina's language model.

  Where things are: models in ~/.local/share/labyrinth/tts/chatterbox/onnx (fp16 by default), the voice to copy in
  ~/.local/share/labyrinth/tts/chatterbox/voice/sarina.wav (about 10 seconds of clean speech; it never leaves this computer).
  Run it with the Python that has onnxruntime-gpu: ~/.local/share/labyrinth/tts/gpu-venv/bin/python (see the user unit).
"""
import gc
import json
import os
import random
import re
import socket
import sys
import threading
import time

sys.path.insert(0, os.environ.get("LABYRINTH_LIB", "/usr/local/lib/labyrinth"))

RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "labyrinth-sarina")
SOCK = os.environ.get("LABYRINTH_VOICED_SOCKET", os.path.join(RUN, "voiced.sock"))
DIR = os.path.expanduser(os.environ.get("LABYRINTH_VOICE_DIR", "~/.local/share/labyrinth/tts/chatterbox"))
DTYPE = os.environ.get("LABYRINTH_VOICE_DTYPE", "fp16")
IDLE = float(os.environ.get("LABYRINTH_VOICE_IDLE", "600"))
REFERENCE = os.environ.get("LABYRINTH_VOICE_REFERENCE", os.path.join(DIR, "voice", "sarina.wav"))


# How names are said: the model reads letters, so "Zlothra" needs spelling the way it sounds. The owner can add or change entries in
# ~/.config/labyrinth/pronunciations (lines "word = how to spell it so it is said right").
PRONUNCIATIONS = {"sarina": "Suhreenuh", "zlothra": "Zlawthruh", "fylgja": "Filyah", "chymaera": "Kymeeruh", "heimdall": "Haymdawl"}


def pronunciations():
    out = dict(PRONUNCIATIONS)
    try:
        with open(os.path.expanduser("~/.config/labyrinth/pronunciations")) as f:
            for line in f:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.split("=", 1)
                    if k.strip() and v.strip():
                        out[k.strip().lower()] = v.strip()
    except OSError:
        pass
    return out


def respell(text, table=None):
    for word, spoken in (table if table is not None else pronunciations()).items():
        text = re.sub(r"(?<![A-Za-z])" + re.escape(word) + r"(?![A-Za-z])", spoken, text, flags=re.IGNORECASE)
    return text


# emoji and pictographs: the voice would try to read them out loud
EMOJI = re.compile("[\U0001F000-\U0001FAFF\U00002600-\U000027BF\U0001F900-\U0001F9FF\U00002B00-\U00002BFF\uFE0F\u200d]")


# How a sentence is delivered. She may start a sentence with [joking], [unsure], [urgent], [gentle] or [serious] (the voice prompt tells her to do so sparingly):
# the voice changes how steady or lively it is, may add a small sound (a chuckle after a joke, a hesitation when unsure), and
# the pause around it changes. Anything else in [brackets] is dropped, so she can never make the voice cough or laugh by accident.
DELIVERY = {
    #            temperature, pause before (ms), pause after (ms)
    "joking": (0.92, 0, 150),
    "unsure": (0.85, 0, 120),
    "urgent": (0.72, 0, 0),
    "gentle": (0.62, 100, 500),
    "serious": (0.55, 350, 250),
}
DEFAULT_DELIVERY = (0.8, 0, 0)
TAG_RE = re.compile(r"\[(joking|unsure|urgent|gentle|serious)\]", re.IGNORECASE)
MARK_RE = re.compile(r"^\s*«(\w+)»\s*")


def mark_delivery(text):
    """[joking] -> «joking», so the tag survives cleaning and sentence splitting."""
    return TAG_RE.sub(lambda m: " «" + m.group(1).lower() + "» ", text)


def take_delivery(sentence):
    """(delivery name or "", the sentence without its tag(s))."""
    name = ""
    m = MARK_RE.match(sentence)
    if m:
        name = m.group(1)
        sentence = sentence[m.end():]
    return name, re.sub(r"\s*«\w+»\s*", " ", sentence).strip()


def dress(sentence, name, rng):
    """The words as the model should say them for this delivery: small sounds and hesitations, chosen by chance so she does not do it every time."""
    s = sentence
    if name == "joking" and s and s[-1] in ".!?" and rng.random() < 0.6:
        s = s + " [chuckle]"
    elif name == "unsure" and rng.random() < 0.7:
        s = rng.choice(["Hmm... ", "Um... ", "Well... "]) + s[0].lower() + s[1:] if s else s
    elif name == "urgent":
        s = s.rstrip(".") + ("!" if not s.endswith(("!", "?")) else "")
    # no sigh before a gentle sentence: it came as an exhale before most tarot answers (the owner, 2026-10-26)
    return s


def clean(text):
    """Plain words: no [tags] (the model would act them out: [chuckle], [cough]), no markup, one space between words."""
    text = EMOJI.sub("", text)
    text = re.sub(r"\[[^\]]*\]|<[^>]*>", " ", text)
    text = re.sub(r"[*`#_]+", "", text)
    text = re.sub(r"\s+", " ", text).strip()
    return respell(re.sub(r"\s+([.,!?;:])", r"\1", text))


def split_sentences(text, min_len=28, max_len=240):
    """Sentences, with very short ones joined to the next (they sound clipped alone) and very long ones cut at a comma."""
    parts = [p.strip() for p in re.split(r"(?<=[.!?])\s+", text) if p.strip()]
    out, cur = [], ""
    for p in parts:
        if MARK_RE.match(p) and cur:  # a new delivery starts here: never joined to what came before
            out.append(cur)
            cur = ""
        cur = (cur + " " + p).strip() if cur else p
        if len(cur) >= min_len:
            out.append(cur)
            cur = ""
    if cur:
        if out and len(cur) < min_len and not MARK_RE.match(cur):
            out[-1] = out[-1] + " " + cur
        else:
            out.append(cur)
    final = []
    for s in out:
        while len(s) > max_len:
            cut = s.rfind(",", 0, max_len)
            cut = cut if cut > 40 else s.rfind(" ", 0, max_len)
            final.append(s[: cut + 1].strip())
            s = s[cut + 1:].strip()
        final.append(s)
    return [s if s[-1] in ".!?," else s + "." for s in final if s]


class Voice:
    def __init__(self):
        self.engine = None
        self.lock = threading.Lock()
        self.last = time.time()
        self.counter = 0

    def load(self):
        if self.engine is not None:
            return
        from chatterbox_engine import Chatterbox  # imported late: onnxruntime is big
        try:
            self.engine = Chatterbox(DIR, DTYPE, gpu=True)
        except Exception as e:  # no usable graphics card: the processor still works, slower
            print("voiced: graphics card not usable (%s); using the processor" % str(e)[:120], file=sys.stderr, flush=True)
            self.engine = Chatterbox(DIR, "fp32" if DTYPE == "fp16" else DTYPE, gpu=False)
        self.engine.set_voice(REFERENCE)
        print("voiced: voice ready in %.1fs (%s)" % (self.engine.load_seconds, ",".join(self.engine.providers)), file=sys.stderr, flush=True)

    def unload(self):
        with self.lock:
            self.engine = None
            gc.collect()

    def speak(self, text, send):
        import numpy as np
        import soundfile as sf
        rng = np.random.default_rng(random.getrandbits(32))
        with self.lock:
            self.last = time.time()
            self.load()
            for s in split_sentences(clean(mark_delivery(text))):
                name, plain = take_delivery(s)
                if not plain:
                    continue
                temperature, before, after = DELIVERY.get(name, DEFAULT_DELIVERY)
                spoken = dress(plain, name, rng)
                for attempt in range(3):
                    try:
                        wav = self.engine.speak(spoken, rng, temperature=temperature)
                        break
                    except ValueError:
                        if attempt == 2:
                            raise
                        print("voiced: invalid audio for a sentence, trying again", file=sys.stderr, flush=True)
                self.counter += 1
                path = os.path.join(RUN, "voiced-%d-%d.wav" % (os.getpid(), self.counter))
                sf.write(path, wav, 24000, subtype="PCM_16")
                if not send({"wav": path, "text": plain, "pause_before_ms": before, "pause_after_ms": after}):
                    try:
                        os.unlink(path)
                    except OSError:
                        pass
                    return  # the caller went away: stop making speech
            self.last = time.time()


def serve():
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)
    srv.listen(4)
    voice = Voice()

    def idle_watch():
        while True:
            time.sleep(30)
            if voice.engine is not None and time.time() - voice.last > IDLE and not voice.lock.locked():
                voice.unload()
                print("voiced: idle, graphics card memory freed", file=sys.stderr, flush=True)

    threading.Thread(target=idle_watch, daemon=True).start()

    def handle(conn):
        f = conn.makefile("rwb")

        def send(obj):
            try:
                f.write((json.dumps(obj) + "\n").encode())
                f.flush()
                return True
            except OSError:
                return False

        try:
            line = f.readline()
            req = json.loads(line) if line else {}
            op = req.get("op")
            if op == "ping":
                send({"ok": True, "loaded": voice.engine is not None, "engine": "chatterbox"})
            elif op == "warm":
                send({"ok": True})
                threading.Thread(target=lambda: (voice.lock.acquire(), setattr(voice, "last", time.time()), voice.load(), voice.lock.release()), daemon=True).start()
            elif op == "unload":
                voice.unload()
                send({"ok": True})
            elif op == "speak":
                try:
                    voice.speak(str(req.get("text", "")), send)
                    send({"done": True})
                except Exception as e:  # noqa: BLE001
                    send({"error": str(e)[:200]})
        except (ValueError, OSError):
            pass
        finally:
            try:
                conn.close()
            except OSError:
                pass

    while True:
        conn, _ = srv.accept()
        threading.Thread(target=handle, args=(conn,), daemon=True).start()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    serve()
