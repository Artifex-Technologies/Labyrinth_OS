#!/usr/bin/env bash
# labyrinth-agent-setup [--owner USER] [--agent NAME] [--owner-login]: give the engineering agent (Claude) its own account, so
# what it does can be told apart from what the owner does, and limit what it may do as root. Run as root; idempotent. Undo the
# rules with --remove.
#
#   * the account (default `claude-agent`): a normal user whose password is locked, so nobody can log in as it with one;
#   * /etc/sudoers.d/50-labyrinth-agent: the agent may run ONE program as root without a password, labyrinth-agent, which
#     checks every action (installing the ecosystem's own packages, official-repository packages but no remote-access tools,
#     the ecosystem's own services, reading the journal, Heimdall maintenance windows, Limbo test runs, the rollback tool's
#     read-only commands, user-side desktop files). Anything broader (any pacman command, systemd-run, install anywhere, the
#     firewall) needs the owner to open a window with his password: `sudo labyrinth-agent-window HOURS`.
#     Installing a package the agent built still runs that package's code as root: the checks make root deliberate and
#     visible, not impossible. Every use is logged by sudo under the agent's name and recorded for replay (`sudoreplay`,
#     /var/log/sudo-io/AGENT), and labyrinth-agent writes each action to the journal for Heimdall;
#   * --owner-login: the owner's session reaches the agent account only after the owner has typed his password (once per
#     boot, kept 12 hours), so a program running as the owner cannot use the agent's rights while he has not;
#   * Heimdall is told who may open a maintenance window (maintenance_actors in /etc/heimdall/config.json);
#   * /usr/local/bin/claude-sudo CMD...: shorthand for `sudo -u AGENT sudo -n CMD...` (privileged, but as the agent).
# The agent is never exempt from Heimdall's content checks (prompt injection, credentials, hidden characters).
set -euo pipefail
OWNER=${SUDO_USER:-}; AGENT=claude-agent; REMOVE=0; OWNER_LOGIN=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --owner) OWNER=$2; shift 2 ;;
    --agent) AGENT=$2; shift 2 ;;
    --remove) REMOVE=1; shift ;;
    --owner-login) OWNER_LOGIN=1; shift ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
[[ $EUID -eq 0 ]] || { echo "run as root: sudo labyrinth-agent-setup" >&2; exit 1; }
[[ $AGENT =~ ^[a-z][a-z0-9-]{1,30}$ ]] || { echo "bad account name" >&2; exit 2; }
SUDOERS=/etc/sudoers.d/50-labyrinth-agent

if [[ $REMOVE -eq 1 ]]; then
  rm -f "$SUDOERS" /usr/local/bin/claude-sudo
  echo "removed the sudo rules; the account $AGENT and its home are left (userdel -r $AGENT deletes them)"
  exit 0
fi
[[ -n $OWNER ]] || { echo "say who the owner is: --owner USER" >&2; exit 2; }
id "$OWNER" >/dev/null 2>&1 || { echo "no such user: $OWNER" >&2; exit 2; }

if ! id "$AGENT" >/dev/null 2>&1; then
  useradd -m -s /bin/bash -c "Claude, the engineering agent (audited account)" "$AGENT"
fi
passwd -l "$AGENT" >/dev/null
install -d -m750 -o root -g root /var/log/sudo-io

for f in labyrinth-agent labyrinth-agent-window; do
  [[ -x /usr/local/sbin/$f ]] || { echo "/usr/local/sbin/$f is missing (it comes with the Labyrinth profile)" >&2; exit 1; }
done
if [[ $OWNER_LOGIN -eq 1 ]]; then
  OWNER_RULE="Defaults:$OWNER timestamp_type=global, timestamp_timeout=720
$OWNER ALL=($AGENT) ALL"
else
  OWNER_RULE="$OWNER ALL=($AGENT) NOPASSWD: ALL"
fi
tmp=$(mktemp)
cat >"$tmp" <<RULES
# Written by labyrinth-agent-setup. See that script for what this means.
Defaults:$AGENT !requiretty, log_input, log_output, iolog_dir=/var/log/sudo-io/$AGENT
$AGENT ALL=(root) NOPASSWD: /usr/local/sbin/labyrinth-agent, /usr/local/sbin/labyrinth-agent *
$OWNER_RULE
RULES
visudo -cf "$tmp" >/dev/null || { echo "the sudoers file did not validate; nothing changed" >&2; rm -f "$tmp"; exit 1; }
install -m440 -o root -g root "$tmp" "$SUDOERS"; rm -f "$tmp"

cat >/usr/local/bin/claude-sudo <<SH
#!/bin/sh
# claude-sudo CMD...: run CMD as root through the audited agent account ($AGENT).
exec sudo -n -u $AGENT sudo -n "\$@"
SH
chmod 755 /usr/local/bin/claude-sudo

# Heimdall: who may open a maintenance window
if [[ -f /etc/heimdall/config.json ]] && command -v python3 >/dev/null; then
  OWNER=$OWNER AGENT=$AGENT python3 - <<'PY'
import json, os
p = "/etc/heimdall/config.json"
c = json.load(open(p))
a = c.get("maintenance_actors", [])
for u in (os.environ["OWNER"], os.environ["AGENT"]):
    if u not in a:
        a.append(u)
c["maintenance_actors"] = a
json.dump(c, open(p, "w"), indent=2)
PY
  systemctl try-restart heimdall.service >/dev/null 2>&1 || true
fi
echo "done: account $AGENT (locked password), rules in $SUDOERS, helper claude-sudo, I/O logs in /var/log/sudo-io/$AGENT"
