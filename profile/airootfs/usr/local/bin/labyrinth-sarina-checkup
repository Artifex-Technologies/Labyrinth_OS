#!/usr/bin/env python3
"""labyrinth-sarina-checkup: once a day, a quiet look at how the computer is doing. Only the owner switches it on (Settings > Sarina's agents,
or: systemctl --user enable --now labyrinth-sarina-checkup.timer); Sarina cannot schedule anything herself.

What it does, all read-only: new crashes since the last check-up, failed services, nearly full disks, kernel errors. If everything is fine it
writes one line in her vault (Daily/YYYY-MM-DD.md) and says nothing. If something is wrong it asks Sarina, with her read-only spoken-question
tools, to explain it in a few sentences, notes that, and shows one notification. It never changes anything, and it waits for another day if
the graphics card is busy (a game), so it never takes the GPU while you play.

Security: when Heimdall reports something new (a package or kernel with known holes, a setting that could be safer; its /v1/audit), Sarina's
security-advisor skill judges it and proposes the fixes in order, with the exact commands. The proposal goes in the vault (Security/YYYY-MM-DD.md)
with one notification; you run the commands, she changes nothing. Files Heimdall holds in quarantine are part of that review: she says
for each what it most likely is and whether to release it or confirm it as malware.

  labyrinth-sarina-checkup --held   (every 10 minutes, labyrinth-sarina-held.timer; no model, a moment) a program that was there
      before and stopped working because Heimdall holds its file (a failed service that runs it, a crash of it): Heimdall is asked to
      release it. Heimdall does so only if it can prove the file was there before (its inventory, or your signature), and tells you.
"""
import datetime
import json
import os
import re
import subprocess
import sys

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "sarina", "checkup.json")


def run(argv, timeout=30):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def env_file():
    out = {}
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "labyrinth", "sarina.env")) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def gpu_busy():
    out = run(["nvidia-smi", "--query-gpu=utilization.gpu", "--format=csv,noheader,nounits"], 10).strip().splitlines()
    try:
        return int(out[0]) >= 40
    except (IndexError, ValueError):
        return False


def findings(last):
    found = []
    # crashes of this user's programs since the last check-up
    since = last or (datetime.datetime.now() - datetime.timedelta(days=1)).strftime("%Y-%m-%d %H:%M:%S")
    out = run(["coredumpctl", "list", "--no-pager", "--no-legend", "--since=" + since])
    uid = str(os.getuid())
    progs = {}
    for line in out.splitlines():
        f = line.split()
        if len(f) >= 10 and f[5] == uid:
            progs[os.path.basename(f[9])] = progs.get(os.path.basename(f[9]), 0) + 1
    for p, n in sorted(progs.items()):
        found.append("%s crashed %d time%s" % (p, n, "" if n == 1 else "s"))
    for scope in ([], ["--user"]):
        out = run(["systemctl"] + scope + ["--failed", "--no-legend", "--plain", "--no-pager"])
        for line in out.splitlines():
            unit = line.split()[0] if line.split() else ""
            if unit and not unit.startswith("run-"):
                found.append("service %s failed%s" % (unit, " (your session)" if scope else ""))
    out = run(["df", "--output=pcent,target", "-x", "tmpfs", "-x", "devtmpfs", "-x", "efivarfs"])
    for line in out.splitlines()[1:]:
        m = re.match(r"\s*(\d+)%\s+(\S+)", line)
        if m and int(m.group(1)) >= 90:
            found.append("%s is %s%% full" % (m.group(2), m.group(1)))
    for unit, diff, want in stale_overrides():
        d = os.path.join(os.path.dirname(STATE), "overrides")
        os.makedirs(d, exist_ok=True)
        cand = os.path.join(d, unit)
        with open(cand, "w", encoding="utf-8") as f:
            f.write("# Labyrinth's copy of %s, rebuilt from the updated package with Labyrinth's change applied again.\n%s" % (unit, want))
        found.append("the package's %s changed in an update and Labyrinth's copy of it is now missing that change. Difference (lines with + are "
                     "what the update brought):\n%s\nA rebuilt copy is ready; to use it: sudo install -m644 %s %s && sudo systemctl daemon-reload"
                     % (unit, diff.strip(), cand, os.path.join(UNIT_ETC, unit)))
    out = run(["journalctl", "-k", "-p", "err", "--since=" + since, "--no-pager", "-q", "-o", "cat"])
    n = len([l for l in out.splitlines() if l.strip()])
    if n >= 5:
        found.append("%d kernel errors" % n)
    return found


# Labyrinth's override copies of packaged units: how each was made from the package's file. When the package's file changes in an update, the
# copy is rebuilt the same way from the new file; if that differs from the copy in /etc, the update brought something the copy is missing.
# (None at the moment: Labyrinth's Ollama settings are an add-on drop-in now, which follows updates by itself. Kept for the next one that
# cannot be a drop-in.)
OVERRIDES = {}
UNIT_PKG = os.environ.get("LABYRINTH_UNIT_PKG_DIR", "/usr/lib/systemd/system")
UNIT_ETC = os.environ.get("LABYRINTH_UNIT_ETC_DIR", "/etc/systemd/system")


def rebuild(pkg_text, rules):
    lines = pkg_text.splitlines()
    for rule in rules:
        if rule[0] == "drop":
            lines = [l for l in lines if l.strip() != rule[1]]
        elif rule[0] == "swap":
            lines = [rule[2] if l.strip() == rule[1] else l for l in lines]
    return "\n".join(lines).strip() + "\n"


def body(text):
    return "\n".join(l for l in text.splitlines() if not l.startswith("#")).strip() + "\n"


def stale_overrides():
    """Overrides whose package file changed since they were made: (unit, a unified diff, the rebuilt copy)."""
    import difflib
    out = []
    for unit, rules in OVERRIDES.items():
        try:
            pkg = open(os.path.join(UNIT_PKG, unit), encoding="utf-8").read()
            ours = open(os.path.join(UNIT_ETC, unit), encoding="utf-8").read()
        except OSError:
            continue
        want = rebuild(body(pkg), rules)
        if want != body(ours):
            diff = "".join(difflib.unified_diff(body(ours).splitlines(True), want.splitlines(True), "Labyrinth's copy now", "rebuilt from the updated package"))
            out.append((unit, diff, want))
    return out


def heimdall_audit():
    import urllib.request
    try:
        with urllib.request.urlopen("http://127.0.0.1:8930/v1/audit", timeout=15) as r:
            return json.loads(r.read(2 << 20))
    except (OSError, ValueError):
        return None


def heimdall_held():
    import urllib.request
    try:
        with urllib.request.urlopen("http://127.0.0.1:8930/v1/quarantine", timeout=15) as r:
            return [e for e in json.loads(r.read(4 << 20)) if e.get("status") == "held"]
    except (OSError, ValueError, AttributeError):
        return []


REQUESTS = os.environ.get("LABYRINTH_HEIMDALL_REQUESTS", "/var/lib/heimdall-requests")


def broken_programs():
    """What stopped working: (the program or command line, a description) for failed services and recent crashes."""
    out = []
    for scope in ([], ["--user"]):
        for line in run(["systemctl"] + scope + ["--failed", "--no-legend", "--plain", "--no-pager"]).splitlines():
            unit = line.split()[0] if line.split() else ""
            if not unit:
                continue
            execs = run(["systemctl"] + scope + ["show", "-p", "ExecStart", "-p", "ExecStartPre", "--value", unit])
            out.append((execs, "the service %s failed%s" % (unit, " (your session)" if scope else "")))
    since = (datetime.datetime.now() - datetime.timedelta(hours=2)).strftime("%Y-%m-%d %H:%M:%S")
    uid = str(os.getuid())
    for line in run(["coredumpctl", "list", "--no-pager", "--no-legend", "--since=" + since]).splitlines():
        f = line.split()
        if len(f) >= 10 and f[5] == uid:
            out.append((f[9], "%s crashed" % os.path.basename(f[9])))
    return out


def held_check(held=None, broken=None):
    """Ask Heimdall to release held files that a program which was there before needs (Heimdall checks the proof). Returns what was asked."""
    held = heimdall_held() if held is None else held
    if not held:
        return []
    broken = broken_programs() if broken is None else broken
    asked = []
    for e in held:
        paths = [e.get("original", "")] + list(e.get("copies") or [])
        for cmdline, what in broken:
            hit = next((p for p in paths if p and (p in cmdline.split() or ("path=" + p + " ") in cmdline or cmdline == p)), None)
            if not hit:
                continue
            req = {"release_if_proven": e["sha256"], "why": "%s, and it runs %s, which Heimdall holds" % (what, hit)}
            try:
                name = os.path.join(REQUESTS, "sarina-%s-%d.json" % (e["sha256"][:12], os.getpid()))
                with open(name, "x") as f:
                    json.dump(req, f)
                asked.append("%s: %s" % (hit, what))
            except OSError:
                pass
            break
    return asked


def security_keys(audit):
    """What Heimdall finds open, one short key per finding (a kernel's key changes when its count of holes does)."""
    keys = {}
    for p in audit.get("packages") or []:
        keys["pkg|%s|%s|%s" % (p.get("package"), p.get("installed"), p.get("advisory"))] = "%s %s: %s vulnerability" % (p.get("package"), p.get("installed"), (p.get("severity") or "").lower())
    for k in audit.get("kernels") or []:
        if k.get("count"):
            keys["kernel|%s|%s" % (k.get("kernel"), k.get("count"))] = "kernel %s%s: %s known holes" % (k.get("kernel"), " (running)" if k.get("running") else "", k.get("count"))
    for g in audit.get("hardening") or []:
        keys["hard|%s|%s" % (g.get("id"), g.get("now"))] = g.get("now", "")
    for e in audit.get("held") or []:
        keys["held|%s" % e.get("sha256")] = "Heimdall holds %s in quarantine (%s)" % (e.get("original"), e.get("reason"))
    return keys


def security_review(env, vault, new):
    """Sarina's proposal for Heimdall's new findings: saved, and one notification."""
    env = dict(env, SARINA_SYSTEM="on")
    try:
        r = subprocess.run(["sarina", "skill", "run", "security-advisor", "new since the last check-up: " + "; ".join(new)],
                           capture_output=True, text=True, timeout=600, env=env, cwd=os.path.expanduser("~"))
        answer = r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        answer = ""
    if not answer:
        return "Heimdall found %d new thing(s) (%s); Sarina could not review them" % (len(new), "; ".join(new))
    today = datetime.date.today().isoformat()
    if vault and os.path.isdir(vault):
        d = os.path.join(vault, "Security")
        os.makedirs(d, exist_ok=True)
        path = os.path.join(d, today + ".md")
        front = "---\ncreated: %s\nsource: labyrinth-sarina-checkup (security-advisor)\ntags: [security]\n---\n\n" % today
    else:
        d = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "sarina", "security-reviews")
        os.makedirs(d, exist_ok=True)
        path, front = os.path.join(d, today + ".md"), ""
    with open(path, "a", encoding="utf-8") as f:
        f.write(front if os.path.getsize(path) == 0 else "\n\n")
        f.write("# Security review %s\n\nHeimdall's new findings: %s\n\n%s\n" % (datetime.datetime.now().strftime("%Y-%m-%d %H:%M"), "; ".join(new), answer))
    summary = answer.split("\n", 1)[0].removeprefix("Summary:").strip()
    subprocess.run(["notify-send", "-a", "Sarina", "-i", "security-high", "Security review", (summary + "\n\nHer proposal: " + path)[:800]], check=False)
    return "security review of %d new finding(s) saved in %s" % (len(new), path)


def note(vault, text):
    """One check-up line in the day's note. The note also holds the status Sarina's `daily-report` keeps (its "## Status" and "## Numbers"
    sections, see docs/VAULT.md in her repository): the check-up's lines stay above those, so a line is inserted there, never appended
    after them."""
    if not vault or not os.path.isdir(vault):
        return
    d = os.path.join(vault, "Daily")
    os.makedirs(d, exist_ok=True)
    today = datetime.date.today().isoformat()
    p = os.path.join(d, today + ".md")
    line = "- %s check-up: %s\n" % (datetime.datetime.now().strftime("%H:%M"), text)
    try:
        with open(p, encoding="utf-8") as f:
            old = f.read()
    except OSError:
        old = "---\ncreated: %s\nsource: labyrinth-sarina-checkup\ntags: [daily]\n---\n\n# %s\n\n" % (today, today)
    cut = len(old)
    for marker in ("\n## Status (", "\n## Numbers"):
        i = old.find(marker)
        if i >= 0:
            cut = min(cut, i + 1)
    head = old[:cut]
    if not head.endswith("\n"):
        head += "\n"
    with open(p, "w", encoding="utf-8") as f:
        f.write(head + line + old[cut:])


def refresh_status(vault):
    """The day's status section (load, memory, disks, failed services, crashes, Heimdall's headline) and its numbers line, kept by Sarina
    herself: a status question reads it instead of probing again, and `sarina trends` reads the numbers day by day."""
    if not vault or not os.path.isdir(vault):
        return
    try:
        subprocess.run(["sarina", "daily-report", "--path", vault], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        pass


def main():
    if "--held" in sys.argv[1:]:
        for a in held_check():
            print("asked Heimdall to release (if it can prove it was there before): " + a)
        return 0
    if gpu_busy():
        print("the graphics card is busy; trying again later")
        return 75  # systemd retries per the unit's Restart
    st = {}
    try:
        with open(STATE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        pass
    env = dict(os.environ)
    for k, v in env_file().items():
        env.setdefault(k, v)
    vault = env.get("SARINA_VAULT", "")
    found = findings(st.get("last", ""))
    if not found:
        note(vault, "all fine")
    else:
        q = ("Daily check-up. The computer reported: %s. Look into these with your tools (crash_detail for a crash, system_status for the rest) "
             "and tell me in at most three plain sentences what matters and what I could do; do not change anything." % "; ".join(found))
        try:
            with open("/usr/share/labyrinth/sarina-voice-rules.txt", encoding="utf-8") as f:
                env["LABYRINTH_VOICE_RULES"] = f.read().strip()
        except OSError:
            pass
        try:
            r = subprocess.run(["labyrinth-ask-sarina", "--voice", "--cwd", os.path.expanduser("~"), q], capture_output=True, text=True, timeout=300, env=env)
            answer = r.stdout.strip() or "(no answer)"
        except (OSError, subprocess.TimeoutExpired):
            answer = "(Sarina could not look at it)"
        note(vault, "; ".join(found) + ". " + answer.replace("\n", " "))
        subprocess.run(["notify-send", "-a", "Sarina", "-i", "dialog-information", "Daily check-up", ("; ".join(found) + "\n\n" + answer)[:800]], check=False)
    audit = heimdall_audit()
    if audit is not None:
        audit["held"] = heimdall_held()
        keys = security_keys(audit)
        seen = set(st.get("security_seen") or [])
        new = [keys[k] for k in sorted(keys) if k not in seen]
        if new:
            note(vault, security_review(env, vault, new))
        st["security_seen"] = sorted(keys)  # only what is still open: a hole that comes back is new again
    refresh_status(vault)
    st["last"] = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(st, f)
    print("; ".join(found) or "all fine")
    return 0


if __name__ == "__main__":
    sys.exit(main())
