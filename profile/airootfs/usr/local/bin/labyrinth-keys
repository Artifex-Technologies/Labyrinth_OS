#!/usr/bin/env python3
"""Keybinding cheat sheet (Omacosy's SUPER+K idea). Lists every Hyprland binding that
has a description, in a fuzzel menu. `--print` writes the list to stdout instead.

Reads `hyprctl binds -j`. Set LABYRINTH_HYPRCTL to override hyprctl (tests).
"""
import json
import os
import subprocess
import sys

MODS = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]


def combo(bind):
    mask = int(bind.get("modmask", 0))
    parts = [name for bit, name in MODS if mask & bit]
    key = bind.get("key") or f"code:{bind.get('keycode', '?')}"
    return " + ".join(parts + [str(key).upper() if len(str(key)) == 1 else str(key)])


def lines(binds):
    """One "COMBO   Description" line per described binding, alphabetical by description."""
    seen, rows = set(), []
    for b in binds:
        if not b.get("has_description") or not b.get("description"):
            continue
        row = (b["description"], combo(b))
        if row not in seen:
            seen.add(row)
            rows.append(row)
    rows.sort(key=lambda r: (r[0].lower(), r[1]))
    return [f"{c:<34} {d}" for d, c in rows]


def main(argv):
    cmd = os.environ.get("LABYRINTH_HYPRCTL", "hyprctl").split()
    r = subprocess.run(cmd + ["binds", "-j"], capture_output=True, text=True, timeout=3)
    if r.returncode != 0:
        print("could not read bindings from hyprctl", file=sys.stderr)
        return 1
    text = "\n".join(lines(json.loads(r.stdout)))
    if "--print" in argv:
        print(text)
        return 0
    menu = os.environ.get("LABYRINTH_MENU", "fuzzel --dmenu --width 60").split()
    subprocess.run(menu, input=text, text=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
