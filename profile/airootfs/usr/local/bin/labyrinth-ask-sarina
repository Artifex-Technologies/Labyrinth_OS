#!/usr/bin/env python3
"""labyrinth-ask-sarina [--cwd DIR] [--write] [--shell] QUESTION...

Ask Sarina (the local agent) one thing, from a script or from Claude Code, and print her answer. She runs as you, in DIR
(default: the current folder), and can only read unless you pass --write or --shell for that one question.

Her sessions go to /var/lib/sarina/sessions, the folder Heimdall watches, so what she does here is watched like everything
else. The model and server come from ~/.config/labyrinth/sarina.env (KEY=value lines), then the environment.
"""
import argparse
import os
import subprocess
import sys

SESSIONS = os.environ.get("SARINA_SESSION_DIR", "/var/lib/sarina/sessions")


def env_file():
    out = {}
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "labyrinth", "sarina.env")) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


# What a spoken question may use: reading, and her vault (the only place it may write, through the vault's own safety gate).
VOICE_TOOLS = "read_file,list_dir,glob_search,grep_search,vault_search,vault_read,vault_write,system_status"


def persona_text():
    """How she talks, from Persona.md in her vault (the owner's note: she can read it, never change it). Front matter dropped, 2500 characters at most."""
    vault = os.environ.get("SARINA_VAULT") or env_file().get("SARINA_VAULT", "")
    try:
        with open(os.path.join(vault, "Persona.md"), encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return ""
    if text.startswith("---\n") and "\n---" in text[4:]:
        text = text[text.index("\n---", 4) + 4:]
    text = text.strip()[:2500]
    return ("How you talk (your Persona note):\n" + text) if text else ""


def command(question, cwd, write=False, shell=False, voice=False, resume=None, rules=""):
    # `sarina resume ID "question"` continues a saved session (a conversation's later turns); otherwise a new one
    cmd = ["sarina", "resume", resume, question] if resume else ["sarina", "chat", question]
    cmd += ["--cwd", os.path.abspath(cwd), "--session-dir", SESSIONS]
    if voice:
        # a misheard word must never become a write anywhere else: only these tools exist for the question
        cmd += ["--tools", VOICE_TOOLS, "--allow-write"]
        # the persona and the rules for spoken answers live in the system prompt, once, not repeated in every turn of the conversation
        persona = "\n\n".join(x for x in (persona_text(), rules) if x)
        if persona:
            cmd += ["--append-system-prompt", persona]
    elif write:
        cmd.append("--allow-write")
    if shell:
        cmd.append("--allow-shell")
    return cmd


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--cwd", default=os.getcwd())
    ap.add_argument("--write", action="store_true", help="let her write files for this question")
    ap.add_argument("--shell", action="store_true", help="let her run shell commands for this question")
    ap.add_argument("--conversation", default="", help="a conversation id: its turns share one session (kept in $XDG_RUNTIME_DIR/labyrinth-sarina)")
    ap.add_argument("--voice", action="store_true", help="a spoken question: reading tools and her vault only (the vault is the one place it may write)")
    ap.add_argument("question", nargs="+")
    a = ap.parse_args(argv[1:])
    env = dict(os.environ)
    for k, v in env_file().items():
        env.setdefault(k, v)
    state, resume, before = None, None, set()
    if a.conversation and all(c.isalnum() or c in "-_" for c in a.conversation):
        run = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "labyrinth-sarina")
        os.makedirs(run, mode=0o700, exist_ok=True)
        state = os.path.join(run, "conv-%s.session" % a.conversation)
        try:
            with open(state) as f:
                sid = f.read().strip()
            if sid and all(c.isalnum() for c in sid):
                resume = sid
        except OSError:
            pass
        if not resume:
            try:
                before = set(os.listdir(SESSIONS))
            except OSError:
                before = set()
    rc = subprocess.run(command(" ".join(a.question), a.cwd, a.write, a.shell, a.voice, resume, env.get("LABYRINTH_VOICE_RULES", "")), env=env).returncode
    if state and not resume:
        try:  # the session this first turn made: the later turns resume it
            new = [n for n in os.listdir(SESSIONS) if n.endswith(".json") and n not in before]
            if len(new) == 1:
                with open(state, "w") as f:
                    f.write(new[0][:-5])
        except OSError:
            pass
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv))
