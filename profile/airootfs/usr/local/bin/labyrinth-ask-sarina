#!/usr/bin/env python3
"""labyrinth-ask-sarina [--cwd DIR] [--write] [--shell] QUESTION...

Ask Sarina (the local agent) one thing, from a script or from Claude Code, and print her answer. She runs as you, in DIR
(default: the current folder), and can only read unless you pass --write or --shell for that one question.

Her sessions go to /var/lib/sarina/sessions, the folder Heimdall watches, so what she does here is watched like everything
else. The model and server come from ~/.config/labyrinth/sarina.env (KEY=value lines), then the environment.
"""
import argparse
import datetime
import glob
import os
import re
import subprocess
import sys

SESSIONS = os.environ.get("SARINA_SESSION_DIR", "/var/lib/sarina/sessions")


def env_file():
    out = {}
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "labyrinth", "sarina.env")) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


# What a spoken question may use: reading, and her vault (the only place it may write, through the vault's own safety gate).
VOICE_TOOLS = "read_file,list_dir,glob_search,grep_search,vault_search,vault_read,vault_write,system_status,crash_detail,stage_binary,reverse_engineer"


def persona_text():
    """How she talks, from Persona.md in her vault (the owner's note: she can read it, never change it). Front matter dropped, 2500 characters at most."""
    vault = os.environ.get("SARINA_VAULT") or env_file().get("SARINA_VAULT", "")
    try:
        with open(os.path.join(vault, "Persona.md"), encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return ""
    if text.startswith("---\n") and "\n---" in text[4:]:
        text = text[text.index("\n---", 4) + 4:]
    text = text.strip()[:2500]
    return ("How you talk (your Persona note):\n" + text) if text else ""


# A question about how the computer is doing needs the same look every time, so it is made before the model starts, not by a round trip through
# the model's own tool call (that costs a whole extra turn, a few seconds). The model still has the tool for anything it wants to look at further.
ROUTES = [
    (r"\b(crash|crashed|crashes|core dump|segfault|segmentation|aborted|froze|freez|hung|hang)\w*", "crashes"),
    (r"\b(slow|lag|laggy|sluggish|performance|cpu|processor|memory|ram|swap|busy|fan|hot|temperature|heat|load)\b", "performance"),
    (r"\b(internet|wi-?fi|network|connection|connect|online|offline|dns|ethernet)\b", "network"),
    (r"\b(disk|storage|space|full)\b|\b(?<!proton )drive\b", "disk"),
    (r"\b(boot|startup|start up|takes? long to (start|boot))\b", "boot"),
    (r"\b(sound|audio|speaker|microphone|mic|volume)\b", "audio"),
    (r"\b(error|errors|log|logs|failed|failing|broke|broken|problem|wrong|issue)\b", "services"),
]


def route(question, env):
    """What the question needs looked up, decided by meaning (`sarina route`: the small embedding model compares it with example questions),
    or None when that is not available (then the keyword rules decide)."""
    try:
        r = subprocess.run(["sarina", "route", question], capture_output=True, text=True, timeout=8, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return [t for t in r.stdout.strip().split(",") if t]


def keyword_topics(question):
    topics = []
    for rx, topic in ROUTES:
        if re.search(rx, question, re.I) and topic not in topics:
            topics.append(topic)
    return topics


def recent_crash(question):
    """The program of the user's own crash to look at: the one the question names, else the newest of the last day."""
    try:
        out = subprocess.run(["coredumpctl", "list", "--no-pager", "--no-legend", "--reverse", "--since=-1d"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""
    uid, mine = str(os.getuid()), []
    for line in out.splitlines():
        f = line.split()
        if len(f) >= 10 and f[5] == uid:
            mine.append(f[9])
    q = question.lower()
    for exe in mine:
        if os.path.basename(exe).lower() in q:
            return exe
    return mine[0] if mine else ""


def prefetch(question, topics):
    """What the computer reports about the given topics (at most two), as text to place before the question; empty when there are none."""
    topics = [t for t in topics if t not in ("guides", "chat")]
    out = []
    for t in topics[:2]:
        try:
            r = subprocess.run(["sarina", "system-status", t], capture_output=True, text=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            out.append("[%s]\n%s" % (t, r.stdout.strip()[:2500]))
    if "crashes" in topics:
        c = recent_crash(question)
        if c:
            try:
                r = subprocess.run(["sarina", "crash-detail", c], capture_output=True, text=True, timeout=30)
                if r.returncode == 0 and r.stdout.strip():
                    out.append("[latest crash of %s]\n%s" % (os.path.basename(c), r.stdout.strip()[:3500]))
            except (OSError, subprocess.TimeoutExpired):
                pass
    if not out:
        return ""
    return "What the computer reports right now (read-only, already looked up for you; call system_status for anything more):\n\n" + "\n\n".join(out) + "\n\nThe question: "


def flatten(text):
    """A spoken answer is plain sentences: markdown emphasis, code marks, headings and list markers are removed, and list items become sentences
    on one line (they are read aloud and shown on a small card)."""
    text = re.sub(r"\*\*|__|`", "", text)
    out = []
    for line in text.splitlines():
        t = line.strip()
        if not t:
            out.append("\n")
            continue
        t = re.sub(r"^#{1,6}\s*", "", t)
        m = re.match(r"^(?:[-*•]|\d{1,2}[.)])\s+(.*)$", t)
        if m:
            t = m.group(1).strip()
            if t and t[-1] not in ".!?:":
                t += "."
        out.append(t + " ")
    text = "".join(out)
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r" *\n *", "\n", text)
    return re.sub(r"\n{2,}", "\n\n", text).strip()


def shorten(text, limit=75):
    """A spoken answer longer than about 75 words is cut after the last whole sentence that fits (the card is small and it is read aloud);
    the first sentence always stays."""
    if len(text.split()) <= limit:
        return text
    sentences = re.split(r"(?<=[.!?])\s+", text)
    out, n = [], 0
    for s in sentences:
        w = len(s.split())
        if out and n + w > limit:
            break
        out.append(s)
        n += w
    return " ".join(out).strip()


def guides(question, vault):
    """Her guide notes about this desktop (Guides/ in the vault) that match the question, placed before it: a small model answers a "how do I"
    question from general Linux knowledge unless the right note is in front of it. At most two short notes."""
    if not vault or not os.path.isdir(os.path.join(vault, "Guides")):
        return ""
    try:
        r = subprocess.run(["sarina", "vault-search", "--path", vault, question], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    picked = []
    for line in r.stdout.splitlines():
        m = re.match(r"^(Guides/[^\s].*?\.md)\s{2}", line)
        if m and m.group(1) not in picked:
            picked.append(m.group(1))
        if len(picked) == 2:
            break
    parts = []
    for rel in picked:
        try:
            with open(os.path.join(vault, rel), encoding="utf-8") as f:
                text = f.read()
        except OSError:
            continue
        if text.startswith("---\n") and "\n---" in text[4:]:
            text = text[text.index("\n---", 4) + 4:]
        parts.append("[%s]\n%s" % (rel[:-3], text.strip()[:1800]))
    if not parts:
        return ""
    return "From your guides about this computer (use them when they answer the question; prefer them to general Linux advice):\n\n" + "\n\n".join(parts) + "\n\n"


# A spoken question can carry notes from the desktop before the words: "(Style hint ...)" from how it sounded, "(They laughed.)" when the recording
# had laughter in it. They are for her; the logs keep only what was said.
NOTE_RX = re.compile(r"^\s*\((?:Style hint|They laughed)[^)]*\)\s*")


def spoken(question):
    while NOTE_RX.match(question):
        question = NOTE_RX.sub("", question, count=1)
    return question.strip()


# Asking her to change something is about the computer even when it sounds like small talk to the router.
ACTION_RX = re.compile(r"(?i)\b(sudo|pacman|yay|systemctl|delete|remove|uninstall|install|update|upgrade|rename|kill|restart|reboot|shut ?down|format|wipe|empty the)\b")


def about_the_computer(topics, said=""):
    return any(t != "chat" for t in topics) or bool(ACTION_RX.search(said))


def daypart(now):
    h = now.hour
    return "late at night" if h < 5 else "morning" if h < 12 else "afternoon" if h < 17 else "evening" if h < 22 else "late evening"


SECRET_RX = re.compile(r"(?i)(password|passphrase|pass code|passcode|pin code|api key|token|secret|private key|credit card|\b[A-Za-z0-9+/_-]{32,}\b)")


def plain(t, n):
    return re.sub(r"[\x00-\x1f\x7f\u202a-\u202e\u2066-\u2069]", " ", t).strip()[:n]


def recall(question, vault, env):
    """Earlier moments that fit what was just said, from her talk log, jokes and inside jokes, found by meaning (vault-search): at most three lines."""
    try:
        r = subprocess.run(["sarina", "vault-search", "--path", vault, question], capture_output=True, text=True, timeout=10, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return []
    out, note = [], ""
    for line in r.stdout.splitlines():
        m = re.match(r"^(\S.*?\.md)\s{2}", line)
        if m:
            note = m.group(1)
            continue
        if note.startswith(("Talks/", "Jokes/", "Entities/Inside jokes")) and line.strip().startswith("- 20"):
            t = line.strip()[2:]
            # the same question asked before is not a memory: its old answer would only be said again
            m2 = re.search(r"\| they said: (.*?) \| I said:", t)
            q, said = words_of(question), words_of(m2.group(1)) if m2 else set()
            if q and len(q & said) >= 0.8 * len(q):
                continue
            if t not in out:
                out.append(t)
        if len(out) == 3:
            break
    return out


def tail_lines(path, n, prefix="- 20"):
    try:
        with open(path, encoding="utf-8") as f:
            return [l.strip()[2:] for l in f if l.startswith(prefix)][-n:]
    except OSError:
        return []


# Words that invite a callback: then her inside jokes are put in front of her (otherwise only the ones that match by meaning, so a small model
# does not force one into every answer).
CALLBACK_RX = re.compile(r"(?i)\b(remember|again|my name|funny|joke|laugh|that time|last time|the one about)\b")

# Asked for a joke. The jokes she told before are not put in front of her (a small model retells what it is shown); a repeat is caught after.
JOKE_ASK_RX = re.compile(r"(?i)\b(tell|another|got|know|have|one more)\b.*\b(joke|pun|riddle)s?\b|make me laugh|something funny|cheer me up")

# A closing offer of help is a help desk, not a friend; it is dropped from a chat answer that has something else in it.
OFFER_RX = re.compile(r"(?i)^(would you like|do you want|want me to|want help|need help|is there anything|let me know|if you (need|want)|i'?m (always )?here (if|for)|feel free|or is there anything|anything (else|i can))")


def drop_offers(text):
    # a closing aside in brackets is read aloud badly and is where a small model puts its stray jokes
    text = re.sub(r"(?<=[.!?])\s*\([^()]{8,}\)\s*$", "", text.strip()) or text
    sentences = re.split(r"(?<=[.!?])\s+", text.strip())
    offer = lambda x: OFFER_RX.search(x) or re.search(r"(?i)\b(anything (else|i can do|specific)|help (ease|you with|with (something|anything)))\b", x)
    while len(sentences) > 1 and offer(sentences[-1]):
        sentences.pop()
    kept = [x for x in sentences if not re.search(r"(?i)\b(help|assist)\b", x) or not offer(x)]
    return " ".join(kept or sentences)


def companion(question, env, now=None):
    """What a friend would already know when the talk is not about the computer: the time of day, how the owner has sounded lately (from the
    numbers sarina-tone keeps, never words), things they laughed at together, the jokes she told lately (so she does not repeat them), and earlier
    moments that fit what was said. Placed before the question; empty when there is nothing."""
    now = now or datetime.datetime.now()
    vault = env.get("SARINA_VAULT", "")
    parts = ["It is %s %s, %s." % (now.strftime("%A"), daypart(now), now.strftime("%H:%M"))]
    if env.get("LABYRINTH_TONE", "1") != "0":
        try:
            r = subprocess.run(["sarina-tone", "--pattern"], capture_output=True, text=True, timeout=5)
            if r.returncode == 0 and r.stdout.strip():
                parts.append("How they have sounded lately (from their voice only; do not bring it up unless the moment really fits, and if asked how you know, say so honestly): " + plain(r.stdout, 400))
        except (OSError, subprocess.TimeoutExpired):
            pass
    if vault and os.path.isdir(vault):
        inside = []
        if CALLBACK_RX.search(spoken(question)):
            inside = tail_lines(os.path.join(vault, "Entities", "Inside jokes.md"), 8)
            if inside:
                parts.append("Your inside jokes with them (they may be asking about one of these):\n" + "\n".join("- " + plain(x, 200) for x in inside))
        moments = [x for x in recall(spoken(question), vault, env) if x not in inside]
        if moments:
            parts.append("Earlier moments and inside jokes that may be about this (from your notes; use one only if it clearly is):\n" + "\n".join("- " + plain(x, 240) for x in moments))
    return "About this moment (for you, not to recite):\n" + "\n\n".join(parts) + "\n\nWhat they said: "


def told_jokes(vault):
    """What she said in her joke log of this month and the one before."""
    out = []
    for f in sorted(glob.glob(os.path.join(vault, "Jokes", "20*.md")))[-2:]:
        out += [x.split("| I said:", 1)[1].strip() for x in tail_lines(f, 400) if "| I said:" in x]
    return out


def words_of(t):
    return set(re.findall(r"[a-z']{3,}", t.lower()))


def a_repeat(answer, told):
    """The joke she already told that this answer repeats (most of its words again), or ""."""
    a = words_of(re.sub(r"\[(joking|unsure|urgent|gentle|serious)\]\s*", "", answer))
    if len(a) < 4:
        return ""
    for t in told:
        w = words_of(t)
        if w and len(a & w) >= 0.7 * min(len(a), len(w)):
            return t
    return ""


def log_talk(question, answer, env):
    """Talk that is not about the computer is kept in her vault (Talks/YYYY-MM.md), one line each, so she can remember it later the way a friend
    does and inside jokes can grow from it. Short acknowledgements and anything that looks like a secret are not kept. LABYRINTH_TALK_LOG=0 turns this off, and the joke and laugh notes too."""
    if env.get("LABYRINTH_TALK_LOG", "1") == "0":
        return
    vault = env.get("SARINA_VAULT", "")
    q = spoken(question)
    if not vault or not os.path.isdir(vault) or len(q.split()) < 3 or SECRET_RX.search(q) or SECRET_RX.search(answer):
        return
    now = datetime.datetime.now()
    try:
        d = os.path.join(vault, "Talks")
        os.makedirs(d, exist_ok=True)
        path = os.path.join(d, now.strftime("%Y-%m") + ".md")
        new = not os.path.exists(path)
        with open(path, "a", encoding="utf-8") as f:
            if new:
                f.write("# Talks " + now.strftime("%Y-%m") + "\n\nWhat we talked about when it was not about the computer. Each line: when, what the owner said, what I said.\n\n")
            f.write("- %s | they said: %s | I said: %s\n" % (now.strftime("%Y-%m-%d %H:%M"), plain(q, 240), plain(re.sub(r"\[(joking|unsure|urgent|gentle|serious)\]\s*", "", answer), 240)))
    except OSError:
        pass


def note_laugh(prev, env):
    """They laughed at what she said just before: that line goes into Entities/Inside jokes (date, what she said, what it answered), so it can
    become a callback. Done here, not left to the model. prev is (question, answer) of the turn before."""
    vault = env.get("SARINA_VAULT", "")
    if env.get("LABYRINTH_TALK_LOG", "1") == "0" or not prev or not vault or not os.path.isdir(vault):
        return
    q, ans = prev
    ans = re.sub(r"\[(joking|unsure|urgent|gentle|serious)\]\s*", "", ans)
    if not ans.strip() or SECRET_RX.search(ans) or SECRET_RX.search(q):
        return
    path = os.path.join(vault, "Entities", "Inside jokes.md")
    line = "- %s: they laughed when I said \"%s\" (to: %s)\n" % (datetime.date.today().isoformat(), plain(ans, 200), plain(q, 120))
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if not os.path.exists(path):
            with open(path, "w", encoding="utf-8") as f:
                f.write("---\ncreated: %s\nsource: sarina\n---\n\n# Inside jokes\n\nThings that made the owner laugh, so she can call back to them. One line each, with the date.\n\n" % datetime.date.today().isoformat())
        with open(path, encoding="utf-8") as f:
            if plain(ans, 200) in f.read():
                return
        with open(path, "a", encoding="utf-8") as f:
            f.write(line)
    except OSError:
        pass


HOWTO_RX = re.compile(r"(?i)\b(how (do|can) i|where (is|do|can)|setting|shortcut|install|sign in|open)\b")
LAUGH_RX = re.compile(r"\(They laughed\.\)|\b(ha(ha)+|lol|lmao|that'?s (so )?funny|hilarious)\b", re.I)


def log_joke(question, answer, env):
    """When she told a joke, keep what it was said in answer to, in her vault (Jokes/YYYY-MM.md), so that she can say later why she said it.
    Done here, not left to the model: a small model forgets or writes the call as text. Plain text only, short, never fails the answer."""
    question = spoken(question)
    if env.get("LABYRINTH_TALK_LOG", "1") == "0":
        return
    if "[joking]" not in answer and not re.search(r"\b(joke|funny|pun|humou?r)\b", question, re.I):
        return
    vault = env.get("SARINA_VAULT", "")
    if not vault or not os.path.isdir(vault):
        return
    clean = lambda t, n: re.sub(r"[\x00-\x1f\x7f\u202a-\u202e\u2066-\u2069]", " ", t).strip()[:n]
    now = datetime.datetime.now()
    joke = clean(re.sub(r"\[(joking|unsure|urgent|gentle|serious)\]\s*", "", answer), 300)
    try:
        d = os.path.join(vault, "Jokes")
        os.makedirs(d, exist_ok=True)
        path = os.path.join(d, now.strftime("%Y-%m") + ".md")
        new = not os.path.exists(path)
        with open(path, "a", encoding="utf-8") as f:
            if new:
                f.write("# Jokes " + now.strftime("%Y-%m") + "\n\nEach line: when, what the owner said, what I said. I chose a joke because of what was said just before it.\n\n")
            f.write("- %s | they said: %s | I said: %s\n" % (now.strftime("%Y-%m-%d %H:%M"), clean(question, 200), joke))
    except OSError:
        pass


def new_session(before, state):
    """The id of the session a first turn of a conversation made (the one new file in the sessions folder), or None."""
    if not state:
        return None
    try:
        new = [n for n in os.listdir(SESSIONS) if n.endswith(".json") and n not in before]
    except OSError:
        return None
    return new[0][:-5] if len(new) == 1 else None


def last_turn(state):
    """The question and answer of this conversation's turn before (kept next to its session id, in the private runtime folder)."""
    try:
        with open(state + ".last", encoding="utf-8") as f:
            q, _, ans = f.read().partition("\n")
        return (q, ans) if ans else None
    except OSError:
        return None


def save_turn(state, question, answer):
    try:
        fd = os.open(state + ".last", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(question.replace("\n", " ") + "\n" + answer)
    except OSError:
        pass


def command(question, cwd, write=False, shell=False, voice=False, resume=None, rules=""):
    # `sarina resume ID "question"` continues a saved session (a conversation's later turns); otherwise a new one
    cmd = ["sarina", "resume", resume, question] if resume else ["sarina", "chat", question]
    cmd += ["--cwd", os.path.abspath(cwd), "--session-dir", SESSIONS]
    if voice:
        # a misheard word must never become a write anywhere else: only these tools exist for the question
        cmd += ["--tools", VOICE_TOOLS, "--allow-write"]
        # the persona and the rules for spoken answers live in the system prompt, once, not repeated in every turn of the conversation
        persona = "\n\n".join(x for x in (persona_text(), rules) if x)
        if persona:
            cmd += ["--append-system-prompt", persona]
    elif write:
        cmd.append("--allow-write")
    if shell:
        cmd.append("--allow-shell")
    return cmd


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--cwd", default=os.getcwd())
    ap.add_argument("--write", action="store_true", help="let her write files for this question")
    ap.add_argument("--shell", action="store_true", help="let her run shell commands for this question")
    ap.add_argument("--conversation", default="", help="a conversation id: its turns share one session (kept in $XDG_RUNTIME_DIR/labyrinth-sarina)")
    ap.add_argument("--voice", action="store_true", help="a spoken question: reading tools and her vault only (the vault is the one place it may write)")
    ap.add_argument("question", nargs="+")
    a = ap.parse_args(argv[1:])
    env = dict(os.environ)
    for k, v in env_file().items():
        env.setdefault(k, v)
    # Qwen3-style thinking models loop at temperature 0; one reply is capped so a runaway ends instead of timing out
    env.setdefault("SARINA_TEMPERATURE", "0.6")
    env.setdefault("SARINA_REQUEST_MAX_TOKENS", "6000")
    # her notes are also found by meaning (needs the small nomic-embed-text model in Ollama; without it, keywords only)
    env.setdefault("SARINA_SEMANTIC", "on")
    # browser profiles, keyrings and key folders are never hers to read (the owner adds personal folders in sarina.env)
    env.setdefault("SARINA_PRIVATE_DIRS", "~/.mozilla:~/.config/vivaldi:~/.config/chromium:~/.config/google-chrome:~/.local/share/keyrings:~/.password-store:~/.gnupg:~/.ssh")
    state, resume, before = None, None, set()
    if a.conversation and all(c.isalnum() or c in "-_" for c in a.conversation):
        run = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "labyrinth-sarina")
        os.makedirs(run, mode=0o700, exist_ok=True)
        state = os.path.join(run, "conv-%s.session" % a.conversation)
        try:
            with open(state) as f:
                sid = f.read().strip()
            if sid and all(c.isalnum() for c in sid):
                resume = sid
        except OSError:
            pass
        if not resume:
            try:
                before = set(os.listdir(SESSIONS))
            except OSError:
                before = set()
    question = " ".join(a.question)
    chat = False
    if a.voice:
        said = spoken(question)
        topics = route(said, env)
        if topics is None:  # no embedding model: keywords decide, and a question that sounds like "how do I" may need her guides
            topics = keyword_topics(said)
            if topics or HOWTO_RX.search(said):
                topics.append("guides")
        chat = not about_the_computer(topics, said)
        if chat:
            question = companion(question, env) + question
        else:
            g = guides(said, env.get("SARINA_VAULT", "")) if "guides" in topics else ""
            if env.get("SARINA_SYSTEM") == "on":
                question = prefetch(said, topics) + question
            question = g + question
        if state and LAUGH_RX.search(" ".join(a.question)):
            note_laugh(last_turn(state), env)
    cmd = command(question, a.cwd, a.write, a.shell, a.voice, resume, env.get("LABYRINTH_VOICE_RULES", ""))
    if a.voice:
        # a spoken answer is cleaned here: a small model sometimes writes a tool call as text, which must not be read out or shown
        p = subprocess.run(cmd, env=env, stdout=subprocess.PIPE, text=True, errors="replace")
        rc = p.returncode
        out = p.stdout
        if chat and rc == 0 and JOKE_ASK_RX.search(spoken(" ".join(a.question))):
            # a joke she has told before: asked once more, in the same conversation when there is one (so its history holds the new joke)
            old = a_repeat(re.sub(r"<(\w+)>.*?</\1>", "", out, flags=re.S), told_jokes(env.get("SARINA_VAULT", "")))
            if old:
                again = "You told that one before (%s). Tell a different joke, a new one, about the same thing. Only the joke." % old[:160]
                sid = resume or new_session(before, state)
                c2 = command(again, a.cwd, voice=True, resume=sid, rules=env.get("LABYRINTH_VOICE_RULES", "")) if sid else command(again + " The request was: " + spoken(" ".join(a.question)), a.cwd, voice=True, rules=env.get("LABYRINTH_VOICE_RULES", ""))
                p2 = subprocess.run(c2, env=env, stdout=subprocess.PIPE, text=True, errors="replace")
                if p2.returncode == 0 and p2.stdout.strip():
                    out = p2.stdout
        answer = re.sub(r"<(\w+)>.*?</\1>", "", out, flags=re.S)
        # a small model sometimes repeats the notes it was given before the question; they are never said aloud
        answer = re.sub(r"\((?:They laughed|Style hint)[^)]*\)\s*", "", answer)
        # a delivery tag written in round brackets would be read out as a word; it is meant as the tag
        answer = re.sub(r"\((joking|unsure|urgent|gentle|serious)\)", r"[\1]", answer, flags=re.I)
        answer = shorten(flatten(answer))
        if chat:
            answer = drop_offers(answer)
        # emoji are read out as their names ("printer, grinning face") and the card has no room for them
        answer = re.sub("[\U0001F000-\U0001FAFF\u2600-\u27BF\uFE0F\u200D]", "", answer)
        answer = re.sub(r"[ \t]+\n", "\n", answer)
        answer = re.sub(r"\n{3,}", "\n\n", answer).strip()
        print(answer)
        log_joke(" ".join(a.question), answer, env)
        if chat and "[joking]" not in answer:
            log_talk(" ".join(a.question), answer, env)
        if state:
            save_turn(state, spoken(" ".join(a.question)), answer)
    else:
        rc = subprocess.run(cmd, env=env).returncode
    if state and not resume:
        sid = new_session(before, state)
        if sid:  # the session this first turn made: the later turns resume it
            try:
                with open(state, "w") as f:
                    f.write(sid)
            except OSError:
                pass
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv))
