#!/usr/bin/env bash
# (Re)start the wallpaper and the bar of the tiling desktop (Hyprland). Called from hyprland.lua
# at session start; run it by hand after editing the waybar config. The tiling desktop has no
# dock, as in Omarchy: SUPER + SPACE opens the launcher.
set -u

CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}

WALLPAPER=${LABYRINTH_WALLPAPER:-/usr/share/labyrinth/wallpapers/labyrinth-purple.png}

apply() {
  pkill -x swaybg 2>/dev/null
  if command -v swaybg >/dev/null && [ -f "$WALLPAPER" ]; then
    setsid -f swaybg -i "$WALLPAPER" -m fill >/dev/null 2>&1
  fi
  pkill -x waybar 2>/dev/null
  setsid -f waybar -c "$CONFIG/waybar/config.jsonc" -s "$CONFIG/waybar/style.css" >/dev/null 2>&1
}

case "${1:-apply}" in
  apply) apply ;;
  *) echo "Usage: labyrinth-shell [apply]" >&2; exit 2 ;;
esac
