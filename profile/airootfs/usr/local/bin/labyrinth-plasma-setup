#!/usr/bin/env bash
# First Plasma login of each user: apply the Yggdrasil look (ygg-theme) and the Labyrinth top
# bar and dock (usr/share/labyrinth/plasma/layout.js). Runs once; delete
# ~/.config/labyrinth/plasma-setup-done to run it again. Autostarted in Plasma only.
set -u
STAMP=${XDG_CONFIG_HOME:-$HOME/.config}/labyrinth/plasma-setup-done
[[ -e $STAMP ]] && exit 0
LAYOUT=/usr/share/labyrinth/plasma/layout.js

# Wait for the shell to be on the bus (it starts just before autostart entries).
for _ in $(seq 1 60); do
  busctl --user status org.kde.plasmashell >/dev/null 2>&1 && break
  sleep 1
done
busctl --user status org.kde.plasmashell >/dev/null 2>&1 || exit 0   # not Plasma: try next login

# Yggdrasil's look: its colour scheme (with Qt's own Fusion style), GTK colours and mouse cursors, in the accent colour (yggdrasil-theme).
command -v ygg-theme >/dev/null && ygg-theme apply --dark >/dev/null 2>&1 || true
# Icons: Liki, Yggdrasil's own pack (liki-icon-theme), standing on hicolor only. No KDE, macOS or GNOME icons.
kwriteconfig6 --file kdeglobals --group Icons --key Theme Liki
# straight to the desktop after login: no splash screen
kwriteconfig6 --file ksplashrc --group KSplash --key Engine none
kwriteconfig6 --file ksplashrc --group KSplash --key Theme None
# Liki's per-user part (the logos of the installed apps, in the accent colour) is built now; Minos gets its icon too.
command -v liki-build >/dev/null && liki-build >/dev/null 2>&1 || true
command -v liki-minos-icon >/dev/null && liki-minos-icon >/dev/null 2>&1 || true
# Title bars: Klassy (packages/pkgbuilds/klassy) with macOS traffic lights on the right in Windows
# order (minimize, maximize, close), the same side as apps that draw their own (Vivaldi, Spotify,
# Steam, Minos). Its title bar takes the app's colour, so title bar and toolbar are one header, and
# there is no border or chin: BorderSize None, with invisible resize edges just outside the window.
# The settings file goes in first; Klassy reads it when it is loaded by the switch below.
CONF=${XDG_CONFIG_HOME:-$HOME/.config}
if [[ -r /usr/share/labyrinth/klassy/klassyrc && ! -e $CONF/klassy/klassyrc ]]; then
  install -D -m 0644 /usr/share/labyrinth/klassy/klassyrc "$CONF/klassy/klassyrc"
fi
# Labyrinth Settings replaces KDE's System Settings: hide KDE's entries from the launcher.
command -v labyrinth-hide-kde-settings >/dev/null && labyrinth-hide-kde-settings
# Ghostty is the terminal: "Open in terminal" and apps that need one start it.
kwriteconfig6 --file kdeglobals --group General --key TerminalApplication ghostty
kwriteconfig6 --file kdeglobals --group General --key TerminalService com.mitchellh.ghostty.desktop
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft ""
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight IAX
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key BorderSizeAuto false
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key BorderSize None
if [[ -e /usr/lib/qt6/plugins/org.kde.kdecoration3/org.kde.klassy.so ]]; then
  kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.klassy
  kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme Klassy
fi
# Windows open like on a Mac; tiling is a button away (Meta + T).
kwriteconfig6 --file kdeglobals --group General --key AccentColorFromWallpaper false
# Brand purple (#3A1F5D family). The UI accent is Minos's own violet (124,84,214), a lighter tint, so selections stay visible on dark windows and the desktop matches Minos.
kwriteconfig6 --file kdeglobals --group General --key AccentColor "124,84,214"
kwriteconfig6 --file kdeglobals --group General --key LastUsedCustomAccentColor "124,84,214"
# Lock screen: the same near-black purple as the login screen and the notch, with the clock on it.
kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin org.kde.color
kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.color --group General --key Color 12,12,17
qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1

# The top bar, the notch (Fylgja), the dock and the start menu are Labyrinth's own panel: on from the
# first login (Settings > Appearance, or labyrinth-panel-mode off, goes back to Plasma's panels). Only
# if it is not installed are Plasma's panels set up from the layout.
if [[ -x /usr/bin/labyrinth-panel ]]; then
  labyrinth-panel-mode on >/dev/null 2>&1
elif [[ -r $LAYOUT ]]; then
  busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$(cat "$LAYOUT")" >/dev/null 2>&1
fi

mkdir -p "$(dirname "$STAMP")" && touch "$STAMP"
