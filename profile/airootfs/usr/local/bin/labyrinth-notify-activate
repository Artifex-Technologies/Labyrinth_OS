#!/bin/sh
# Started by D-Bus when something sends a notification and nobody owns org.freedesktop.Notifications yet (see
# /usr/local/share/dbus-1/services/org.freedesktop.Notifications.service).
# Labyrinth's notification service is inside yggdrasil-panel, so this starts the panel (if it is not running) and
# stays until the panel has taken the name, which is what D-Bus waits for. It replaces mako's activation.
pgrep -f '^/usr/bin/yggdrasil-panel$' >/dev/null || setsid -f /usr/bin/yggdrasil-panel >/dev/null 2>&1
for _ in $(seq 1 100); do
  dbus-send --session --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner string:org.freedesktop.Notifications 2>/dev/null | grep -q true && exit 0
  sleep 0.2
done
exit 1
