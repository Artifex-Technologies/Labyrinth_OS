#!/bin/sh
# Hide KDE's System Settings, Info Center and their 70-odd single-setting entries from the
# launcher and search, for this user: Labyrinth Settings replaces them (the packages stay, Plasma
# needs them). KRunner is hidden the same way: the start menu's search replaces it. Each entry gets a copy in ~/.local/share/applications marked NoDisplay, which
# keeps it working when something launches it by name. Run at first login by
# labyrinth-plasma-setup; run it again after an update that adds settings modules.
set -u
dest=${XDG_DATA_HOME:-$HOME/.local/share}/applications
mkdir -p "$dest"
for f in /usr/share/applications/systemsettings.desktop /usr/share/applications/kdesystemsettings.desktop \
         /usr/share/applications/org.kde.kinfocenter.desktop /usr/share/applications/kcm_*.desktop \n         /usr/share/applications/org.kde.krunner.desktop; do
  [ -f "$f" ] || continue
  out=$dest/$(basename "$f")
  grep -v '^NoDisplay=' "$f" | sed '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' >"$out"
done
