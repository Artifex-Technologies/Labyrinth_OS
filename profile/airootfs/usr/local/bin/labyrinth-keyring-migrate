#!/usr/bin/env python3
"""labyrinth-keyring-migrate: move your saved secrets from KDE's secret service (ksecretd / KDE Wallet) to gnome-keyring, once.

  labyrinth-keyring-migrate --check     list what would move (labels and attributes only, never the secrets) and what is installed
  labyrinth-keyring-migrate             do it (asks for your login password; run it in a terminal, as yourself, not with sudo)

Why: Labyrinth uses gnome-keyring as the system's secret store (unlocked by your login password through PAM, so apps never ask).
Browsers (their "Safe Storage" key: without it they cannot read their saved cookies and logins), the GitHub CLI token, and a few
other apps keep their secrets there. They are in KDE's store today, so they must be copied before gnome-keyring takes over.

What it does, in this order, and how it undoes itself:
  1. reads every item of KDE's store into memory (nothing is written to a file, nothing is printed),
  2. switches KDE's secret service off (kwalletrc: [org.freedesktop.secrets] apiEnabled=false) and stops it,
  3. creates or unlocks gnome-keyring's "login" keyring with the password you type (the same password PAM will use at login) and starts it,
  4. writes the items into it and checks that they are there.
If step 3 or 4 fails, it switches KDE's service back on and starts it again, so nothing is lost; the old store is never deleted.

Use `passwd` in a terminal to change your login password later, not a graphical tool: the PAM hook then changes the keyring's password
with it. If the two ever differ, the keyring stays locked at login and the first app that needs a secret asks for the OLD password.
"""
import getpass
import os
import subprocess
import sys
import time

try:
    import dbus
except ImportError:
    sys.exit("python-dbus is needed: sudo pacman -S python-dbus")

BUS, ROOT = "org.freedesktop.secrets", "/org/freedesktop/secrets"


def owner_comm():
    r = subprocess.run(["busctl", "--user", "status", BUS], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        if line.startswith("Comm="):
            return line.split("=", 1)[1]
    return "?"


def read_old(include_secrets):
    bus = dbus.SessionBus()
    svc = dbus.Interface(bus.get_object(BUS, ROOT), "org.freedesktop.Secret.Service")
    session = None
    if include_secrets:
        _, session = svc.OpenSession("plain", dbus.String("", variant_level=1))
    props = dbus.Interface(bus.get_object(BUS, ROOT), "org.freedesktop.DBus.Properties")
    items = []
    for c in props.Get("org.freedesktop.Secret.Service", "Collections"):
        if not str(c).endswith("/kdewallet"):
            continue
        cp = dbus.Interface(bus.get_object(BUS, c), "org.freedesktop.DBus.Properties")
        for it in cp.Get("org.freedesktop.Secret.Collection", "Items"):
            ip = dbus.Interface(bus.get_object(BUS, it), "org.freedesktop.DBus.Properties")
            label = str(ip.Get("org.freedesktop.Secret.Item", "Label"))
            attrs = {str(k): str(v) for k, v in ip.Get("org.freedesktop.Secret.Item", "Attributes").items()}
            value, ctype = None, ""
            if include_secrets:
                sec = dbus.Interface(bus.get_object(BUS, it), "org.freedesktop.Secret.Item").GetSecret(session)
                value, ctype = bytes(sec[2]), str(sec[3])
            items.append((label, attrs, value, ctype))
    return items


def set_kde_api(enabled):
    subprocess.run(["kwriteconfig6", "--file", "kwalletrc", "--group", "org.freedesktop.secrets", "--key", "apiEnabled", "true" if enabled else "false"], check=True)


def wait_name(present, seconds=10):
    for _ in range(int(seconds * 4)):
        if (owner_comm() is not None) == present:
            return True
        time.sleep(0.25)
    return False


def rollback(why):
    print("PROBLEM:", why)
    print("Putting KDE's secret service back...")
    subprocess.run(["pkill", "-x", "gnome-keyring-d"])  # the comm name is cut to 15 characters
    time.sleep(1)
    set_kde_api(True)
    subprocess.Popen(["ksecretd"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    wait_name(True)
    print("Back to how it was (served by %s). Nothing was lost." % owner_comm())
    sys.exit(1)


def main():
    check = "--check" in sys.argv[1:]
    if os.geteuid() == 0:
        sys.exit("run it as yourself, not with sudo")
    if subprocess.run(["which", "gnome-keyring-daemon"], capture_output=True).returncode != 0:
        sys.exit("gnome-keyring is not installed: sudo pacman -S gnome-keyring")
    served = owner_comm()
    print("The secret service is served by:", served)
    if served != "ksecretd" and not check:
        sys.exit("expected KDE's ksecretd to be serving the secrets; it is %s. Nothing changed." % served)
    items = read_old(include_secrets=not check)
    print("%d item(s) in KDE's store:" % len(items))
    for label, attrs, _, _ in items:
        print("  -", label, "(attributes: %s)" % ", ".join(sorted(attrs)))
    if check:
        return
    if not items:
        sys.exit("nothing to move")
    pw = getpass.getpass("Your login password (to create/unlock gnome-keyring's login keyring): ")
    if not pw:
        sys.exit("no password given; nothing changed")

    set_kde_api(False)
    subprocess.run(["pkill", "-x", "ksecretd"])
    if not wait_name(False):
        set_kde_api(True)
        sys.exit("KDE's secret service did not stop; nothing changed")

    p = subprocess.run(["gnome-keyring-daemon", "--login"], input=pw.encode(), capture_output=True)
    pw = ""
    if p.returncode != 0:
        rollback("gnome-keyring could not unlock or create the login keyring")
    subprocess.run(["gnome-keyring-daemon", "--start", "--components=secrets"], capture_output=True)
    if not wait_name(True) or owner_comm() != "gnome-keyring-d":
        rollback("gnome-keyring is not serving the secret service (it is %s)" % owner_comm())

    bus = dbus.SessionBus()
    svc = dbus.Interface(bus.get_object(BUS, ROOT), "org.freedesktop.Secret.Service")
    _, session = svc.OpenSession("plain", dbus.String("", variant_level=1))
    default = str(svc.ReadAlias("default"))
    if default == "/":
        rollback("gnome-keyring has no default keyring")
    cprops = dbus.Interface(bus.get_object(BUS, default), "org.freedesktop.DBus.Properties")
    if cprops.Get("org.freedesktop.Secret.Collection", "Locked"):
        rollback("the default keyring is locked")
    coll = dbus.Interface(bus.get_object(BUS, default), "org.freedesktop.Secret.Collection")
    try:
        for label, attrs, value, ctype in items:
            secret = dbus.Struct((session, dbus.Array([], signature="y"), dbus.Array([dbus.Byte(b) for b in value], signature="y"), ctype), signature="oayays")
            coll.CreateItem({"org.freedesktop.Secret.Item.Label": dbus.String(label, variant_level=1),
                             "org.freedesktop.Secret.Item.Attributes": dbus.Dictionary(attrs, signature="ss", variant_level=1)}, secret, True)
    except dbus.DBusException as e:
        rollback("writing an item failed: %s" % e)
    count = len(cprops.Get("org.freedesktop.Secret.Collection", "Items"))
    items.clear()
    if count < 1:
        rollback("the new keyring is empty after the copy")
    print("Done: %d item(s) are now in gnome-keyring's login keyring; KDE's store was left as it was (not deleted)." % count)
    print("Now log out and in once. Then check: Vivaldi still has its logins, and `gh auth status` still says you are logged in.")


if __name__ == "__main__":
    main()
