# systemd USER unit, started by labyrinth-sarina-checkup.timer (both off until the owner switches them on).
[Unit]
Description=Sarina's daily check-up (read-only)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/labyrinth-sarina-checkup
# exit 75: the graphics card was busy (a game); try again in an hour
SuccessExitStatus=0
RestartForceExitStatus=75
Restart=on-failure
RestartSec=3600
Nice=10
