# Maintainer: Labyrinth OS
#
# Limbo, sandboxed Windows and Linux guest apps, built from Limbo's public repository: for Agora (labyrinth-apps install
# limbo) when Labyrinth's package repository cannot be reached. Normally Agora installs the signed build from that
# repository instead. The ISO's own build uses packages/pkgbuilds/limbo-git, which builds the checkout next to Labyrinth_OS.
# Limbo's runtime (libvirt, QEMU, ...) is not a dependency: the "virtualization" component, or `sudo limbo setup`, installs it.
# To build a local checkout instead: LIMBO_SRC=file://$HOME/Documents/Github/Limbo makepkg -si

pkgname=limbo-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Limbo: run Windows and Linux guest apps as sandboxed host windows, with quarantine and validation runs'
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Limbo'
license=('MPL-2.0')
depends=('glibc')
makedepends=('go' 'git')
optdepends=(
  'libvirt: manages guests'
  'qemu-base: the hypervisor'
  'dnsmasq: DHCP/DNS on each guest network'
  'nftables: each guest firewall'
  'openssh: validation runs'
  'libisoburn: builds the cloud-init seed disk'
  'waypipe: seamless windows for Linux guests'
  'freerdp: seamless windows for Windows guests (RemoteApp)'
)
provides=('limbo')
conflicts=('limbo')
options=('!debug')
install=limbo.install
source=("limbo::git+${LIMBO_SRC:-https://github.com/Artifex-Technologies/Limbo.git}")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/limbo"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/limbo"
  export CGO_ENABLED=0
  go build -trimpath -ldflags "-s -w" -o limbo ./cmd/limbo
}

check() {
  cd "$srcdir/limbo"
  go test ./...   # unit tests only: the integration scripts need a hypervisor and root
}

package() {
  cd "$srcdir/limbo"
  install -Dm755 limbo "$pkgdir/usr/bin/limbo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/QUARANTINE.md "$pkgdir/usr/share/doc/$pkgname/QUARANTINE.md"
  install -Dm644 docs/EVENTS.md "$pkgdir/usr/share/doc/$pkgname/EVENTS.md"
  install -Dm644 docs/HOST-FIREWALL.md "$pkgdir/usr/share/doc/$pkgname/HOST-FIREWALL.md"
  install -Dm644 packaging/arch/limbo.service "$pkgdir/usr/lib/systemd/system/limbo.service"
  install -Dm644 packaging/arch/limbo.sysusers "$pkgdir/usr/lib/sysusers.d/limbo.conf"
  install -Dm644 examples/validation-profile.json "$pkgdir/usr/share/doc/$pkgname/examples/validation-profile.json"
  install -Dm644 examples/analysis-linux.json "$pkgdir/usr/share/doc/$pkgname/examples/analysis-linux.json"
  # validation profiles define what a run may do, so the directory is root-only writable
  install -dm755 "$pkgdir/etc/limbo/validation"
  install -dm700 "$pkgdir/etc/limbo/keys"
}
