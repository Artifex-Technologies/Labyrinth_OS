# Maintainer: Labyrinth OS
#
# Timer, a Yggdrasil plugin: a countdown in the top bar and a card there to start, pause and stop it; alarms are systemd user
# timers, so nothing runs while it counts. Adapted from NickmDrummer/omarchy-timer (MIT), built from Yggdrasil's public
# repository (packages/timer). Agora's Plugins installs it (labyrinth-apps install timer).
# To build a local checkout instead: YGGDRASIL_SRC=file://$HOME/Documents/Github/Yggdrasil makepkg -si
pkgname=yggdrasil-timer-git
pkgver=1.0.0
pkgrel=1
# 1 since 2026-11-07: the version names the app folder's last commit (it named Yggdrasil's newest commit, so two builds with
# the same count were ordered at random), and the rebuild for any 64-bit CPU must reach installed systems as an update
epoch=1
pkgdesc="Yggdrasil plugin: a timer in the top bar"
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Yggdrasil'
license=('MPL-2.0')
depends=('gcc-libs' 'systemd' 'libnotify' 'yggdrasil-panel')
optdepends=('libcanberra: the alarm sound' 'pipewire: the alarm sound (pw-play)')
makedepends=('cargo' 'git')
provides=('yggdrasil-timer')
conflicts=('yggdrasil-timer')
options=('!lto')
source=("yggdrasil::git+${YGGDRASIL_SRC:-https://github.com/Artifex-Technologies/Yggdrasil.git}")
sha256sums=('SKIP')

# The version is the system's (VERSION in Yggdrasil, the same as Labyrinth OS's); the build number counts the commits since
# that release which touch packages/timer, the crates it uses and this recipe (Labyrinth_OS docs/VERSIONING.md). Both come from
# makepkg's clone: worked out here for the packaging step (makepkg reads this file again for it), and in pkgver() and
# prepare() for the rest of the build, once the clone is up to date.
# --- package version (scripts/package-version.sh) ---
# _version CHECKOUT [PATH...]: sets pkgver and pkgrel. pkgver is the VERSION file at the top of CHECKOUT's git repository (as
# committed); pkgrel, the build number, is 1 + the commits since that file last changed (the release) that touch the PATHs
# in that repository (relative ones are from its top), with the Rust crates they use from it (their path dependencies), or
# the whole repository when no PATH is in it. The recipe's own folder counts too; so does every PATH in another repository
# (by date: its commits since the release). Without a VERSION file (no clone yet: makepkg reads a recipe before it fetches)
# pkgver and pkgrel stay as they are.
_version() {
  local top base since rel=1 a q t todo=() paths=() others=("${startdir:-}")
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) && base=$(git -C "$top" log -1 --format=%H -- VERSION 2>/dev/null) \
    && [[ -n $base ]] || return 0
  for a in "${@:2}"; do
    [[ $a == /* ]] || a=$top/$a
    a=$(realpath -m "$a")
    if [[ $a == "$top" || $a == "$top"/* ]]; then todo+=("$a"); else others+=("$a"); fi
  done
  while ((${#todo[@]})); do
    a=${todo[0]}; todo=("${todo[@]:1}")
    [[ " ${paths[*]} " == *" $a "* ]] && continue
    paths+=("$a")
    for q in $(sed -n 's/^[^#]*path *= *"\(\.\.[^"]*\)".*/\1/p' "$a/Cargo.toml" 2>/dev/null); do todo+=("$(realpath -m "$a/$q")"); done
  done
  since=$(git -C "$top" log -1 --format=%ct "$base")
  for a in "${others[@]}"; do
    [[ -n $a ]] && t=$(git -C "$a" rev-parse --show-toplevel 2>/dev/null) || continue
    if [[ $t == "$top" ]]; then ((${#paths[@]})) && paths+=("$(realpath "$a")")
    # another checkout of the same repository (an app's own recipe, built from a clone of it): counted above already
    elif [[ $(git -C "$t" rev-list --max-parents=0 HEAD) == "$(git -C "$top" rev-list --max-parents=0 HEAD)" ]]; then continue
    else rel=$((rel + $(git -C "$a" rev-list --count --since="@$since" HEAD -- .))); fi
  done
  pkgver=$(git -C "$top" show HEAD:VERSION)
  pkgrel=$((rel + $(git -C "$top" rev-list --count "$base..HEAD" -- "${paths[@]}")))
}
# _srcdir: makepkg's $srcdir, also while makepkg reads the recipe before setting it (for the clones of -git recipes)
_srcdir() {
  if [[ -n ${srcdir:-} ]]; then echo "$srcdir"
  elif [[ ${BUILDDIR:-} -ef ${startdir:-} ]]; then echo "$BUILDDIR/src"
  else echo "${BUILDDIR:-}/$pkgname/src"; fi
}
# --- end of package version ---
_version "$(_srcdir)/yggdrasil" packages/timer

pkgver() {
  _version "$srcdir/yggdrasil" packages/timer
  echo "$pkgver"
}

prepare() {
  _version "$srcdir/yggdrasil" packages/timer
}

build() {
  cd "$srcdir/yggdrasil/packages/timer"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$srcdir/yggdrasil/packages/timer"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  cd "$srcdir/yggdrasil/packages/timer"
  install -Dm755 "$srcdir/target/release/yggdrasil-timer" "$pkgdir/usr/bin/yggdrasil-timer"
  install -Dm644 timer.conf "$pkgdir/usr/share/yggdrasil/integrations/timer.conf"
  # its logo, in the bar and on its notifications
  install -Dm644 timer-symbolic.svg "$pkgdir/usr/share/yggdrasil/icons/timer-symbolic.svg"
  # at login: timers that ended while the computer was off are marked done, running ones get their alarm back
  install -Dm644 yggdrasil-timer-reconcile.desktop "$pkgdir/etc/xdg/autostart/yggdrasil-timer-reconcile.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/yggdrasil-timer/README.md"
}
