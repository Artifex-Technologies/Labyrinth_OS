# Maintainer: Labyrinth OS
#
# Authenticator, a Yggdrasil plugin: Proton Authenticator's 2FA codes in a small window (search, Enter copies). Two sources:
# the window from Yggdrasil's repository (packages/authenticator), and devSviat's pa-helper, which does all vault work, from
# github.com/devSviat/omarchy-proton-authenticator pinned to the reviewed commit below (MIT). Agora's Plugins installs it
# (labyrinth-apps install proton-authenticator). Local checkout: YGGDRASIL_SRC=file://$HOME/Documents/Github/Yggdrasil makepkg -si
pkgname=yggdrasil-authenticator-git
pkgver=1.0.0
pkgrel=1
# 1 since 2026-11-07: the version names the app folder's last commit (it named Yggdrasil's newest commit, so two builds with
# the same count were ordered at random), and the rebuild for any 64-bit CPU must reach installed systems as an update
epoch=1
pkgdesc="Proton Authenticator's 2FA codes in a Yggdrasil window: search, Enter copies"
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Yggdrasil'
license=('MPL-2.0' 'MIT')
depends=('gcc-libs' 'libsecret' 'glib2' 'wl-clipboard' 'yggdrasil-panel')
optdepends=('proton-authenticator-bin: the official app, whose vault this reads (AUR; sign in and sync once)')
makedepends=('cargo' 'git')
provides=('yggdrasil-authenticator')
conflicts=('yggdrasil-authenticator')
options=('!lto')
_helper_commit=3cdba859986eddc2b8f434240825eed3e076c42e
source=("yggdrasil::git+${YGGDRASIL_SRC:-https://github.com/Artifex-Technologies/Yggdrasil.git}"
        "pa::git+https://github.com/devSviat/omarchy-proton-authenticator.git#commit=${_helper_commit}")
sha256sums=('SKIP' 'SKIP')

# The version is the system's (VERSION in Yggdrasil, the same as Labyrinth OS's); the build number counts the commits since
# that release which touch packages/authenticator, the crates it uses and this recipe (Labyrinth_OS docs/VERSIONING.md). Both come from
# makepkg's clone: worked out here for the packaging step (makepkg reads this file again for it), and in pkgver() and
# prepare() for the rest of the build, once the clone is up to date.
# --- package version (scripts/package-version.sh) ---
# _version CHECKOUT [PATH...]: sets pkgver and pkgrel. pkgver is the VERSION file at the top of CHECKOUT's git repository (as
# committed); pkgrel, the build number, is 1 + the commits since that file last changed (the release) that touch the PATHs
# in that repository (relative ones are from its top), with the Rust crates they use from it (their path dependencies), or
# the whole repository when no PATH is in it. The recipe's own folder counts too; so does every PATH in another repository
# (by date: its commits since the release). Without a VERSION file (no clone yet: makepkg reads a recipe before it fetches)
# pkgver and pkgrel stay as they are.
_version() {
  local top base since rel=1 a q t todo=() paths=() others=("${startdir:-}")
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) && base=$(git -C "$top" log -1 --format=%H -- VERSION 2>/dev/null) \
    && [[ -n $base ]] || return 0
  for a in "${@:2}"; do
    [[ $a == /* ]] || a=$top/$a
    a=$(realpath -m "$a")
    if [[ $a == "$top" || $a == "$top"/* ]]; then todo+=("$a"); else others+=("$a"); fi
  done
  while ((${#todo[@]})); do
    a=${todo[0]}; todo=("${todo[@]:1}")
    [[ " ${paths[*]} " == *" $a "* ]] && continue
    paths+=("$a")
    for q in $(sed -n 's/^[^#]*path *= *"\(\.\.[^"]*\)".*/\1/p' "$a/Cargo.toml" 2>/dev/null); do todo+=("$(realpath -m "$a/$q")"); done
  done
  since=$(git -C "$top" log -1 --format=%ct "$base")
  for a in "${others[@]}"; do
    [[ -n $a ]] && t=$(git -C "$a" rev-parse --show-toplevel 2>/dev/null) || continue
    if [[ $t == "$top" ]]; then ((${#paths[@]})) && paths+=("$(realpath "$a")")
    # another checkout of the same repository (an app's own recipe, built from a clone of it): counted above already
    elif [[ $(git -C "$t" rev-list --max-parents=0 HEAD) == "$(git -C "$top" rev-list --max-parents=0 HEAD)" ]]; then continue
    else rel=$((rel + $(git -C "$a" rev-list --count --since="@$since" HEAD -- .))); fi
  done
  pkgver=$(git -C "$top" show HEAD:VERSION)
  pkgrel=$((rel + $(git -C "$top" rev-list --count "$base..HEAD" -- "${paths[@]}")))
}
# _srcdir: makepkg's $srcdir, also while makepkg reads the recipe before setting it (for the clones of -git recipes)
_srcdir() {
  if [[ -n ${srcdir:-} ]]; then echo "$srcdir"
  elif [[ ${BUILDDIR:-} -ef ${startdir:-} ]]; then echo "$BUILDDIR/src"
  else echo "${BUILDDIR:-}/$pkgname/src"; fi
}
# --- end of package version ---
_version "$(_srcdir)/yggdrasil" packages/authenticator

pkgver() {
  _version "$srcdir/yggdrasil" packages/authenticator
  echo "$pkgver"
}

prepare() {
  _version "$srcdir/yggdrasil" packages/authenticator
}

build() {
  cd "$srcdir/pa/helper"
  cargo build --release --locked --target-dir "$srcdir/target-helper"
  cd "$srcdir/yggdrasil/packages/authenticator"
  cargo build --release --locked --target-dir "$srcdir/target"
}

check() {
  cd "$srcdir/yggdrasil/packages/authenticator"
  cargo test --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/yggdrasil-authenticator" "$pkgdir/usr/bin/yggdrasil-authenticator"
  install -Dm755 "$srcdir/target-helper/release/pa-helper" "$pkgdir/usr/lib/yggdrasil-authenticator/pa-helper"
  install -Dm644 "$srcdir/pa/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.pa-helper"
  install -Dm644 "$srcdir/yggdrasil/packages/authenticator/README.md" "$pkgdir/usr/share/doc/yggdrasil-authenticator/README.md"
  # the key in the top bar that opens the window
  install -Dm644 "$srcdir/yggdrasil/packages/authenticator/authenticator.conf" "$pkgdir/usr/share/yggdrasil/integrations/authenticator.conf"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/yggdrasil-authenticator.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Authenticator
GenericName=2FA codes
Comment=Your Proton Authenticator codes: search, Enter copies
Exec=yggdrasil-authenticator
Icon=proton-authenticator
Terminal=false
Categories=Utility;Security;
Keywords=2fa;totp;otp;proton;authenticator;
DESKTOP
}
