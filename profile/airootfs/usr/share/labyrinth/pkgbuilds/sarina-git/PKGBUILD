# Maintainer: Labyrinth OS
#
# Sarina, the local-model agent (Go core, optional Python helper), built from Sarina's public repository: for Agora
# (labyrinth-apps install sarina) and for an install that chose Sarina when she was not on the medium (installed at first
# login). The ISO's own build uses packages/pkgbuilds/sarina-git, which builds the checkout next to Labyrinth_OS.
# To build a local checkout instead: SARINA_SRC=file://$HOME/Documents/Github/Sarina makepkg -si

pkgname=sarina-git
pkgver=1.0.0
pkgrel=1
pkgdesc='Local-model agent: Go core with an optional Python ML/voice helper'
arch=('x86_64')
url='https://github.com/Artifex-Technologies/Sarina'
license=('MPL-2.0')
depends=('glibc')
optdepends=(
  'ollama: a local model server for Sarina to talk to (ollama-cuda on an NVIDIA machine)'
  'python: the optional ML/voice helper (sarina-helpers)'
  'python-onnxruntime: semantic search and desktop-audit classification (helper)'
)
makedepends=('go' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'git')
provides=('sarina')
conflicts=('sarina')
source=("sarina::git+${SARINA_SRC:-https://github.com/Artifex-Technologies/Sarina.git}")
sha256sums=('SKIP')

# The version is Sarina's own (the VERSION file in its repository); the build number counts its commits since that release
# and this recipe's (Labyrinth_OS docs/VERSIONING.md). Both come from makepkg's clone: worked out here for the packaging step
# (makepkg reads this file again for it), and in pkgver() and prepare() for the rest of the build, once the clone is up to date.
# --- package version (scripts/package-version.sh) ---
# _version CHECKOUT [PATH...]: sets pkgver and pkgrel. pkgver is the VERSION file at the top of CHECKOUT's git repository (as
# committed); pkgrel, the build number, is 1 + the commits since that file last changed (the release) that touch the PATHs
# in that repository (relative ones are from its top), with the Rust crates they use from it (their path dependencies), or
# the whole repository when no PATH is in it. The recipe's own folder counts too; so does every PATH in another repository
# (by date: its commits since the release). Without a VERSION file (no clone yet: makepkg reads a recipe before it fetches)
# pkgver and pkgrel stay as they are.
_version() {
  local top base since rel=1 a q t todo=() paths=() others=("${startdir:-}")
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) && base=$(git -C "$top" log -1 --format=%H -- VERSION 2>/dev/null) \
    && [[ -n $base ]] || return 0
  for a in "${@:2}"; do
    [[ $a == /* ]] || a=$top/$a
    a=$(realpath -m "$a")
    if [[ $a == "$top" || $a == "$top"/* ]]; then todo+=("$a"); else others+=("$a"); fi
  done
  while ((${#todo[@]})); do
    a=${todo[0]}; todo=("${todo[@]:1}")
    [[ " ${paths[*]} " == *" $a "* ]] && continue
    paths+=("$a")
    for q in $(sed -n 's/^[^#]*path *= *"\(\.\.[^"]*\)".*/\1/p' "$a/Cargo.toml" 2>/dev/null); do todo+=("$(realpath -m "$a/$q")"); done
  done
  since=$(git -C "$top" log -1 --format=%ct "$base")
  for a in "${others[@]}"; do
    [[ -n $a ]] && t=$(git -C "$a" rev-parse --show-toplevel 2>/dev/null) || continue
    if [[ $t == "$top" ]]; then ((${#paths[@]})) && paths+=("$(realpath "$a")")
    # another checkout of the same repository (an app's own recipe, built from a clone of it): counted above already
    elif [[ $(git -C "$t" rev-list --max-parents=0 HEAD) == "$(git -C "$top" rev-list --max-parents=0 HEAD)" ]]; then continue
    else rel=$((rel + $(git -C "$a" rev-list --count --since="@$since" HEAD -- .))); fi
  done
  pkgver=$(git -C "$top" show HEAD:VERSION)
  pkgrel=$((rel + $(git -C "$top" rev-list --count "$base..HEAD" -- "${paths[@]}")))
}
# _srcdir: makepkg's $srcdir, also while makepkg reads the recipe before setting it (for the clones of -git recipes)
_srcdir() {
  if [[ -n ${srcdir:-} ]]; then echo "$srcdir"
  elif [[ ${BUILDDIR:-} -ef ${startdir:-} ]]; then echo "$BUILDDIR/src"
  else echo "${BUILDDIR:-}/$pkgname/src"; fi
}
# --- end of package version ---
_version "$(_srcdir)/sarina"

pkgver() {
  _version "$srcdir/sarina"
  echo "$pkgver"
}

prepare() {
  _version "$srcdir/sarina"
}

build() {
  cd "$srcdir/sarina/go"
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w" -o sarina ./cmd/sarina
  go build -ldflags "-s -w" -o sarina-tone ./cmd/sarina-tone

  cd ../python/sarina_helpers
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/sarina"

  install -Dm755 go/sarina "$pkgdir/usr/bin/sarina"
  # how Sarina plugs into the desktop (Yggdrasil): hold-to-talk, voice, and her page in Settings
  install -Dm644 "$startdir/sarina.integration.conf" "$pkgdir/usr/share/yggdrasil/integrations/sarina.conf"
  install -Dm755 go/sarina-tone "$pkgdir/usr/bin/sarina-tone"
  ln -s sarina "$pkgdir/usr/bin/sarina-gui"
  ln -s sarina "$pkgdir/usr/bin/sarina-service"

  python -m installer --destdir="$pkgdir" python/sarina_helpers/dist/*.whl

  install -Dm644 packaging/arch/sarina-service.service "$pkgdir/usr/lib/systemd/system/sarina-service.service"
  install -Dm644 packaging/arch/sarina.sysusers "$pkgdir/usr/lib/sysusers.d/sarina.conf"
  install -Dm644 packaging/arch/service.env.example "$pkgdir/etc/sarina/service.env.example"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  for d in packaging/skills/*/; do
    install -Dm644 "$d/SKILL.md" "$pkgdir/usr/share/sarina/skills/$(basename "$d")/SKILL.md"
    # a long skill's sections, read on demand (skill_section, skill_search)
    for f in "$d"sections/*.md; do
      if [ -f "$f" ]; then install -Dm644 "$f" "$pkgdir/usr/share/sarina/skills/$(basename "$d")/sections/$(basename "$f")"; fi
    done
  done
}
