[Desktop Entry]
Type=Application
Version=1.0
Name=Install Labyrinth
GenericName=System Installer
Comment=Install Labyrinth OS on this computer
Exec=labyrinth-install
Icon=labyrinthos
Terminal=false
StartupNotify=true
StartupWMClass=yggdrasil-installer
Categories=System;
Actions=calamares;
X-AppStream-Ignore=true

[Desktop Action calamares]
Name=Install with the old installer (Calamares)
Exec=labyrinth-install --calamares
